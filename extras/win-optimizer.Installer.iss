; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "win-optimizer"
#define MyAppVersion ""
#define MyAppPublisher "sh1zen"
#define MyAppURL "https://github.com/sh1zen/win-optimizer"
#define MyAppExeName "win-optimizer.exe"
#define MyAppDataRoot "{commonappdata}\win-optimizer"
#define MyAppAssocName MyAppName + " File"
#define MyAppAssocExt ".win-optimizer"
#define MyAppAssocKey StringChange(MyAppAssocName, " ", "") + MyAppAssocExt

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{51DB5BCA-8548-51D2-AD65-B6527C62A739}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName=win-optimizer
; Match the application's numeric versions and padded date text.
VersionInfoVersion={#MyAppVersion}
VersionInfoTextVersion={#MyAppVersion}
VersionInfoProductTextVersion={#MyAppVersion}
SetupMutex=WinOptimizerSetupMutex,Global
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run
; on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the
; install be done in "64-bit mode" on x64 or Windows 11 on Arm,
; meaning it should use the native 64-bit Program Files directory and
; the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
ChangesAssociations=yes
DisableProgramGroupPage=yes
LicenseFile=C:\win-optimizer\LICENSE.txt
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
OutputDir=C:\win-optimizer\build\installers
OutputBaseFilename=win-optimizer.Installer
SetupIconFile=C:\win-optimizer\src\WinOptimizer.UI\Assets\AppIcons\win-optimizer.ico
VersionInfoCopyright=Copyright © Andrea Frolli
SolidCompression=yes
WizardStyle=modern
; Choose the installation type before showing the destination folder picker.
DisableDirPage=yes
; Only create uninstaller for regular installations
Uninstallable=WizardIsTaskSelected('regularinstall')
; Close applications before installation/uninstallation
CloseApplications=yes
CloseApplicationsFilter=*{#MyAppExeName}
RestartIfNeededByRun=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Messages]
WizardSelectTasks=Installation type
SelectTasksDesc=Choose a regular or portable installation.
SelectTasksLabel2=Regular installs support shortcuts, file associations and uninstallation. Portable installs can be moved and do not register with Windows. Application data uses ProgramData in both modes.

[Code]
var
  RemoveAppData: Boolean;

function GetStorageFileAttributes(const FileName: String): Cardinal;
  external 'GetFileAttributesW@kernel32.dll stdcall';

// The installer boundary mirrors AppDataPaths.Root; command-line paths cannot override it.
function ApplicationDataRoot(): String;
begin
  Result := RemoveBackslash(ExpandFileName(ExpandConstant('{#MyAppDataRoot}')));
end;

// Reject redirects on the storage root and its ancestors before deleting any data.
procedure ValidateDataCleanupPath();
var
  StorageRoot, InstallRoot, CurrentPath, ParentPath: String;
  Attributes, ErrorCode: Cardinal;
begin
  StorageRoot := ApplicationDataRoot();
  InstallRoot := RemoveBackslash(ExpandFileName(ExpandConstant('{app}')));
  if Pos(Lowercase(AddBackslash(StorageRoot)), Lowercase(AddBackslash(InstallRoot))) = 1 then
    RaiseException('The application is installed inside its data folder. Keep data during uninstall, then remove ' +
      StorageRoot + ' manually after uninstalling.');
  CurrentPath := StorageRoot;
  repeat
    Attributes := GetStorageFileAttributes(CurrentPath);
    if Attributes = $FFFFFFFF then
    begin
      ErrorCode := DLLGetLastError();
      if (ErrorCode <> 2) and (ErrorCode <> 3) then
        RaiseException('Cannot inspect application data at ' + CurrentPath + '. ' + SysErrorMessage(ErrorCode));
    end
    else
    begin
      if (Attributes and $400) <> 0 then
        RaiseException('Full cleanup cannot use a linked application-data folder: ' + CurrentPath);
      if (CompareText(CurrentPath, StorageRoot) = 0) and ((Attributes and $10) = 0) then
        RaiseException('The application-data path is not a directory: ' + CurrentPath);
    end;
    ParentPath := ExtractFileDir(CurrentPath);
    if CompareText(ParentPath, CurrentPath) = 0 then
      Break;
    CurrentPath := ParentPath;
  until CurrentPath = '';
end;

function InitializeUninstall(): Boolean;
var
  Choice: Integer;
  DataPolicy, ErrorMessage: String;
begin
  Result := False;
  RemoveAppData := False;
  DataPolicy := ExpandConstant('{param:DATA|ask}');
  if CompareText(DataPolicy, 'remove') = 0 then
    RemoveAppData := True
  else if (CompareText(DataPolicy, 'keep') <> 0) and (CompareText(DataPolicy, 'ask') <> 0) then
  begin
    Log('Invalid uninstall data policy. Use /DATA=keep or /DATA=remove.');
    SuppressibleMsgBox('Invalid uninstall data option. Use /DATA=keep or /DATA=remove.', mbError, MB_OK, IDOK);
    Exit;
  end;

  if (CompareText(DataPolicy, 'ask') = 0) and not UninstallSilent() then
  begin
    Choice := SuppressibleTaskDialogMsgBox('Uninstall win-optimizer',
      'Choose what to do with application data in:' + #13#10 + ApplicationDataRoot() + #13#10#13#10 +
      'Close win-optimizer before continuing. Removing data does not undo Windows changes. Restore any settings that use application scripts before a full cleanup.',
      mbConfirmation, MB_YESNOCANCEL, ['Keep data for reinstalling (recommended)' + #13#10 +
       'Keep preferences, backups, history and other saved application data.',
       'Remove all application data' + #13#10 + 'Permanently delete data shared by ALL Windows accounts and other win-optimizer copies, including backups, caches and downloaded tools. Administrator access may be required.',
       'Cancel'], IDNO, IDYES);
    if (Choice <> IDYES) and (Choice <> IDNO) then
      Exit;
    RemoveAppData := Choice = IDNO;
  end;

  if RemoveAppData then
  begin
    try
      ValidateDataCleanupPath();
    except
      ErrorMessage := GetExceptionMessage();
      Log(ErrorMessage);
      SuppressibleMsgBox(ErrorMessage, mbError, MB_OK, IDOK);
      Exit;
    end;
  end;

  // This mutex belongs to Setup, so concurrent installation must finish first.
  if CheckForMutexes('WinOptimizerSetupMutex') then
  begin
    SuppressibleMsgBox('Another win-optimizer installation is running. Close it before uninstalling.', mbError, MB_OK, IDOK);
    Exit;
  end;
  Result := True;
end;

// Run after uninstall confirmation, before removing the tracked application payload.
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  DataRoot, ErrorMessage: String;
begin
  if CurUninstallStep <> usUninstall then
    Exit;
  DataRoot := ApplicationDataRoot();
  if not RemoveAppData then
  begin
    Log('Application data kept for reinstalling: ' + DataRoot);
    Exit;
  end;
  try
    ValidateDataCleanupPath();
    // DelTree removes child reparse points themselves, without visiting their targets.
    if DirExists(DataRoot) and not DelTree(DataRoot, True, True, True) then
      RaiseException('Some application data could not be removed from ' + DataRoot +
        '. Close win-optimizer and retry as administrator, or choose to keep data.');
    Log('Application data removed: ' + DataRoot);
  except
    ErrorMessage := GetExceptionMessage();
    Log(ErrorMessage);
    SuppressibleMsgBox(ErrorMessage, mbError, MB_OK, IDOK);
    Abort;
  end;
end;

var
  CustomDirPage: TInputDirWizardPage;
  HasSelectedInstallType: Boolean;
  PreviousPortableInstall: Boolean;
  RegularInstallDir: String;
  PortableInstallDir: String;

procedure InitializeWizard;
begin
  HasSelectedInstallType := False;
  RegularInstallDir := WizardForm.DirEdit.Text;
  PortableInstallDir := ExpandConstant('{userdesktop}\{#MyAppName}');

  // Reuse Inno's folder picker after the installation-type tasks.
  CustomDirPage := CreateInputDirPage(wpSelectTasks,
    SetupMessage(msgWizardSelectDir),
    'Choose where to place win-optimizer.',
    'To continue, click Next. If you would like to select a different folder, click Browse.',
    True, '{#MyAppName}');
  CustomDirPage.Add('Destination folder:');
  CustomDirPage.Values[0] := RegularInstallDir;
end;

// A mode change needs a separate destination so an existing installation keeps its registrations.
function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  TargetDir: String;
begin
  Result := '';
  TargetDir := AddBackslash(WizardDirValue);
  if FileExists(TargetDir + '{#MyAppExeName}') and
     (FileExists(TargetDir + 'portable.marker') <> WizardIsTaskSelected('portableinstall')) then
    Result := 'This folder contains a different installation type. Choose a different folder, or remove the existing installation first.';
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  PortableInstall: Boolean;
begin
  Result := True;

  // Keep separate destinations when the user goes Back and switches mode.
  if CurPageID = wpSelectTasks then
  begin
    PortableInstall := WizardIsTaskSelected('portableinstall');
    if HasSelectedInstallType then
    begin
      if PreviousPortableInstall then
        PortableInstallDir := CustomDirPage.Values[0]
      else
        RegularInstallDir := CustomDirPage.Values[0];
    end;

    // /DIR and the previous regular install location are resolved by Inno.
    if (not HasSelectedInstallType) and (ExpandConstant('{param:DIR|}') <> '') then
      CustomDirPage.Values[0] := WizardForm.DirEdit.Text
    else if PortableInstall then
      CustomDirPage.Values[0] := PortableInstallDir
    else
      CustomDirPage.Values[0] := RegularInstallDir;

    PreviousPortableInstall := PortableInstall;
    HasSelectedInstallType := True;
  end;

  // Use the selected folder verbatim, including /DIR during silent updates.
  if CurPageID = CustomDirPage.ID then
  begin
    WizardForm.DirEdit.Text := CustomDirPage.Values[0];
  end;
end;

[Tasks]
Name: "portableinstall"; Description: "Portable - movable app folder, without Windows registration"; GroupDescription: "Installation type:"; Flags: unchecked exclusive
Name: "regularinstall"; Description: "Regular - register with Windows and enable uninstallation"; GroupDescription: "Installation type:"; Flags: exclusive
Name: "regularinstall\desktopicon"; Description: "Create a shortcut on the Desktop"; GroupDescription: "Additional shortcuts:"
Name: "regularinstall\startmenuicon"; Description: "Create a shortcut in the Start menu"; GroupDescription: "Additional shortcuts:"

[Files]
; All application files and subdirectories (recursive) - includes self-contained .NET runtime
; Excludes:
;  - "nul": a zero-byte file with a Windows reserved device name created by MSBuild
;  - onnxruntime.dll / DirectML.dll: ~38 MB (uncompressed) of Windows ML native
;    libraries that the Microsoft.WindowsAppSDK metapackage bundles into every
;    self-contained build. win-optimizer calls no ML/AI APIs, so they are dead weight -
;    excluding them makes the installer ~13 MB smaller. The metapackage can't be
;    slimmed at the NuGet level (icon/control packages depend on it); see
;    microsoft/WindowsAppSDK#5969.
Source: "C:\win-optimizer\build\publish\*"; Excludes: "nul,onnxruntime.dll,DirectML.dll"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; Create a marker file for portable installations
Source: "C:\win-optimizer\extras\portable.marker"; DestDir: "{app}"; Flags: ignoreversion; Tasks: portableinstall
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Registry]
; Skip registry entries for portable installation
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocExt}\OpenWithProgids"; ValueType: string; ValueName: "{#MyAppAssocKey}"; ValueData: ""; Flags: uninsdeletevalue; Tasks: regularinstall
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}"; ValueType: string; ValueName: ""; ValueData: "{#MyAppAssocName}"; Flags: uninsdeletekey; Tasks: regularinstall
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"; Tasks: regularinstall
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: regularinstall

[Icons]
; Create Start menu shortcut only if selected in tasks
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: regularinstall\startmenuicon
; Create desktop shortcut only if selected in tasks
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: regularinstall\desktopicon

[Run]
; Launch application after installation
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: shellexec nowait postinstall skipifsilent

[UninstallDelete]
; Inno removes its tracked files; leave other files in the chosen folder intact.
Type: dirifempty; Name: "{app}"

