    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinOptimizer.Core\WinOptimizer.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <InternalsVisibleTo Include="WinOptimizer.Application.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configuration\Resources\*.win-optimizer"
