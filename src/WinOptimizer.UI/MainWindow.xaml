<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinOptimizer.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinOptimizer.UI"
    xmlns:controls="using:WinOptimizer.UI.Features.Common.Controls"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    Title="win-optimizer">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <!-- Ctrl+1-5: Navigate to sections -->
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="NavigateAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="NavigateAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="NavigateAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="NavigateAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="NavigateAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="HistoryAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="HistoryAccelerator_Invoked"/>
            <!-- Ctrl +/-/0: UI zoom (numpad keys; main-row +/- added in code-behind) -->
            <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="ZoomInAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="ZoomOutAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="ZoomResetAccelerator_Invoked"/>
            <!-- Ctrl+Shift+2-4: Title bar action buttons (Donate, Bug, Docs) -->
            <KeyboardAccelerator Key="Number2" Modifiers="Control,Shift" Invoked="TitleBarAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Number3" Modifiers="Control,Shift" Invoked="TitleBarAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Number4" Modifiers="Control,Shift" Invoked="TitleBarAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>    <!-- TitleBar -->
            <RowDefinition Height="Auto"/>  <!-- OTS Elevation InfoBar -->
            <RowDefinition Height="Auto"/>  <!-- Update InfoBar -->
            <RowDefinition Height="*"/>     <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- Title Bar Area -->
        <Grid x:Name="AppTitleBar" Height="48" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0"/>
                <ColumnDefinition x:Name="NavigationColumn" Width="Auto"/>
                <ColumnDefinition x:Name="DragColumn" Width="*"/>
                <ColumnDefinition x:Name="ButtonsColumn" Width="Auto"/>
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Include all navigation controls in the native title bar's clickable region. -->
            <StackPanel x:Name="TitleBarNavigation" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button x:Name="NavigateBackButton" Click="NavigateBack_Click"
                        IsEnabled="{x:Bind CanNavigateBack, Mode=OneWay}"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.NavigationBackTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.NavigationBackTooltip, Mode=OneWay}">
                    <fluentIcons:FluentIcon Icon="ArrowLeft" IconVariant="Regular" FontSize="16"/>
                </Button>
                <Button x:Name="NavigateForwardButton" Click="NavigateForward_Click"
                        IsEnabled="{x:Bind CanNavigateForward, Mode=OneWay}"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.NavigationForwardTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.NavigationForwardTooltip, Mode=OneWay}">
                    <fluentIcons:FluentIcon Icon="ArrowRight" IconVariant="Regular" FontSize="16"/>
                </Button>
            </StackPanel>

            <!-- Title Bar Action Buttons -->
            <StackPanel x:Name="TitleBarButtons"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Spacing="2">

                <!-- Test mode shares the action group's native clickable region. -->
                <ToggleButton x:Name="TrialModeToggle"
                              Width="32" Height="32" MinWidth="32" MinHeight="32"
                              Padding="0" CornerRadius="16"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              IsChecked="{x:Bind ViewModel.IsTrialMode, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanChangeTrialMode, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind ViewModel.TrialModeDescription, Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind ViewModel.TrialModeLabel, Mode=OneWay}">
                    <fluentIcons:FluentIcon Icon="Beaker" IconVariant="Regular" FontSize="20"/>
                </ToggleButton>

                <!-- Donate Button -->
                <Button x:Name="DonateButton"
                        Command="{x:Bind ViewModel.DonateCommand}"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.DonateTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.DonateTooltip, Mode=OneWay}">
                    <fluentIcons:FluentIcon Icon="Heart" IconVariant="Filled" FontSize="20" Foreground="#FFE74C3C"/>
                </Button>

                <!-- Bug Report Button -->
                <Button x:Name="BugReportButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.BugReportTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.BugReportTooltip, Mode=OneWay}">
                    <fluentIcons:FluentIcon Icon="Bug" IconVariant="Regular" FontSize="20"/>
                </Button>

                <!-- Documentation Button -->
                <Button x:Name="DocsButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.DocsTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.DocsTooltip, Mode=OneWay}">
                    <fluentIcons:FluentIcon Icon="BookQuestionMark" IconVariant="Regular" FontSize="20"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- OTS Elevation InfoBar -->
        <InfoBar x:Name="OtsElevationInfoBar"
                 Grid.Row="1"
                 Severity="Warning"
                 IsOpen="{x:Bind ViewModel.IsOtsInfoBarOpen, Mode=OneWay}"
                 Title="{x:Bind ViewModel.OtsInfoBarTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.OtsInfoBarMessage, Mode=OneWay}"
                 IsClosable="True"
                 Closed="OtsElevationInfoBar_Closed"/>

        <!-- Update InfoBar -->
        <InfoBar x:Name="UpdateInfoBar"
                 Grid.Row="2"
                 IsOpen="{x:Bind ViewModel.UpdateCheck.IsUpdateInfoBarOpen, Mode=OneWay}"
                 Title="{x:Bind ViewModel.UpdateCheck.UpdateInfoBarTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.UpdateCheck.UpdateInfoBarMessage, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.UpdateCheck.UpdateInfoBarSeverity, Mode=OneWay}"
                 IsClosable="True"
                 Closed="UpdateInfoBar_Closed"/>

        <!-- Main Content Area -->
        <Grid Grid.Row="3" x:Name="ZoomViewport">
            <!-- ZoomHost is inverse-sized + ScaleTransform'd by UiZoomManager for app-local zoom -->
            <Grid x:Name="ZoomHost">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- NavSidebar -->
                    <ColumnDefinition Width="*"/>     <!-- Content -->
                </Grid.ColumnDefinitions>

            <!-- Custom Navigation Sidebar -->
            <controls:NavSidebar x:Name="NavSidebar"
                                 Grid.Column="0"
                                 IsPaneOpen="{x:Bind ViewModel.SidebarPreferences.IsExpanded, Mode=OneWay}"
                                 ItemClicked="NavSidebar_ItemClicked"/>

            <!-- Content + Task Progress -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Content Frame for Page Navigation -->
                <Frame x:Name="ContentFrame" Grid.Row="0" Margin="{StaticResource PageHorizontalMargin}" Navigating="ContentFrame_Navigating" Navigated="ContentFrame_Navigated"/>
                <Border x:Name="TrialToolsOverlay" Grid.Row="0" Visibility="Collapsed"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="32">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="480">
                        <TextBlock Text="{x:Bind ViewModel.TrialModeLabel, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.TrialModeBlockedMessage, Mode=OneWay}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Task Progress Bars (up to 3 for parallel script removal) -->
                <Grid Grid.Row="1" Margin="{StaticResource PageHorizontalMargin}">
                    <Grid x:Name="TaskFooterLayout" Style="{StaticResource PageGridStyle}" Padding="0" Margin="0,2,0,8">
                        <StackPanel Spacing="4">
                            <controls:TaskProgressControl x:Name="TaskProgressControl"/>
                            <controls:TaskProgressControl x:Name="TaskProgressControl2"/>
                            <controls:TaskProgressControl x:Name="TaskProgressControl3"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            </Grid>
        </Grid>

        <!-- The same loader is retained while the full shell initializes. -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="4" Visibility="Visible"/>
    </Grid>
</Window>
