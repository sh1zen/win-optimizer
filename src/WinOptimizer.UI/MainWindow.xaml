<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinOptimizer.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinOptimizer.UI"
    xmlns:controls="using:WinOptimizer.UI.Features.Common.Controls"
    xmlns:dashboard="using:WinOptimizer.UI.Features.Dashboard"
    xmlns:helpers="using:WinOptimizer.UI.Features.Common.Helpers"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    Title="win-optimizer">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" PreviewKeyDown="RootGrid_PreviewKeyDown"
          Background="Transparent" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <!-- Ctrl+1-5: Navigate to sections -->
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="NavigateAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="NavigateAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="NavigateAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="NavigateAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="NavigateAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="HistoryAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="HistoryAccelerator_Invoked"/>
            <!-- Ctrl +/-/0: UI zoom (numpad keys; main-row +/- added in code-behind) -->
            <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="ZoomInAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="ZoomOutAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="ZoomResetAccelerator_Invoked"/>
            <!-- Ctrl+Shift+2-4: Title bar action buttons (Donate, Bug, Docs) -->
            <KeyboardAccelerator Key="Number2" Modifiers="Control,Shift" Invoked="TitleBarAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Number3" Modifiers="Control,Shift" Invoked="TitleBarAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Number4" Modifiers="Control,Shift" Invoked="TitleBarAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>    <!-- TitleBar -->
            <RowDefinition Height="Auto"/>  <!-- OTS Elevation InfoBar -->
            <RowDefinition Height="*"/>     <!-- Main Content -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SolidCanvas" Grid.RowSpan="3" Grid.ColumnSpan="2"
                Background="{ThemeResource AppCanvasBrush}" IsHitTestVisible="False"/>
        <Grid x:Name="SidebarSurface" Grid.RowSpan="3"
              Background="{ThemeResource AppSurfaceBrush}" IsHitTestVisible="False">
            <Rectangle x:Name="SidebarSeparator" Width="1" HorizontalAlignment="Right"
                       Fill="{ThemeResource AppSurfaceStrokeBrush}"/>
        </Grid>

        <!-- Title Bar Area -->
        <Grid x:Name="AppTitleBar" Height="48" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ButtonsColumn" Width="Auto"/>
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TitleBarLeadingContent" Grid.Column="1" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center" Padding="24,0,12,0">
                <Image x:Name="TitleBarIcon" Width="20" Height="20" VerticalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock x:Name="TitleBarAppName" VerticalAlignment="Center" Text="WinOptimizer"
                           FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Visibility="{Binding IsPaneOpen, ElementName=NavSidebar, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <StackPanel x:Name="TitleBarNavigation" Grid.Column="2" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                <Button x:Name="NavigateBackButton" Click="NavigateBack_Click" Width="32" Height="32"
                        IsEnabled="{x:Bind CanNavigateBack, Mode=OneWay}"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.NavigationBackTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.NavigationBackTooltip, Mode=OneWay}">
                    <fluentIcons:FluentIcon Icon="ArrowLeft" IconVariant="Regular" FontSize="16"/>
                </Button>
                <Button x:Name="NavigateForwardButton" Click="NavigateForward_Click" Width="32" Height="32"
                        IsEnabled="{x:Bind CanNavigateForward, Mode=OneWay}"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.NavigationForwardTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.NavigationForwardTooltip, Mode=OneWay}">
                    <fluentIcons:FluentIcon Icon="ArrowRight" IconVariant="Regular" FontSize="16"/>
                </Button>
            </StackPanel>

            <dashboard:ProgramSearch x:Name="TitleBarSearch" Grid.Column="3"
                                     MaxWidth="620" Margin="16,0" VerticalAlignment="Center"/>

            <!-- Title Bar Action Buttons -->
            <StackPanel x:Name="TitleBarButtons"
                        Grid.Column="4"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Spacing="2">

                <!-- Test mode shares the action group's native clickable region. -->
                <ToggleButton x:Name="TrialModeToggle"
                              Width="32" Height="32" MinWidth="32" MinHeight="32"
                              Padding="0" CornerRadius="16"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              IsChecked="{x:Bind ViewModel.IsTrialMode, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanChangeTrialMode, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind ViewModel.TrialModeDescription, Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind ViewModel.TrialModeLabel, Mode=OneWay}">
                    <fluentIcons:FluentIcon Icon="Beaker" IconVariant="Regular" FontSize="20"/>
                </ToggleButton>

                <!-- Donate Button -->
                <Button x:Name="DonateButton"
                        Command="{x:Bind ViewModel.DonateCommand}"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.DonateTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.DonateTooltip, Mode=OneWay}">
                    <fluentIcons:FluentIcon Icon="Heart" IconVariant="Filled" FontSize="20" Foreground="#FFE74C3C"/>
                </Button>

                <!-- Bug Report Button -->
                <Button x:Name="BugReportButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.BugReportTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.BugReportTooltip, Mode=OneWay}">
                    <fluentIcons:FluentIcon Icon="Bug" IconVariant="Regular" FontSize="20"/>
                </Button>

                <!-- Documentation Button -->
                <Button x:Name="DocsButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.DocsTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.DocsTooltip, Mode=OneWay}">
                    <fluentIcons:FluentIcon Icon="BookQuestionMark" IconVariant="Regular" FontSize="20"/>
                </Button>

                <controls:TaskProgressControl x:Name="TaskActivity" ViewModel="{x:Bind ViewModel.TaskProgress, Mode=OneWay}"/>

                <Button x:Name="UpdatesButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.UpdateCheck.CheckForUpdatesLabel, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.UpdateCheck.CheckForUpdatesLabel, Mode=OneWay}">
                    <helpers:PopupHandler.Content>
                        <StackPanel Spacing="8" MaxWidth="280">
                            <TextBlock x:Name="UpdateCurrentVersion" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.UpdateCheck.CurrentVersionText, Mode=OneWay}"/>
                            <TextBlock x:Name="UpdateLatestVersion" TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.UpdateCheck.LatestVersionText, Mode=OneWay}"/>
                            <TextBlock x:Name="UpdateCheckStatus" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       AutomationProperties.LiveSetting="Polite"
                                       Text="{x:Bind ViewModel.UpdateCheck.UpdateStatusText, Mode=OneWay}"/>
                            <Button x:Name="CheckForUpdatesAction" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.UpdateCheck.CheckForUpdatesCommand, Mode=OneWay}">
                                <TextBlock TextWrapping="Wrap"
                                           Text="{x:Bind ViewModel.UpdateCheck.CheckForUpdatesLabel, Mode=OneWay}"/>
                            </Button>
                        </StackPanel>
                    </helpers:PopupHandler.Content>
                    <Grid DataContext="{x:Bind ViewModel.UpdateCheck, Mode=OneWay}">
                        <fluentIcons:FluentIcon Icon="ArrowSync" IconVariant="Regular" FontSize="20"
                                               Visibility="{Binding IsUpdateCheckInProgress, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <ProgressRing Width="18" Height="18"
                                      IsActive="{Binding IsUpdateCheckInProgress}"
                                      Visibility="{Binding IsUpdateCheckInProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- OTS Elevation InfoBar -->
        <InfoBar x:Name="OtsElevationInfoBar"
                 Grid.Row="1" Grid.Column="1"
                 Severity="Warning"
                 IsOpen="{x:Bind ViewModel.IsOtsInfoBarOpen, Mode=OneWay}"
                 Title="{x:Bind ViewModel.OtsInfoBarTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.OtsInfoBarMessage, Mode=OneWay}"
                 IsClosable="True"
                 Closed="OtsElevationInfoBar_Closed"/>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" x:Name="ZoomViewport">
            <!-- ZoomHost is inverse-sized + ScaleTransform'd by UiZoomManager for app-local zoom -->
            <Grid x:Name="ZoomHost">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- NavSidebar -->
                    <ColumnDefinition Width="*"/>     <!-- Content -->
                </Grid.ColumnDefinitions>

            <!-- Custom Navigation Sidebar -->
            <controls:NavSidebar x:Name="NavSidebar"
                                 Grid.Column="0"
                                 Margin="12,4,0,12"
                                 IsPaneOpen="{x:Bind ViewModel.SidebarPreferences.IsExpanded, Mode=OneWay}"
                                 ItemClicked="NavSidebar_ItemClicked"/>

            <Grid Grid.Column="1" Margin="0,8,0,0">
                <!-- Content Frame for Page Navigation -->
                <Frame x:Name="ContentFrame" Margin="{StaticResource PageHorizontalMargin}" Navigating="ContentFrame_Navigating" Navigated="ContentFrame_Navigated">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <SuppressNavigationTransitionInfo/>
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
                <Border x:Name="TrialToolsOverlay" Visibility="Collapsed"
                        Background="{ThemeResource AppCanvasBrush}" Padding="32">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="480">
                        <TextBlock Text="{x:Bind ViewModel.TrialModeLabel, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.TrialModeBlockedMessage, Mode=OneWay}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </Grid>
            </Grid>
        </Grid>

        <dashboard:ProgramSearchResults x:Name="SearchResultsOverlay" Grid.Row="1" Grid.RowSpan="2"
                                        Grid.ColumnSpan="2" Visibility="Collapsed"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    MaxWidth="400" Margin="16" Spacing="8">
            <controls:UpdateToast x:Name="UpdateNotification" HorizontalAlignment="Right"
                                  ViewModel="{x:Bind ViewModel.UpdateCheck, Mode=OneWay}"/>
            <InfoBar x:Name="ScanCancellationToast" HorizontalAlignment="Right" IsClosable="True"
                     CornerRadius="{StaticResource OverlayCornerRadius}" Severity="Informational"/>
        </StackPanel>

        <!-- The same loader is retained while the full shell initializes. -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2" Visibility="Visible"/>
    </Grid>
</Window>
