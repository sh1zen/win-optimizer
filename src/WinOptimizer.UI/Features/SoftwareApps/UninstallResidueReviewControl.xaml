<UserControl x:Class="WinOptimizer.UI.Features.SoftwareApps.UninstallResidueReviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinOptimizer.UI.Features.SoftwareApps.ViewModels" xmlns:fluent="using:FluentIcons.WinUI"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="ResidueNodeTemplate" x:DataType="vm:UninstallResidueNode">
            <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Detail}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsThreeState="False" IsEnabled="{x:Bind CanSelect, Mode=OneWay}"
                              MinWidth="0" MinHeight="30" Padding="0" AutomationProperties.Name="{x:Bind FullPath}"/>
                    <fluent:FluentIcon Grid.Column="1" Icon="{x:Bind Icon}" IconVariant="Regular" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{x:Bind Size}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{x:Bind Modified}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </TreeViewItem>
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Padding="{StaticResource ScrollContentPadding}" MaxHeight="100" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer>
        <ScrollViewer Padding="{StaticResource ScrollContentPadding}" Grid.Row="1" MaxHeight="75" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{x:Bind ViewModel.Notices, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
        </ScrollViewer>
        <Grid Grid.Row="2">
            <TextBlock Text="{x:Bind ViewModel.ScanHint}" TextWrapping="Wrap" VerticalAlignment="Top"
                       Visibility="{x:Bind ViewModel.IsScanStep, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Grid RowSpacing="12" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.StepLabel, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.EmptyLabel}" VerticalAlignment="Top" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.IsCurrentEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TreeView x:Name="ResultsTree" Grid.Row="1" ItemsSource="{x:Bind ViewModel.CurrentRoots, Mode=OneWay}"
                          ItemTemplate="{StaticResource ResidueNodeTemplate}" IsEnabled="{x:Bind ViewModel.CanSelect, Mode=OneWay}"
                          SelectionMode="None" AutomationProperties.Name="{x:Bind ViewModel.StepLabel, Mode=OneWay}"/>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.Detail, Mode=OneWay}" TextWrapping="Wrap" MaxLines="4" IsTextSelectionEnabled="True" FontSize="11"/>
        <StackPanel Grid.Row="4" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" FontWeight="SemiBold"
                       Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <toolkit:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"
                               Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Content="{x:Bind ViewModel.SelectAllLabel}" Command="{x:Bind ViewModel.SelectAllCommand}"/>
                <Button Content="{x:Bind ViewModel.SelectNoneLabel}" Command="{x:Bind ViewModel.SelectNoneCommand}"/>
                <Button Content="{x:Bind ViewModel.DeleteLabel}" Command="{x:Bind ViewModel.RequestDeleteCommand}"/>
                <Button Content="{x:Bind ViewModel.RestoreLabel}" Command="{x:Bind ViewModel.RequestRestoreCommand}"/>
            </toolkit:WrapPanel>
            <toolkit:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                <Button Content="{x:Bind ViewModel.ScanLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ScanCommand}"/>
                <Button Content="{x:Bind ViewModel.PreviousLabel}" Command="{x:Bind ViewModel.PreviousCommand}"
                        Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="{x:Bind ViewModel.NextLabel}" Command="{x:Bind ViewModel.NextCommand}"
                        Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </toolkit:WrapPanel>
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsConfirming, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{x:Bind ViewModel.Confirmation, Mode=OneWay}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Bind ViewModel.ConfirmLabel}" Command="{x:Bind ViewModel.ConfirmCommand}" Style="{StaticResource AccentButtonStyle}"/>
                    <Button Content="{x:Bind ViewModel.CancelLabel}" Command="{x:Bind ViewModel.CancelCommand}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Padding="{StaticResource ScrollContentPadding}" Grid.Row="5" MaxHeight="80" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"/>
        </ScrollViewer>
    </Grid>
</UserControl>
