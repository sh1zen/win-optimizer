<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinOptimizer.UI.Features.SoftwareApps.SoftwareAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DefaultBindMode="OneWay"
    NavigationCacheMode="Enabled"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    xmlns:vm="using:WinOptimizer.UI.Features.SoftwareApps.ViewModels"
    xmlns:softwareApps="using:WinOptimizer.UI.Features.SoftwareApps"
    xmlns:winOptimizerControls="using:WinOptimizer.UI.Features.Common.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="InventoryTabButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="16,8,16,10"/>
        </Style>
        <Style x:Key="SelectedInventoryTabButtonStyle" TargetType="Button" BasedOn="{StaticResource InventoryTabButtonStyle}">
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="InventoryTabIndicatorStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="InventoryToolbarButtonStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style x:Key="InventoryViewButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinWidth" Value="43"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style x:Key="InventorySelectionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <!-- Reserve the same scrollbar gutter and bottom inset for both inventories. -->
        <Style x:Key="AppTableStyle" TargetType="controls:DataGrid">
            <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="Padding" Value="0,0,0,12"/>
        </Style>
        <x:Double x:Key="AppTableNameSpacing">4</x:Double>

        <!-- Shared metadata cells bind display text; column tags retain typed sort values. -->
        <DataTemplate x:Key="AppLastUsageCellTemplate">
            <TextBlock Text="{Binding LastUsageTimeText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding LastUsageTimeText}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </DataTemplate>
        <DataTemplate x:Key="AppInstallationDateCellTemplate">
            <TextBlock Text="{Binding InstallationDateText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding InstallationDateText}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </DataTemplate>
        <DataTemplate x:Key="AppSizeCellTemplate">
            <TextBlock Text="{Binding SizeText}" VerticalAlignment="Center" TextAlignment="Right"
                       Margin="0,0,8,0"
                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SizeText}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </DataTemplate>
        <!-- ============================================================
             Icon sizing knobs (Software & Apps tabs).
             Each view has its OWN icon-size pair — they are NOT shared:
               • CompactIconSize / CompactFallbackFontSize        → Compact view
                 (Windows Apps + External Apps compact lists)
               • DataGridIconSize / DataGridFallbackFontSize → Table view
               • CardViewIconSize / CardViewAppsIconSize → Card view
             FontIcon size is the fallback glyph that shows when no real
             icon is resolved; sized to fill the icon cell (~ icon size)
             so fallbacks read at the same size as resolved icons.
             Also tune AppItemViewModel.cs `DecodePixelWidth` (≈ 2× your
             largest icon size) for HiDPI sharpness.
             ============================================================ -->
        <x:Double x:Key="CompactIconSize">20</x:Double>
        <x:Double x:Key="CompactFallbackFontSize">20</x:Double>
        <x:Double x:Key="DataGridIconSize">20</x:Double>
        <x:Double x:Key="DataGridFallbackFontSize">20</x:Double>

        <!-- FluentIcon "Apps Color" carries intrinsic padding inside its draw box,
             so it renders a little smaller than its nominal FontSize. To make the
             fallbacks read close to the real 20px app images, the Apps fallback is
             sized slightly OVER its 20px cell (22 -> ~1px overflow each side, absorbed
             by the inter-icon spacing) in BOTH the compact and table views; the Segoe
             puzzle/gear fallbacks (Compact/DataGrid FallbackFontSize) fill the cell at
             20. -->
        <x:Double x:Key="CompactAppsIconSize">22</x:Double>
        <x:Double x:Key="DataGridAppsIconSize">22</x:Double>

        <!-- Cards stretch to fill each row, down to this column breakpoint. -->
        <x:Double x:Key="CardItemWidth">264</x:Double>
        <x:Double x:Key="CardColumnSpacing">16</x:Double>
        <x:Double x:Key="CardRowSpacing">14</x:Double>
        <!-- Compact-view cell width (fixed). The compact
             ItemsControl + UniformWrapPanel renders every row at exactly this
             width and wraps when the next would overflow; the containing
             StackPanel is centred via a code-behind MaxWidth clamp so leftover
             space becomes symmetric outer margin (Microsoft Store pattern).
             Kept narrower than the Card view so a wide window still fits
             several columns of single-line rows. -->
        <x:Double x:Key="CompactItemWidth">320</x:Double>
        <!-- Compact-view name TextBlock MaxWidth cap. The compact row uses an
             auto-sized Grid [icons, name, warning] so the warning icon sits
             immediately to the right of the name's rendered text (rather than
             being pushed to the far right of the cell). The name TextBlock
             gets MaxWidth=CompactNameMaxWidth — that's what triggers
             CharacterEllipsis when a long name would otherwise expand the
             auto column. Sized so icons (~76dp) + this (210dp) + warning
             (16dp) + spacings + CheckBox padding fits inside CompactItemWidth
             (320dp). Scaled in lockstep with CompactItemWidth at startup via
             ApplyTextScaling so higher text scale gets proportionally more
             room for the name. -->
        <x:Double x:Key="CompactNameMaxWidth">210</x:Double>
        <x:Double x:Key="CardViewIconSize">44</x:Double>
        <x:Double x:Key="CardViewAppsIconSize">46</x:Double>
        <CornerRadius x:Key="CardViewCornerRadius">12</CornerRadius>
        <Thickness x:Key="CardViewPadding">18,10,12,10</Thickness>

        <!-- The panel grows every row when wrapping or text scaling needs more room. -->
        <x:Double x:Key="CardCellHeight">78</x:Double>

        <!-- Card-view selection target. Wrapping the whole card in a templated
             ToggleButton is what makes "click anywhere on the card" reliably
             toggle selection — Border + Tapped from the data template was
             not firing in this hierarchy (ItemsRepeater + StackPanel + ScrollViewer).
             The ToggleButton's IsChecked is bound two-way to AppItemViewModel.IsSelected,
             so the inner CheckBox visual indicator only needs OneWay binding and
             can stay IsHitTestVisible=False (no double-toggle). -->
        <Style x:Key="CardToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="CardBorder"
                                Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardViewCornerRadius}"
                                Padding="{StaticResource CardViewPadding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectionColumnHeaderStyle" TargetType="primitives:DataGridColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:DataGridColumnHeader">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="4,0,0,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectAllColumnHeaderStyle" TargetType="primitives:DataGridColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:DataGridColumnHeader">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderBackground" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderBackground" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorDisabledBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HeaderBackground"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4,0,0,4"/>
                            <CheckBox Tag="SelectAll"
                                      MinWidth="20"
                                      Margin="8,4,4,4"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Middle column headers: no rounding, with sort indicators -->
        <Style x:Key="ColumnHeaderStyle" TargetType="primitives:DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8,12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:DataGridColumnHeader">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderBackground" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderBackground" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorDisabledBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SortStates">
                                    <VisualState x:Name="Unsorted"/>
                                    <VisualState x:Name="SortAscending">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortIcon" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortIcon" Storyboard.TargetProperty="Glyph">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="&#xE70E;"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="SortDescending">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortIcon" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortIcon" Storyboard.TargetProperty="Glyph">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="&#xE70D;"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HeaderBackground"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="0"/>
                            <Grid Padding="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                                <FontIcon x:Name="SortIcon"
                                          Grid.Column="1"
                                          Glyph="&#xE70E;"
                                          FontSize="10"
                                          Margin="4,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Last column header: right-rounded corners, with sort indicators -->
        <Style x:Key="LastColumnHeaderStyle" TargetType="primitives:DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8,12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:DataGridColumnHeader">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderBackground" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderBackground" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorDisabledBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SortStates">
                                    <VisualState x:Name="Unsorted"/>
                                    <VisualState x:Name="SortAscending">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortIcon" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortIcon" Storyboard.TargetProperty="Glyph">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="&#xE70E;"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="SortDescending">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortIcon" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortIcon" Storyboard.TargetProperty="Glyph">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="&#xE70D;"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HeaderBackground"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="0,4,4,0"/>
                            <Grid Padding="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                                <FontIcon x:Name="SortIcon"
                                          Grid.Column="1"
                                          Glyph="&#xE70E;"
                                          FontSize="10"
                                          Margin="4,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fix 2: Remove header-to-row separator line -->
        <SolidColorBrush x:Key="GridLinesBrush" Color="Transparent"/>

        <!-- Fix 3A: Remove cell focus visuals (white/black rectangles on click) -->
        <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="DataGridCurrencyVisualPrimaryBrush" Color="Transparent"/>

        <!-- Fix 3B: Custom DataGridRow style with accent selection border.
             Uses standard WinUI 3 brushes instead of DataGrid-internal theme resources
             (DataGridRow*BackgroundColor etc. are not in scope at page level). -->
        <Style x:Key="SelectionRowStyle" TargetType="controls:DataGridRow">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:DataGridRow">
                        <primitives:DataGridFrozenGrid x:Name="RowRoot">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="NormalAlternatingRow"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundRectangle"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="NormalSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundRectangle"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundRectangle"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverUnfocusedSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundRectangle"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="UnfocusedSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundRectangle"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="ValidationStates">
                                    <VisualState x:Name="Valid"/>
                                    <VisualState x:Name="Invalid">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Duration="0"
                                                                           Storyboard.TargetName="BackgroundRectangle"
                                                                           Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="InvalidVisualElement"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0"
                                                             To="0.4"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Rectangle x:Name="BackgroundRectangle" Grid.ColumnSpan="2"
                                       Fill="Transparent"/>
                            <Rectangle x:Name="InvalidVisualElement" Grid.ColumnSpan="2"
                                       Opacity="0"
                                       Fill="{ThemeResource SystemFillColorCriticalBrush}"/>

                            <!-- Accent selection border overlay -->
                            <Border x:Name="SelectionBorder"
                                    Grid.ColumnSpan="2"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Margin="0,0,4,0"
                                    BorderBrush="Transparent"/>

                            <primitives:DataGridRowHeader x:Name="RowHeader" Grid.RowSpan="3"
                                                          primitives:DataGridFrozenGrid.IsFrozen="True"/>
                            <primitives:DataGridCellsPresenter x:Name="CellsPresenter" Grid.Column="1"
                                                                primitives:DataGridFrozenGrid.IsFrozen="True"
                                                                MinHeight="32"
                                                                AutomationProperties.AccessibilityView="Raw"/>
                            <primitives:DataGridDetailsPresenter x:Name="DetailsPresenter" Grid.Row="1" Grid.Column="1"
                                                                  Background="Transparent"
                                                                  AutomationProperties.AccessibilityView="Raw"/>
                            <Rectangle x:Name="BottomGridLine" Grid.Row="2" Grid.Column="1"
                                       HorizontalAlignment="Stretch" Height="1"/>
                        </primitives:DataGridFrozenGrid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AppCardTemplate" x:DataType="vm:AppItemViewModel">
            <!-- Wrap the whole card in a templated ToggleButton so clicking
                 anywhere on it toggles selection. ToggleButton.IsChecked
                 binds two-way to IsSelected; the inner CheckBox is purely a
                 visual indicator (IsHitTestVisible=False, OneWay). -->
            <ToggleButton IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                          Style="{StaticResource CardToggleButtonStyle}"
                          AutomationProperties.Name="{x:Bind Name}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="2"
                              Style="{StaticResource InventorySelectionCheckBoxStyle}"
                              IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                              IsHitTestVisible="False"
                              IsTabStop="False"
                              MinWidth="20"
                              Padding="0"
                              VerticalAlignment="Top"/>

                    <Grid
                          Width="{StaticResource CardViewIconSize}"
                          Height="{StaticResource CardViewIconSize}"
                          VerticalAlignment="Center">
                        <Image Source="{x:Bind IconSource, Mode=OneWay}"
                               Stretch="Uniform"
                               Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <fluentIcons:FluentIcon Icon="Apps" IconVariant="Color"
                                                FontSize="{StaticResource CardViewAppsIconSize}"
                                                Visibility="{x:Bind IsAppXFallback, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <fluentIcons:FluentIcon Icon="PuzzlePiece" IconVariant="Color"
                                                FontSize="{StaticResource CardViewAppsIconSize}"
                                                Visibility="{x:Bind IsCapabilityFallback, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <fluentIcons:FluentIcon Icon="StarSettings" IconVariant="Color"
                                                FontSize="{StaticResource CardViewAppsIconSize}"
                                                Visibility="{x:Bind IsOptionalFeatureFallback, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>

                    <Grid Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: name + website button -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind Name}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind Name}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <winOptimizerControls:WebsiteLinkButton Grid.Column="1"
                                                                Url="{x:Bind WebsiteUrl, Mode=OneWay}"/>
                        </Grid>

                        <!-- Row 1: description -->
                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind Description}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"
                                   ToolTipService.ToolTip="{x:Bind Description}"
                                   Margin="0,2,0,0"
                                   Visibility="{x:Bind HasDescription, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <toolkit:WrapPanel Grid.Row="2" HorizontalSpacing="6" VerticalSpacing="4" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Visibility="{x:Bind ShowNonReinstallableChip, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTipService.ToolTip="{x:Bind ReinstallableStatusTooltip, Mode=OneWay}">
                                <fluentIcons:FluentIcon Icon="LockClosed" IconVariant="Regular" FontSize="14"/>
                                <TextBlock Text="{x:Bind ReinstallableStatusText, Mode=OneWay}" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Border Style="{StaticResource BadgeWarningStyle}"
                                    Visibility="{x:Bind IsInactive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTipService.ToolTip="{x:Bind InstalledStatusTooltip, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="18" Height="18" Margin="0,0,4,2" VerticalAlignment="Center">
                                        <fluentIcons:FluentIcon Icon="CheckmarkCircle" IconVariant="Regular" Foreground="{ThemeResource BadgeCustomForeground}" />
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind InstalledStatusText, Mode=OneWay}"
                                               Style="{StaticResource BadgeTextStyle}"
                                               Foreground="{ThemeResource BadgeCustomForeground}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource BadgeWarningStyle}"
                                    Visibility="{x:Bind HasInstabilityWarning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTipService.ToolTip="{x:Bind InstabilityWarningTooltip, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="18" Height="18" Margin="0,0,4,2" VerticalAlignment="Center">
                                        <fluentIcons:FluentIcon Icon="ErrorCircle" IconVariant="Color" />
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind InstabilityWarningLabel, Mode=OneWay}"
                                               Style="{StaticResource BadgeTextStyle}"
                                               Foreground="{ThemeResource BadgeCustomForeground}"/>
                                </StackPanel>
                            </Border>
                        </toolkit:WrapPanel>
                    </Grid>
                </Grid>
            </ToggleButton>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.PageTitle}" FontSize="34" FontWeight="Bold"
                           TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock Text="{x:Bind ViewModel.PageDescription}" FontSize="16" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Style="{StaticResource InventoryToolbarButtonStyle}" Command="{x:Bind ViewModel.ReviewUninstallBackupsCommand}" AutomationProperties.Name="{x:Bind ViewModel.UninstallBackupsText, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.UninstallBackupsText, Mode=OneWay}">
                    <fluentIcons:FluentIcon Icon="History" IconVariant="Regular" FontSize="18"/>
                </Button>
                <Button Style="{StaticResource InventoryToolbarButtonStyle}" Command="{x:Bind ViewModel.RefreshInstallationStatusCommand}"
                        AutomationProperties.Name="{x:Bind ViewModel.RefreshButtonText}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5"/>
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <fluentIcons:FluentIcon Icon="ArrowSync" IconVariant="Regular" FontSize="18"/>
                        <TextBlock Text="{x:Bind ViewModel.RefreshButtonText}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="InventoryTabsHost" SizeChanged="InventoryTabsHost_SizeChanged">
                <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource AppSurfaceStrokeBrush}"/>
                <Grid x:Name="InventoryTabs" HorizontalAlignment="Left" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Button x:Name="WindowsAppsTab" Style="{x:Bind GetInventoryTabStyle(ViewModel.IsWindowsAppsTabSelected), Mode=OneWay}"
                                Command="{x:Bind ViewModel.SelectWindowsAppsTabCommand}"
                                AutomationProperties.Name="{x:Bind ViewModel.WindowsAppsTabText, Mode=OneWay}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18">
                                    <PathIcon Data="{StaticResource WindowsLogoIconPath}"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WindowsAppsTabText}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Border x:Name="WindowsAppsTabIndicator" Style="{StaticResource InventoryTabIndicatorStyle}"
                                Visibility="{x:Bind ViewModel.IsWindowsAppsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <InfoBadge x:Name="WindowsAppsTabBadge"
                                   Value="{x:Bind ViewModel.WindowsAppsSelectedCount, Mode=OneWay}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="0,2,8,0" Visibility="Collapsed"/>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Button x:Name="ExternalAppsTab" Style="{x:Bind GetInventoryTabStyle(ViewModel.IsExternalAppsTabSelected), Mode=OneWay}"
                                Command="{x:Bind ViewModel.SelectExternalAppsTabCommand}"
                                IsEnabled="{x:Bind ViewModel.IsExternalAppsTabEnabled, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.ExternalAppsTabText, Mode=OneWay}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18">
                                    <PathIcon Data="{StaticResource ExternalAppsIconPath}"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ExternalAppsTabText}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Border x:Name="ExternalAppsTabIndicator" Style="{StaticResource InventoryTabIndicatorStyle}"
                                Visibility="{x:Bind ViewModel.IsExternalAppsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <InfoBadge x:Name="ExternalAppsTabBadge"
                                   Value="{x:Bind ViewModel.ExternalAppsSelectedCount, Mode=OneWay}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="0,2,8,0" Visibility="Collapsed"/>
                        <!-- The overlay keeps the lock tooltip available when the tab is disabled. -->
                        <Border x:Name="ExternalAppsTabLockOverlay"
                                Background="Transparent"
                                Visibility="{x:Bind ViewModel.IsExternalAppsTabLocked, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ExternalAppsTabLockedTooltip, Mode=OneWay}"/>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Button x:Name="LeftoverTab" Style="{x:Bind GetInventoryTabStyle(ViewModel.IsLeftoverTabSelected), Mode=OneWay}"
                                Command="{x:Bind ViewModel.SelectLeftoverTabCommand}"
                                IsEnabled="{x:Bind ViewModel.IsLeftoverTabEnabled, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.LeftoverTabText, Mode=OneWay}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <fluentIcons:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="18"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LeftoverTabText}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Border x:Name="LeftoverTabIndicator" Style="{StaticResource InventoryTabIndicatorStyle}"
                                Visibility="{x:Bind ViewModel.IsLeftoverTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Grid>


            <Grid x:Name="SoftwareAppsActionBar" Grid.Row="1" ColumnSpacing="24" Margin="0,18,0,20"
                  SizeChanged="SoftwareAppsActionBar_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="AppSearchGroup" VerticalAlignment="Center">
                    <TextBox x:Name="AppSearchBox"
                             PlaceholderText="{x:Bind ViewModel.SearchPlaceholder}"
                             AutomationProperties.Name="{x:Bind ViewModel.SearchLabel}"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             InputScope="Search" MinHeight="36" Padding="40,6,10,6"
                             CornerRadius="{StaticResource ControlCornerRadius}"/>
                    <fluentIcons:FluentIcon Icon="Search" IconVariant="Regular" FontSize="16"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            IsHitTestVisible="False" Margin="15,0,0,0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <toolkit:WrapPanel x:Name="InventoryFilters" Grid.Column="1" VerticalAlignment="Center"
                                   HorizontalSpacing="20" VerticalSpacing="8"
                                   Visibility="{x:Bind ViewModel.IsInventoryTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ToggleButton x:Name="ShowHiddenInstalledAppsToggle"
                                  Width="36" Height="36" Padding="0" VerticalAlignment="Center"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  CornerRadius="{StaticResource ControlCornerRadius}"
                                  Visibility="{x:Bind ViewModel.IsWindowsAppsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  AutomationProperties.Name="{x:Bind ViewModel.WindowsAppsViewModel.ShowHiddenInstalledAppsLabel}"
                                  ToolTipService.ToolTip="{x:Bind ViewModel.WindowsAppsViewModel.ShowHiddenInstalledAppsTooltip}"
                                  IsChecked="{x:Bind ViewModel.WindowsAppsViewModel.ShowHiddenInstalledApps, Mode=TwoWay}">
                        <fluentIcons:FluentIcon Icon="{x:Bind GetHiddenAppsIcon(ViewModel.WindowsAppsViewModel.ShowHiddenInstalledApps)}"
                                                IconVariant="Regular" FontSize="18" AutomationProperties.AccessibilityView="Raw"/>
                    </ToggleButton>
                    <DropDownButton x:Name="SortButton" MinHeight="36" MinWidth="120"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Visibility="{x:Bind ViewModel.IsInventoryTabSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="{x:Bind ViewModel.SortButtonText, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.SortButtonText, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8CB;" FontSize="16"/>
                            <TextBlock x:Name="SortButtonLabel" Text="{x:Bind ViewModel.SortButtonText, Mode=OneWay}"/>
                        </StackPanel>
                        <DropDownButton.Resources>
                                <RadioMenuFlyoutItem x:Key="SortGroupAscMenuItem" x:Name="SortGroupAscMenuItem" GroupName="SortMode"
                                                     Text="{x:Bind ViewModel.SortGroupAscText, Mode=OneWay}"
                                                     IsChecked="{x:Bind ViewModel.IsSortGroupAsc, Mode=OneWay}"
                                                     Click="SortGroupAsc_Click"/>
                                <RadioMenuFlyoutItem x:Key="SortNameAscendingMenuItem" x:Name="SortNameAscendingMenuItem" GroupName="SortMode"
                                                     Text="{x:Bind ViewModel.SortNameAscText, Mode=OneWay}"
                                                     IsChecked="{x:Bind ViewModel.IsSortNameAsc, Mode=OneWay}"
                                                     Click="SortNameAsc_Click"/>
                                <RadioMenuFlyoutItem x:Key="SortInstallationDateMenuItem" x:Name="SortInstallationDateMenuItem" GroupName="SortMode"
                                                     Text="{x:Bind ViewModel.SortInstallationDateText, Mode=OneWay}"
                                                     IsChecked="{x:Bind ViewModel.IsSortInstallationDate, Mode=OneWay}"
                                                     Click="SortInstallationDate_Click"/>
                                <RadioMenuFlyoutItem x:Key="SortSizeMenuItem" x:Name="SortSizeMenuItem" GroupName="SortMode"
                                                     Text="{x:Bind ViewModel.SortSizeText, Mode=OneWay}"
                                                     IsChecked="{x:Bind ViewModel.IsSortSize, Mode=OneWay}"
                                                     Click="SortSize_Click"/>
                                <RadioMenuFlyoutItem x:Key="SortLastUsageTimeMenuItem" x:Name="SortLastUsageTimeMenuItem" GroupName="SortMode"
                                                     Text="{x:Bind ViewModel.SortLastUsageTimeText, Mode=OneWay}"
                                                     IsChecked="{x:Bind ViewModel.IsSortLastUsageTime, Mode=OneWay}"
                                                     Click="SortLastUsageTime_Click"/>
                            </DropDownButton.Resources>
                    </DropDownButton>
                    <!-- View Mode Toggle -->
                    <Border Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}"
                            Visibility="{x:Bind ViewModel.IsInventoryTabSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="CardViewToggle"
                                          IsChecked="{x:Bind ViewModel.IsCardView, Mode=OneWay}"
                                          Click="CardViewToggle_Click"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.ViewModeCardTooltip}"
                                          AutomationProperties.Name="{x:Bind ViewModel.ViewModeCardTooltip}"
                                          Style="{StaticResource InventoryViewButtonStyle}">
                                <fluentIcons:FluentIcon Icon="Grid" IconVariant="Regular" FontSize="18"/>
                            </ToggleButton>
                            <ToggleButton x:Name="TableViewToggle"
                                          IsChecked="{x:Bind ViewModel.IsTableView, Mode=OneWay}"
                                          Click="TableViewToggle_Click"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.ViewModeTableTooltip}"
                                          AutomationProperties.Name="{x:Bind ViewModel.ViewModeTableTooltip}"
                                          Style="{StaticResource InventoryViewButtonStyle}">
                                <fluentIcons:FluentIcon Icon="TableSimple" IconVariant="Regular" FontSize="18"/>
                            </ToggleButton>
                            <ToggleButton x:Name="CompactViewToggle"
                                          IsChecked="{x:Bind ViewModel.IsCompactView, Mode=OneWay}"
                                          Click="CompactViewToggle_Click"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.ViewModeCompactTooltip}"
                                          AutomationProperties.Name="{x:Bind ViewModel.ViewModeCompactTooltip}"
                                          Style="{StaticResource InventoryViewButtonStyle}">
                                <fluentIcons:FluentIcon Icon="LineHorizontal3" IconVariant="Regular" FontSize="18"/>
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                </toolkit:WrapPanel>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="4" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="InstalledAppsHeading" Text="{x:Bind ViewModel.WindowsAppsViewModel.SectionAppsHeader}"
                           Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level2" VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.IsWindowsAppsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <toolkit:WrapPanel x:Name="InventorySelectionActions" Grid.Column="1"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   HorizontalSpacing="16" VerticalSpacing="8">
                    <CheckBox x:Name="SelectAllWindowsApps" MinWidth="0" VerticalAlignment="Center"
                              Style="{StaticResource InventorySelectionCheckBoxStyle}"
                              Content="{x:Bind ViewModel.WindowsAppsViewModel.SelectAllLabel}"
                              Visibility="{x:Bind ViewModel.IsWindowsAppsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                              IsChecked="{x:Bind ViewModel.WindowsAppsViewModel.AreAllVisibleAppsSelected}"
                              Command="{x:Bind ViewModel.WindowsAppsViewModel.ToggleSelectAllVisibleAppsCommand}"/>
                    <Button x:Name="UninstallSelectedButton" Style="{StaticResource InventoryToolbarButtonStyle}"
                            Command="{x:Bind ViewModel.RemoveSelectedItemsCommand}"
                            IsEnabled="{x:Bind ViewModel.CanRemoveItems, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.RemoveButtonText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowRemoveAction, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fluentIcons:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="18"/>
                            <TextBlock Text="{x:Bind ViewModel.RemoveButtonText, Mode=OneWay}"/>
                        </StackPanel>
                    </Button>
                    <!-- Review mode: Remove action toggle -->
                    <ToggleButton x:Name="RemoveActionToggle"
                                  Visibility="{x:Bind ViewModel.IsInReviewMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  IsChecked="{x:Bind ViewModel.CurrentRemoveAction, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind ViewModel.RemoveButtonText, Mode=OneWay}"
                                  MinHeight="36" Padding="12,6" CornerRadius="{StaticResource ControlCornerRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fluentIcons:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="18"/>
                            <TextBlock Text="{x:Bind ViewModel.RemoveButtonText, Mode=OneWay}"/>
                        </StackPanel>
                    </ToggleButton>
                </toolkit:WrapPanel>
            </Grid>

            <Border Grid.Row="3">
                <Grid>
                    <softwareApps:LeftoverAppsControl DataContext="{x:Bind ViewModel.LeftoverAppsViewModel}"
                        Visibility="{x:Bind ViewModel.IsLeftoverTabSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- Windows Apps Content -->
                    <Grid Visibility="{x:Bind ViewModel.IsWindowsAppsTabSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Review Mode Banner for Windows Apps -->
                        <InfoBar Grid.Row="0"
                                 x:Name="WindowsAppsReviewBanner"
                                 IsOpen="{x:Bind ViewModel.IsInReviewMode, Mode=OneWay}"
                                 Severity="Warning"
                                 IsClosable="False"
                                 Message="{x:Bind ViewModel.ReviewWindowsAppsBannerText, Mode=OneWay}"
                                 Margin="0,0,0,8"
                                 Visibility="{x:Bind ViewModel.IsInReviewMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Builder Mode Banner for Windows Apps (mutually exclusive with review banner) -->
                        <InfoBar Grid.Row="0"
                                 x:Name="WindowsAppsBuilderBanner"
                                 IsOpen="{x:Bind ViewModel.IsBuilderModeActive, Mode=OneWay}"
                                 Severity="Warning"
                                 IsClosable="False"
                                 Message="{x:Bind ViewModel.BuilderWindowsAppsBannerText, Mode=OneWay}"
                                 Margin="0,0,0,8"
                                 Visibility="{x:Bind ViewModel.IsBuilderModeActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Inventory views are hidden while this tab is discovering apps. -->
                        <Grid Grid.Row="1"
                              Visibility="{x:Bind ViewModel.WindowsAppsViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <!-- DataGrid View -->
                        <controls:DataGrid x:Name="WindowsAppsDataGrid"
                                           Style="{StaticResource AppTableStyle}"
                                           Visibility="{x:Bind ViewModel.IsTableView, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           ItemsSource="{x:Bind ViewModel.WindowsAppsViewModel.ItemsView, Mode=OneWay}"
                                           AutoGenerateColumns="False"
                                           CanUserSortColumns="True"
                                           CanUserReorderColumns="False"
                                           CanUserResizeColumns="True"
                                           GridLinesVisibility="None"
                                           HeadersVisibility="Column"
                                           SelectionMode="Extended"
                                           IsReadOnly="True"
                                           HorizontalScrollBarVisibility="Disabled"
                                           Background="Transparent"
                                           RowBackground="Transparent"
                                           AlternatingRowBackground="Transparent"
                                           BorderThickness="0"
                                           ColumnHeaderStyle="{StaticResource ColumnHeaderStyle}"
                                           RowStyle="{StaticResource SelectionRowStyle}"
                                           Sorting="DataGrid_Sorting">
                            <controls:DataGrid.Columns>
                                <!-- Selection Column -->
                                <controls:DataGridTemplateColumn Width="40" CanUserResize="False" IsReadOnly="False"
                                                                  HeaderStyle="{StaticResource SelectionColumnHeaderStyle}">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      AutomationProperties.Name="{Binding Name}"
                                                      MinWidth="20"
                                                      HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                    <controls:DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      AutomationProperties.Name="{Binding Name}"
                                                      MinWidth="20"
                                                      HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellEditingTemplate>
                                </controls:DataGridTemplateColumn>

                                <!-- Name Column -->
                                <controls:DataGridTemplateColumn Header="Name" Width="*" Tag="Name">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTableNameSpacing}" VerticalAlignment="Center">
                                                <!-- Icon size driven by DataGridIconSize / DataGridFallbackFontSize resources at the top of the page. -->
                                                <Grid Width="{StaticResource DataGridIconSize}" Height="{StaticResource DataGridIconSize}"
                                                      VerticalAlignment="Center" Margin="-4,0,0,0">
                                                    <Image Source="{Binding IconSource}"
                                                           Width="{StaticResource DataGridIconSize}" Height="{StaticResource DataGridIconSize}"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
