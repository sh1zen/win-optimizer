                        <!-- Inventory views are hidden while this tab is discovering apps. -->
                        <Grid Grid.Row="1"
                              Visibility="{x:Bind ViewModel.ExternalAppsViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <!-- DataGrid View -->
                        <controls:DataGrid x:Name="ExternalAppsDataGrid"
                                           Style="{StaticResource AppTableStyle}"
                                           Visibility="{x:Bind ViewModel.IsTableView, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Loaded="ExternalAppsDataGrid_Loaded"
                                           ItemsSource="{x:Bind ViewModel.ExternalAppsViewModel.ItemsView, Mode=OneWay}"
                                           AutoGenerateColumns="False"
                                           CanUserSortColumns="True"
                                           CanUserReorderColumns="False"
                                           CanUserResizeColumns="True"
                                           GridLinesVisibility="None"
                                           HeadersVisibility="Column"
                                           SelectionMode="Extended"
                                           IsReadOnly="True"
                                           HorizontalScrollBarVisibility="Disabled"
                                           Background="Transparent"
                                           RowBackground="Transparent"
                                           AlternatingRowBackground="Transparent"
                                           BorderThickness="0"
                                           ColumnHeaderStyle="{StaticResource ColumnHeaderStyle}"
                                           RowStyle="{StaticResource SelectionRowStyle}"
                                           Sorting="DataGrid_Sorting">
                            <controls:DataGrid.Columns>
                                <!-- Selection Column with Select All header -->
                                <controls:DataGridTemplateColumn Width="40" CanUserResize="False" IsReadOnly="False"
                                                                  HeaderStyle="{StaticResource SelectAllColumnHeaderStyle}">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      AutomationProperties.Name="{Binding Name}"
                                                      MinWidth="20"
                                                      HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                    <controls:DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      AutomationProperties.Name="{Binding Name}"
                                                      MinWidth="20"
                                                      HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellEditingTemplate>
                                </controls:DataGridTemplateColumn>

                                <!-- Name Column -->
                                <controls:DataGridTemplateColumn Header="Name" Width="*" Tag="Name">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTableNameSpacing}" VerticalAlignment="Center">
                                                <!-- Icon size driven by DataGridIconSize / DataGridFallbackFontSize resources at the top of the page. -->
                                                <Grid Width="{StaticResource DataGridIconSize}" Height="{StaticResource DataGridIconSize}"
                                                      VerticalAlignment="Center" Margin="-4,0,0,0">
                                                    <Image Source="{Binding IconSource}"
                                                           Width="{StaticResource DataGridIconSize}" Height="{StaticResource DataGridIconSize}"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <fluentIcons:FluentIcon Icon="Apps" IconVariant="Color"
                                                                            FontSize="{StaticResource DataGridAppsIconSize}"
                                                                            Visibility="{Binding IsAppXFallback, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                <winOptimizerControls:WebsiteLinkButton Url="{Binding WebsiteUrl}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>

                                <!-- Description Column -->
                                <controls:DataGridTemplateColumn Header="Description" Width="2*" Tag="Description">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description}" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>

                                <!-- Installation and usage metadata -->
                                <controls:DataGridTemplateColumn Header="Last usage time" Width="170" Tag="LastUsageTime"
                                                                  CellTemplate="{StaticResource AppLastUsageCellTemplate}"/>
                                <controls:DataGridTemplateColumn Header="Installation date" Width="150" Tag="InstallationDate"
                                                                  CellTemplate="{StaticResource AppInstallationDateCellTemplate}"/>
                                <controls:DataGridTemplateColumn Header="Size" Width="110" Tag="SizeBytes"
                                                                  HeaderStyle="{StaticResource LastColumnHeaderStyle}"
                                                                  CellTemplate="{StaticResource AppSizeCellTemplate}"/>
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>

                        <!-- Card View for External Apps -->
                        <ScrollViewer x:Name="ExternalAppsCardScrollViewer"
                                      Visibility="{x:Bind ViewModel.IsCardView, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalContentAlignment="Stretch"
                                      Padding="{StaticResource ScrollContentBottomPadding}">
                            <StackPanel Spacing="20"
                                        Padding="0,0,0,8"
                                        HorizontalAlignment="Stretch">
                                <!-- Selection Checkboxes -->
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox Content="{x:Bind ViewModel.ExternalAppsViewModel.SelectAllLabel, Mode=OneWay}" MinWidth="0"
                                              IsChecked="{x:Bind ViewModel.ExternalAppsViewModel.IsAllSelected, Mode=OneWay}"
                                              Command="{x:Bind ViewModel.ExternalAppsViewModel.ToggleSelectAllCommand}"/>
                                </StackPanel>

                                <!-- Categories with apps inside. Both levels switched to
                                     non-virtualising ItemsControl with a UniformWrapPanel for the
                                     inner cards — same scroll-cycle reason as Windows Apps above. -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ExternalAppsViewModel.Categories, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="8" Margin="0,0,0,12">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                                           FontWeight="SemiBold"/>
                                                <ItemsControl ItemsSource="{Binding Apps}"
                                                              ItemTemplate="{StaticResource AppCardTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <winOptimizerControls:UniformWrapPanel
                                                                ItemWidth="{StaticResource CardItemWidth}"
                                                                ItemHeight="{StaticResource CardCellHeight}"
                                                                StretchItems="True"
                                                                MaxColumns="3"
                                                                ColumnSpacing="{StaticResource CardColumnSpacing}"
                                                                RowSpacing="{StaticResource CardRowSpacing}"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Compact View for External Apps -->
                        <ScrollViewer x:Name="ExternalAppsCompactScrollViewer"
                                      Visibility="{x:Bind ViewModel.IsCompactView, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="{StaticResource ScrollContentBottomPadding}"
                                      SizeChanged="ExternalAppsCompactScrollViewer_SizeChanged">
                            <!-- Centred + MaxWidth-clamped in code-behind (UpdateCompactContentMaxWidth)
                                 so the Select-all checkboxes and the category Expanders share one
                                 centred column — same Microsoft Store pattern as the card view. -->
                            <StackPanel x:Name="ExternalAppsCompactContentStack"
                                        Spacing="12" Padding="0,8,0,8"
                                        HorizontalAlignment="Center">
                                <!-- Selection Checkboxes -->
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox Content="{x:Bind ViewModel.ExternalAppsViewModel.SelectAllLabel, Mode=OneWay}" MinWidth="0"
                                              IsChecked="{x:Bind ViewModel.ExternalAppsViewModel.IsAllSelected, Mode=OneWay}"
                                              Command="{x:Bind ViewModel.ExternalAppsViewModel.ToggleSelectAllCommand}"/>
                                </StackPanel>

                                <!-- Categories -->
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ExternalAppsViewModel.Categories, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                     AutomationProperties.Name="{Binding DisplayName}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="16"/>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="SemiBold" FontSize="14"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <Expander.Content>
                                                    <ItemsControl ItemsSource="{Binding Apps}" Margin="0,4,0,4">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <winOptimizerControls:UniformWrapPanel ItemWidth="{StaticResource CompactItemWidth}" ColumnSpacing="8" RowSpacing="2"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" MinWidth="0" Padding="4,3" FontSize="16"
                                                                         AutomationProperties.Name="{Binding Name}">
                                                                    <!-- Auto-sized Grid + MaxWidth-bound name TextBlock — see the
                                                                         matching comment on the Windows Apps compact template
                                                                         above (issue #668 iter3). -->
                                                                    <Grid Margin="0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,1,0,0">
                                                                            <Viewbox Width="20" Height="20" VerticalAlignment="Center"
                                                                                     Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                     ToolTipService.ToolTip="{Binding InstalledStatusTooltip}">
                                                                                <fluentIcons:FluentIcon Icon="CheckmarkCircle" IconVariant="Color" />
                                                                            </Viewbox>
                                                                            <Viewbox Width="20" Height="20" VerticalAlignment="Center"
                                                                                     Visibility="{Binding IsInstalled, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                                                     ToolTipService.ToolTip="{Binding InstalledStatusTooltip}">
                                                                                <fluentIcons:FluentIcon Icon="DismissCircle" IconVariant="Color" />
                                                                            </Viewbox>
                                                                            <!-- Icon size driven by CompactIconSize / CompactFallbackFontSize resources at the top of the page. -->
                                                                            <Grid Width="{StaticResource CompactIconSize}" Height="{StaticResource CompactIconSize}" Margin="0,2,0,0" ToolTipService.ToolTip="{Binding DescriptionTooltip}"
                                                                                  VerticalAlignment="Center">
                                                                                <Image Source="{Binding IconSource}"
                                                                                       Width="{StaticResource CompactIconSize}" Height="{StaticResource CompactIconSize}"
                                                                                       Stretch="Uniform"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                <fluentIcons:FluentIcon Icon="Apps" IconVariant="Color"
                                                                                                        FontSize="{StaticResource CompactAppsIconSize}"
                                                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                        Visibility="{Binding IsAppXFallback, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Name}"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   FontSize="16"
                                                                                   Margin="6,0,0,0"
                                                                                   MaxWidth="{StaticResource CompactNameMaxWidth}" ToolTipService.ToolTip="{Binding DescriptionTooltip}"/>
                                                                        <winOptimizerControls:WebsiteLinkButton Grid.Column="2"
                                                                                                            Margin="6,0,0,0"
                                                                                                            Url="{Binding WebsiteUrl}"/>
                                                                    </Grid>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander.Content>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </ScrollViewer>

                        </Grid>

                        <!-- Loading overlay for External Apps -->
                        <Grid Grid.Row="1"
                              Visibility="{x:Bind ViewModel.ExternalAppsViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                <ProgressRing IsActive="True" Width="48" Height="48"/>
                                <TextBlock Text="{x:Bind ViewModel.ExternalAppsViewModel.StatusText, Mode=OneWay}"
                                           Style="{StaticResource BodyTextBlockStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
