<UserControl
    x:Class="WinOptimizer.UI.Features.SoftwareApps.LeftoverAppsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinOptimizer.UI.Features.SoftwareApps.ViewModels">
    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasNotices, Converter={StaticResource BooleanToVisibilityConverter}}">
                <InfoBar IsOpen="{Binding HasNotices}" IsClosable="False" Severity="Warning" Message="{Binding NoticesText}"/>
            </ScrollViewer>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox Content="{Binding SelectAllText}" IsChecked="{Binding IsAllSelected, Mode=OneWay}"
                      Command="{Binding ToggleSelectAllCommand}" IsEnabled="{Binding CanSelect}"/>
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="SelectionSummary" Grid.Column="2" Text="{Binding SelectionText}" TextWrapping="Wrap"
                       Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </Grid>
        <ListView Grid.Row="2" ItemsSource="{Binding ItemsView}" SelectionMode="None" IsEnabled="{Binding CanSelect}"
                  HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LeftoverItemViewModel">
                    <Border Padding="8,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox MinWidth="0" Padding="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanRemove}"
                                      AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Reason}"/>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Kind}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}"/>
                                </Grid>
                                <TextBlock Text="{x:Bind Location}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="2" Text="{Binding EmptyText}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressRing IsActive="{Binding IsBusy}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
