<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="WinOptimizer.UI.Features.Drivers.DriverSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinOptimizer.UI.Features.Drivers.ViewModels" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <StackPanel Spacing="12">
        <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="12">
                <ToggleSwitch Header="{x:Bind ViewModel.WhqlLabel, Mode=OneWay}" IsOn="{x:Bind ViewModel.OnlyWhqlUpdates, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"/>
                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind ViewModel.ChannelsLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                <toolkit:WrapPanel Orientation="Horizontal" HorizontalSpacing="16">
                    <CheckBox Content="Game Ready" IsChecked="{x:Bind ViewModel.GameReady, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"/>
                    <CheckBox Content="Studio" IsChecked="{x:Bind ViewModel.Studio, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"/>
                </toolkit:WrapPanel>
                <TextBlock Text="{x:Bind ViewModel.SourcesLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{x:Bind ViewModel.SourceChoices}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><toolkit:WrapPanel Orientation="Horizontal" HorizontalSpacing="16"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DriverSourcePreference">
                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind Enabled, Mode=TwoWay}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
