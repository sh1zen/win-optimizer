<UserControl x:Class="WinOptimizer.UI.Features.Drivers.DriverResultsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:FluentIcons.WinUI" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:drivers="using:WinOptimizer.UI.Features.Drivers"
    xmlns:popups="using:WinOptimizer.UI.Features.Common.Helpers">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Features/Drivers/DriverPageBrushes.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="ResultCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxLines" Value="1"/>
        </Style>
        <Style x:Key="ResultColumn" TargetType="TextBlock" BasedOn="{StaticResource ResultCell}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="ResultCheck" TargetType="CheckBox">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowDetailsButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>
        <Style x:Key="RowCellHeading" TargetType="TextBlock" BasedOn="{StaticResource ResultCell}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <DataTemplate x:Key="CategoryTabContent">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <fluent:FluentIcon Icon="{Binding Icon}" IconVariant="Regular" FontSize="17" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Grid.Column="2" CornerRadius="12" Padding="8,3" MinWidth="30" Background="{ThemeResource ControlFillColorDefaultBrush}">
                    <TextBlock Text="{Binding CountLabel}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>
        <Style x:Key="CategoryTabItem" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="TabRoot" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"><VisualState.Setters>
                                        <Setter Target="TabRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                    </VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters>
                                        <Setter Target="TabRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                    </VisualState.Setters></VisualState>
                                    <VisualState x:Name="Selected"><VisualState.Setters>
                                        <Setter Target="TabIndicator.Opacity" Value="1"/>
                                    </VisualState.Setters></VisualState>
                                    <VisualState x:Name="PointerOverSelected"><VisualState.Setters>
                                        <Setter Target="TabIndicator.Opacity" Value="1"/>
                                        <Setter Target="TabRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                    </VisualState.Setters></VisualState>
                                    <VisualState x:Name="PressedSelected"><VisualState.Setters>
                                        <Setter Target="TabIndicator.Opacity" Value="1"/>
                                        <Setter Target="TabRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                    </VisualState.Setters></VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="DisabledStates">
                                    <VisualState x:Name="Enabled"/>
                                    <VisualState x:Name="Disabled"><VisualState.Setters>
                                        <Setter Target="TabRoot.Opacity" Value="0.55"/>
                                    </VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="16,0" VerticalAlignment="Center"/>
                            <Border x:Name="TabIndicator" Background="{ThemeResource DriverScanAccentBrush}" Height="4" CornerRadius="2"
                                    Margin="12,0" VerticalAlignment="Bottom" Opacity="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="RowActionsTemplate">
            <toolkit:WrapPanel Orientation="Horizontal" HorizontalSpacing="10" VerticalSpacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            Visibility="{Binding HasSources, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <fluent:FluentIcon Icon="Layer" IconVariant="Regular" FontSize="15"/>
                    <TextBlock Text="{Binding SourceNames}" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="260"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button Style="{StaticResource SubtleButtonStyle}" Padding="3,2" MinHeight="24" Command="{Binding OpenSupportCommand}"
                        Visibility="{Binding HasSupport, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <fluent:FluentIcon Icon="Open" IconVariant="Regular" FontSize="14" Foreground="{ThemeResource DriverScanAccentBrush}"/>
                        <TextBlock Text="{Binding SupportLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource DriverScanAccentBrush}"/>
                    </StackPanel>
                </Button>
            </toolkit:WrapPanel>
        </DataTemplate>
        <DataTemplate x:Key="InventoryRowTemplate">
            <Border Padding="20,0,14,0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource ResultCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanClean}"
                              Visibility="{Binding ShowSelection, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="{Binding Name}"/>
                    <CheckBox Style="{StaticResource ResultCheck}" IsChecked="{Binding IsDownloadSelected, Mode=TwoWay}"
                              Visibility="{Binding CanDownload, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="{Binding Name}"/>
                    <StackPanel Grid.Column="1">
                        <Button Style="{StaticResource RowDetailsButton}" Command="{Binding ShowDetailsCommand}" AutomationProperties.Name="{Binding Name}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="96"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <fluent:FluentIcon Icon="{Binding RowIcon}" IconVariant="Regular" FontSize="17" Width="24" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding HasDeviceIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowCellHeading}"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding HasSubtitle, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding Date}" Style="{StaticResource ResultCell}"
                                           Visibility="{Binding HasInventoryColumns, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource ResultCell}"
                                           Visibility="{Binding HasInventoryColumns, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <fluent:FluentIcon Grid.Column="3" Icon="ChevronRight" IconVariant="Regular" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <ContentControl IsTabStop="False" Content="{Binding}" ContentTemplate="{StaticResource RowActionsTemplate}" Margin="0,0,0,4"
                                        Visibility="{Binding HasSupport, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CandidateRowTemplate">
            <Border Padding="20,6,14,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource ResultCheck}" IsChecked="{Binding IsDownloadSelected, Mode=TwoWay}"
                              Visibility="{Binding CanDownload, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="{Binding DisplayName}"/>
                    <StackPanel Grid.Column="1">
                        <Button Style="{StaticResource RowDetailsButton}" Command="{Binding ShowDetailsCommand}" AutomationProperties.Name="{Binding DisplayName}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="146"/><ColumnDefinition Width="100"/><ColumnDefinition Width="96"/><ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource RowCellHeading}"/>
                                    <TextBlock Text="{Binding CandidateSubtitle}" Style="{StaticResource ResultCell}" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}" Style="{StaticResource ResultCell}">
                                    <ToolTipService.ToolTip><TextBlock Text="{Binding InstalledVersion}"/></ToolTipService.ToolTip>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding CandidateVersion}" Style="{StaticResource ResultCell}">
                                    <ToolTipService.ToolTip><TextBlock Text="{Binding CandidateVersion}"/></ToolTipService.ToolTip>
                                </TextBlock>
                                <StackPanel Grid.Column="3" Spacing="3">
                                    <Border HorizontalAlignment="Left" CornerRadius="7" Padding="9,4" Background="{ThemeResource DriverScanIconBackgroundBrush}"
                                            Visibility="{Binding IsNewer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding VersionStatus}" Style="{StaticResource ResultCell}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource DriverScanAccentBrush}"/>
                                    </Border>
                                    <Border HorizontalAlignment="Left" CornerRadius="7" Padding="9,4" Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            Visibility="{Binding IsNewer, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding VersionStatus}" Style="{StaticResource ResultCell}" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="{Binding CertificationLabel}" Style="{StaticResource ResultCell}" Margin="2,0" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding Date}" Style="{StaticResource ResultCell}"/>
                                <TextBlock Grid.Column="5" Text="{Binding Size}" Style="{StaticResource ResultCell}"/>
                                <fluent:FluentIcon Grid.Column="6" Icon="ChevronRight" IconVariant="Regular" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <ContentControl IsTabStop="False" Content="{Binding}" ContentTemplate="{StaticResource RowActionsTemplate}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="ResultsLayout" RowSpacing="{StaticResource PageCardSpacing}" SizeChanged="ResultsLayout_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource DriverScanStrokeBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" AutomationProperties.Name="{x:Bind ViewModel.Summary, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DriverScanStrokeBrush}">
                    <Grid>
                        <ListView x:Name="CategoryTabs" ItemsSource="{x:Bind ViewModel.ResultGroups}" SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource CategoryTabContent}" ItemContainerStyle="{StaticResource CategoryTabItem}"
                                  SelectionMode="Single" Visibility="Collapsed" Background="Transparent" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind ViewModel.ResultsLabel, Mode=OneWay}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                        </ListView>
                        <ComboBox x:Name="CategoryPicker" ItemsSource="{x:Bind ViewModel.ResultGroups}" SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource CategoryTabContent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Margin="12,8" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.ResultsLabel, Mode=OneWay}"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" x:Name="CategoryHeading" Padding="18,12" ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.SelectedGroup.Title, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Text="{x:Bind ViewModel.CategorySummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Grid x:Name="CategoryTools" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                        <Grid Width="244" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.HasDeviceSearch, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBox x:Name="DriverDeviceSearch" PlaceholderText="{x:Bind ViewModel.DeviceSearchLabel, Mode=OneWay}"
                                     AutomationProperties.Name="{x:Bind ViewModel.DeviceSearchLabel, Mode=OneWay}" Padding="32,5,8,5"
                                     Text="{x:Bind ViewModel.DeviceQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"/>
                            <fluent:FluentIcon Icon="Search" IconVariant="Regular" FontSize="15" Margin="10,0" VerticalAlignment="Center"
                                               HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <toolkit:WrapPanel Orientation="Horizontal" HorizontalSpacing="12" VerticalSpacing="6"
                                           Visibility="{x:Bind ViewModel.IsCandidateCategory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Padding="10,5" BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" CornerRadius="8"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <fluent:FluentIcon Icon="ShieldCheckmark" IconVariant="Regular" FontSize="17" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.ReportFilterLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="FilterSettingsButton" Style="{StaticResource SubtleButtonStyle}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                    popups:PopupHandler.Placement="BottomEdgeAlignedRight"
                                    AutomationProperties.Name="{x:Bind ViewModel.FilterSettingsLabel, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <fluent:FluentIcon Icon="Settings" IconVariant="Regular" FontSize="17" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.FilterSettingsLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <popups:PopupHandler.Content>
                                    <ScrollViewer MaxHeight="430" MaxWidth="430" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <drivers:DriverSettingsControl ViewModel="{x:Bind ViewModel.Settings}"/>
                                    </ScrollViewer>
                                </popups:PopupHandler.Content>
                            </Button>
                        </toolkit:WrapPanel>
                    </Grid>
                </Grid>
                <Border Grid.Row="2" Padding="20,5,14,5" BorderThickness="0,1,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <CheckBox x:Name="VisibleSelectionCheck" Style="{StaticResource ResultCheck}" IsChecked="{x:Bind ViewModel.VisibleSelection, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.SelectAllLabel, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HasVisibleSelection, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Grid x:Name="InventoryColumns" Grid.Column="1" ColumnSpacing="8" MinHeight="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="96"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="InventoryNameColumn" Style="{StaticResource ResultColumn}"/>
                            <TextBlock x:Name="InventoryDateColumn" Grid.Column="1" Style="{StaticResource ResultColumn}"/>
                            <TextBlock x:Name="InventorySizeColumn" Grid.Column="2" Style="{StaticResource ResultColumn}"/>
                        </Grid>
                        <Grid x:Name="CandidateColumns" Grid.Column="1" ColumnSpacing="8" MinHeight="24" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="146"/><ColumnDefinition Width="100"/><ColumnDefinition Width="96"/><ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.DriverLabel, Mode=OneWay}" Style="{StaticResource ResultColumn}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.InstalledLabel, Mode=OneWay}" Style="{StaticResource ResultColumn}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CandidateLabel, Mode=OneWay}" Style="{StaticResource ResultColumn}"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.CandidateStatusLabel, Mode=OneWay}" Style="{StaticResource ResultColumn}"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.ReleasedLabel, Mode=OneWay}" Style="{StaticResource ResultColumn}"/>
                            <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.SizeLabel, Mode=OneWay}" Style="{StaticResource ResultColumn}"/>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Grid.Row="3">
                    <ListView x:Name="DriverRows" ItemsSource="{x:Bind ViewModel.VisibleRows, Mode=OneWay}" ItemTemplate="{StaticResource InventoryRowTemplate}"
                              SelectionMode="None" Background="Transparent" HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="32"/>
                        </Style></ListView.ItemContainerStyle>
                    </ListView>
                    <ScrollViewer Padding="{StaticResource ScrollContentPadding}" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{x:Bind ViewModel.HasEmptyCategory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="8" Padding="24,22" MaxWidth="480" HorizontalAlignment="Center">
                            <fluent:FluentIcon Icon="Info" IconVariant="Regular" FontSize="26" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.CategoryEmptyTitle, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.CategoryEmptyDescription, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Border Grid.Row="4" Padding="18,8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.HasDeviceSearch, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind ViewModel.DeviceResultCount, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" CornerRadius="12" Padding="18,11" BorderThickness="1" BorderBrush="{ThemeResource DriverScanStrokeBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.ShowSelectionFooter, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid x:Name="SelectionLayout" ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.ShowRemovalAction, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{x:Bind ViewModel.DownloadSelectionSummary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.ShowDownloadAction, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectionHint, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.TestModeHint, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               Visibility="{x:Bind ViewModel.HasTestModeHint, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <toolkit:WrapPanel x:Name="SelectionActions" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalSpacing="8" VerticalSpacing="6">
                    <Button Command="{x:Bind ViewModel.DownloadCommand}" Padding="13,8"
                            Visibility="{x:Bind ViewModel.ShowDownloadAction, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{x:Bind ViewModel.DownloadLabel, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fluent:FluentIcon Icon="ArrowDownload" IconVariant="Regular" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.DownloadLabel, Mode=OneWay}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.UninstallCommand}" Padding="13,8"
                            Visibility="{x:Bind ViewModel.ShowRemovalAction, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{x:Bind ViewModel.UninstallLabel, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fluent:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.UninstallLabel, Mode=OneWay}"/>
                        </StackPanel>
                    </Button>
                </toolkit:WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
