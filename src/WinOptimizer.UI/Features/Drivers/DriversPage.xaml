<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:popups="using:WinOptimizer.UI.Features.Common.Helpers" xmlns:fluent="using:FluentIcons.WinUI" xmlns:controls="using:WinOptimizer.UI.Features.Common.Controls" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls" x:Class="WinOptimizer.UI.Features.Drivers.DriversPage">
    <Page.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Features/Drivers/DriverPageBrushes.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="ScanMilestoneTemplate">
            <Grid ColumnSpacing="10" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <fluent:FluentIcon Icon="{Binding Icon}" IconVariant="Regular" FontSize="24"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                   Visibility="{Binding IsCurrent, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <Grid Width="22" Height="22" VerticalAlignment="Center"
                      Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Ellipse Stroke="{ThemeResource DriverScanAccentBrush}" StrokeThickness="2"/>
                    <Ellipse Width="9" Height="9" Fill="{ThemeResource DriverScanAccentBrush}"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding IsCurrent, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"
                           Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ScanActivityTemplate">
            <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="10,8">
                <Grid ColumnSpacing="16" MinHeight="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                    <fluent:FluentIcon Icon="{Binding Icon}" IconVariant="Regular" FontSize="21" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Visibility="{Binding IsComplete, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{ThemeResource DriverScanAccentBrush}"
                               Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <fluent:FluentIcon Grid.Column="2" Icon="Checkmark" IconVariant="Regular" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding IsComplete, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ProgressRing Grid.Column="2" IsActive="{Binding IsActive}" Width="20" Height="20" Foreground="{ThemeResource DriverScanAccentBrush}"
                                  Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid x:Name="LayoutRoot" SizeChanged="LayoutRoot_SizeChanged" Style="{StaticResource PageGridStyle}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="WideLayoutTrigger"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ScanActions.(Grid.Row)" Value="0"/><Setter Target="ScanActions.(Grid.Column)" Value="1"/>
                        <Setter Target="ScanActions.(Grid.ColumnSpan)" Value="1"/><Setter Target="ScanActions.HorizontalAlignment" Value="Right"/>
                        <Setter Target="ScanActions.Margin" Value="24,0,0,0"/><Setter Target="HeaderLayout.RowSpacing" Value="0"/>
                        <Setter Target="ScanAction.(Grid.Column)" Value="1"/><Setter Target="ScanAction.(Grid.Row)" Value="0"/>
                        <Setter Target="ScanAction.Margin" Value="32,0,12,0"/><Setter Target="ScanHero.Padding" Value="32"/>
                        <Setter Target="ScanProgressCard.Padding" Value="40,32,40,22"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="CompactLayoutTrigger" IsActive="True"/></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ScrollViewer Padding="{StaticResource ScrollContentPadding}" x:Name="HeaderViewport" MaxHeight="340" VerticalAlignment="Top" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"
                      Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel Spacing="{StaticResource PageCardSpacing}">
                <Grid x:Name="HeaderLayout" RowSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <controls:PageHeader Title="{x:Bind ViewModel.Heading, Mode=OneWay}" Description="{x:Bind ViewModel.IntroDescription, Mode=OneWay}" Icon="HardDrive"/>
                    <toolkit:WrapPanel x:Name="ScanActions" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Command="{x:Bind ViewModel.ScanCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Padding="16,9" Background="{ThemeResource DriverScanAccentBrush}" Foreground="{ThemeResource DriverScanActionTextBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluent:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.ScanAgainLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </toolkit:WrapPanel>
                </Grid>
                <Border x:Name="CoverageBanner" Padding="17,10" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{ThemeResource DriverScanStrokeBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.HasLimitedCoverage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <fluent:FluentIcon Icon="Warning" IconVariant="Regular" FontSize="30" VerticalAlignment="Center"
                                               Foreground="{ThemeResource DriverScanAccentBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
                                <TextBlock Text="{x:Bind ViewModel.CoverageTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.CoverageSummary, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton x:Name="CoverageToggle" Grid.Column="2" Padding="8,5" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                          AutomationProperties.Name="{x:Bind ViewModel.CoverageDetailsLabel, Mode=OneWay}">
                                <Grid ColumnSpacing="7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CoverageToggleLabel" Text="{x:Bind ViewModel.CoverageDetailsLabel, Mode=OneWay}" TextWrapping="Wrap"
                                               MaxWidth="160" VerticalAlignment="Center"/>
                                    <fluent:FluentIcon Grid.Column="1" Icon="ChevronDown" IconVariant="Regular" FontSize="14" VerticalAlignment="Center"
                                                       Visibility="{x:Bind CoverageToggle.IsChecked, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    <fluent:FluentIcon Grid.Column="1" Icon="ChevronUp" IconVariant="Regular" FontSize="14" VerticalAlignment="Center"
                                                       Visibility="{x:Bind CoverageToggle.IsChecked, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </ToggleButton>
                        </Grid>
                        <Border x:Name="CoverageDetailsPanel" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Visibility="{x:Bind CoverageToggle.IsChecked, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer MaxHeight="134" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{x:Bind ViewModel.CoverageDetails, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
                <Border x:Name="StatusPanel" Padding="16,12" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource PageCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <fluent:FluentIcon Icon="Info" IconVariant="Regular" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"/>
                    </Grid>
                </Border>
                <TextBlock Text="{x:Bind ViewModel.RescanHint, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind ViewModel.HasRescanHint, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Border x:Name="NoticesPanel" Padding="16,12" Visibility="{x:Bind ViewModel.ShowStandaloneNotices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource PageCardStyle}">
                    <ScrollViewer Padding="{StaticResource ScrollContentPadding}" MaxHeight="140" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{x:Bind ViewModel.Notices, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1">
            <Border x:Name="ResultsPanel" Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ScrollViewer Padding="{StaticResource ScrollContentPadding}" x:Name="EmptyState" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="{StaticResource PageCardSpacing}" Padding="0,0,0,8">
                    <!-- Keep the scan guidance and its action together at every page width. -->
                    <Border x:Name="ScanHero" Style="{StaticResource ScanHeroStyle}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Spacing="16" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.ScanLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                                    <TextBlock Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}" MaxWidth="600" HorizontalAlignment="Left" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Button x:Name="ScanInformation" HorizontalAlignment="Left" Padding="12,8" AutomationProperties.Name="{x:Bind ViewModel.InformationLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowScanInformation, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <fluent:FluentIcon Icon="Info" IconVariant="Regular" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.InformationLabel, Mode=OneWay}"/>
                                    </StackPanel>
                                    <popups:PopupHandler.Content><StackPanel Spacing="12" MaxWidth="440">
                                        <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind ViewModel.FilterSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel></popups:PopupHandler.Content>
                                </Button>
                            </StackPanel>
                            <ContentControl x:Name="ScanAction" Grid.Row="1" Margin="0,24,0,0" Style="{StaticResource ScanActionStyle}">
                                <Button x:Name="ScanButton" Content="{x:Bind ViewModel.ScanLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ScanCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                    Style="{StaticResource ScanActionButtonStyle}" AutomationProperties.Name="{x:Bind ViewModel.ScanLabel, Mode=OneWay}"/>
                            </ContentControl>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind ViewModel.ResultsLabel, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                        <controls:UniformWrapPanel x:Name="ScanCategories" ItemWidth="300" ItemHeight="108" ColumnSpacing="{StaticResource PageCardSpacing}" RowSpacing="{StaticResource PageCardSpacing}" StretchItems="True" MaxColumns="3">
                            <Border Style="{StaticResource PageCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource PageIconBackgroundBrush}" VerticalAlignment="Center">
                                        <fluent:FluentIcon Icon="HardDrive" IconVariant="Regular" FontSize="24" Foreground="{ThemeResource PageIconForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.UnusedPackagesLabel, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource PageCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource PageIconBackgroundBrush}" VerticalAlignment="Center">
                                        <fluent:FluentIcon Icon="PlugDisconnected" IconVariant="Regular" FontSize="24" Foreground="{ThemeResource PageIconForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DisconnectedDevicesLabel, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource PageCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource PageIconBackgroundBrush}" VerticalAlignment="Center">
                                        <fluent:FluentIcon Icon="ArrowSync" IconVariant="Regular" FontSize="24" Foreground="{ThemeResource PageIconForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OfficialUpdatesLabel, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </controls:UniformWrapPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="ScanProgressViewport" Style="{StaticResource PageScrollViewerStyle}" Padding="8,0" VerticalContentAlignment="Center"
                          Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Border x:Name="ScanProgressCard" Style="{StaticResource ScanHeroStyle}" MaxWidth="846" HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" CornerRadius="12" BorderBrush="{ThemeResource DriverScanStrokeBrush}" Padding="24,28,24,20">
                        <StackPanel>
                            <Grid ColumnSpacing="24" Margin="10,0,10,24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="60" Height="60" CornerRadius="12" Background="{ThemeResource DriverScanIconBackgroundBrush}" VerticalAlignment="Top">
                                    <fluent:FluentIcon Icon="DeveloperBoard" IconVariant="Regular" FontSize="36" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{ThemeResource DriverScanAccentBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" Fill="{ThemeResource DriverScanAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ScanInProgressLabel, Mode=OneWay}" TextWrapping="Wrap"
                                                   FontSize="13" FontWeight="Bold" Foreground="{ThemeResource DriverScanAccentBrush}"/>
                                    </Grid>
                                    <TextBlock x:Name="ScanPhaseTitle" Text="{x:Bind ViewModel.ScanTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                                               AutomationProperties.HeadingLevel="Level2" AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock Text="{x:Bind ViewModel.ScanDescription, Mode=OneWay}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind ViewModel.HasScanDescription, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Height="10" Margin="10,0,10,22">
                                <Border Background="{ThemeResource DriverScanTrackBrush}" CornerRadius="5"/>
                                <ProgressBar Height="10" MinHeight="10" CornerRadius="5" Background="Transparent" Foreground="{ThemeResource DriverScanAccentBrush}"
                                             IsIndeterminate="{x:Bind ViewModel.IsScanning, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.ScanInProgressLabel, Mode=OneWay}"/>
                            </Grid>
                            <Grid ColumnSpacing="10" Padding="4,0" Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="0.4*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="0.4*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl IsTabStop="False" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource ScanMilestoneTemplate}"
                                                Content="{x:Bind ViewModel.DetectMilestone, Mode=OneWay}"/>
                                <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <ContentControl Grid.Column="2" IsTabStop="False" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource ScanMilestoneTemplate}"
                                                Content="{x:Bind ViewModel.SourcesMilestone, Mode=OneWay}"/>
                                <Border Grid.Column="3" Height="1" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <ContentControl Grid.Column="4" IsTabStop="False" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource ScanMilestoneTemplate}"
                                                Content="{x:Bind ViewModel.ResultsMilestone, Mode=OneWay}"/>
                            </Grid>

                            <Border Padding="4,14,0,8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DriverScanStrokeBrush}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.ScanActivityLabel, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"
                                               TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level3"/>
                                    <Button x:Name="ScanDetailsButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind ViewModel.ShowScanDetailsCommand}"
                                            Padding="8,5" AutomationProperties.Name="{x:Bind ViewModel.ScanDetailsLabel, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind ViewModel.ScanDetailsLabel, Mode=OneWay}" FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <fluent:FluentIcon Icon="ChevronRight" IconVariant="Regular" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="ScanActivityList" ItemsSource="{x:Bind ViewModel.ScanActivity, Mode=OneWay}" ItemTemplate="{StaticResource ScanActivityTemplate}"/>
                            <Grid ColumnSpacing="16" Margin="2,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.ScanFooterHint, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                                <Button x:Name="CancelScanButton" Grid.Column="1" Content="{x:Bind ViewModel.CancelScanLabel, Mode=OneWay}" Command="{x:Bind ViewModel.CancelScanCommand}"
                                        Padding="20,6" VerticalAlignment="Center" Background="Transparent"
                                        BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
