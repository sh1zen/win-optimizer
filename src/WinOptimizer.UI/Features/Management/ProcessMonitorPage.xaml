<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinOptimizer.UI.Features.Management.ProcessMonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinOptimizer.UI.Features.Management.ViewModels"
    xmlns:models="using:WinOptimizer.Core.Features.Management"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:common="using:WinOptimizer.UI.Features.Common.Controls">
    <Page.Resources>
        <!-- Native buttons keep keyboard focus and hover feedback on sortable column headers. -->
        <Style x:Key="ProcessColumnHeaderStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>
    <ScrollViewer Padding="{StaticResource ScrollContentPadding}" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <VisualStateManager.VisualStateGroups><VisualStateGroup>
            <VisualState x:Name="Narrow"><VisualState.Setters>
                <Setter Target="ProcessList.(Grid.ColumnSpan)" Value="2"/><Setter Target="Inspector.(Grid.Row)" Value="1"/>
                <Setter Target="Inspector.(Grid.Column)" Value="0"/><Setter Target="Inspector.(Grid.ColumnSpan)" Value="2"/>
            </VisualState.Setters></VisualState>
            <VisualState x:Name="Wide"><VisualState.Setters>
                <Setter Target="ProcessList.(Grid.ColumnSpan)" Value="1"/><Setter Target="Inspector.(Grid.Row)" Value="0"/>
                <Setter Target="Inspector.(Grid.Column)" Value="1"/><Setter Target="Inspector.(Grid.ColumnSpan)" Value="1"/>
            </VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <Grid x:Name="PageRoot" Style="{StaticResource PageGridStyle}" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <common:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneWay}" Description="{x:Bind ViewModel.Description, Mode=OneWay}" Icon="Board"/>
            <StackPanel Grid.Row="1" Spacing="10">
                <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="{x:Bind ViewModel.SearchLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.SearchLabel, Mode=OneWay}" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshCommand}"/>
                </Grid>
                <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
                    <ComboBox x:Name="SortSelector" SelectedIndex="{x:Bind ViewModel.SortMode, Mode=TwoWay}" MinWidth="180" AutomationProperties.Name="{x:Bind ViewModel.SortLabel, Mode=OneWay}">
                        <ComboBoxItem Content="{x:Bind ViewModel.TreeLabel, Mode=OneWay}"/>
                        <ComboBoxItem Content="CPU"/>
                        <ComboBoxItem Content="{x:Bind ViewModel.MemoryLabel, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind ViewModel.NameLabel, Mode=OneWay}"/>
                        <ComboBoxItem Content="PID"/>
                    </ComboBox>
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24"/>
                </controls:WrapPanel>
            </StackPanel>
            <InfoBar Grid.Row="2" IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" Message="{x:Bind ViewModel.Status, Mode=OneWay}" Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" IsClosable="False"/>
            <Grid Grid.Row="3" ColumnSpacing="14" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="11*"/><ColumnDefinition Width="9*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="ProcessList" RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="ProcessHeaders" Padding="12,0" ColumnSpacing="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="84"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <Button x:Name="NameColumnHeader" Content="{x:Bind ViewModel.NameHeader, Mode=OneWay}" Style="{StaticResource ProcessColumnHeaderStyle}" HorizontalContentAlignment="Left" Padding="28,8,0,8"
                                Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="Name" ToolTipService.ToolTip="{x:Bind ViewModel.SortHint, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind ViewModel.SortHint, Mode=OneWay}"/>
                        <Button x:Name="PidColumnHeader" Grid.Column="1" Content="{x:Bind ViewModel.PidHeader, Mode=OneWay}" Style="{StaticResource ProcessColumnHeaderStyle}"
                                Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="Pid" ToolTipService.ToolTip="{x:Bind ViewModel.SortHint, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind ViewModel.SortHint, Mode=OneWay}"/>
                        <Button x:Name="CpuColumnHeader" Grid.Column="2" Content="{x:Bind ViewModel.CpuHeader, Mode=OneWay}" Style="{StaticResource ProcessColumnHeaderStyle}"
                                Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="Cpu" ToolTipService.ToolTip="{x:Bind ViewModel.SortHint, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind ViewModel.SortHint, Mode=OneWay}"/>
                        <Button x:Name="MemoryColumnHeader" Grid.Column="3" Content="{x:Bind ViewModel.MemoryHeader, Mode=OneWay}" Style="{StaticResource ProcessColumnHeaderStyle}"
                                Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="Memory" ToolTipService.ToolTip="{x:Bind ViewModel.SortHint, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind ViewModel.SortHint, Mode=OneWay}"/>
                    </Grid>
                    <ListView x:Name="ProcessesList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=OneWay}" SelectionChanged="ProcessesList_SelectionChanged" HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" SelectionMode="Single" Padding="{StaticResource ScrollContentPadding}">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="40"/>
                        </Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate x:DataType="vm:ProcessDisplayRow">
                            <Grid x:Name="ProcessRowGrid" Padding="12,6" ColumnSpacing="8" MinHeight="40">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="84"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <Grid Margin="{x:Bind Indent, Mode=OneWay}" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Visibility="{x:Bind HasChildren, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="24" Width="24" MinHeight="24" Height="24" Click="ExpandProcess_Click" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind Expander, Mode=OneWay}" FontSize="12"/>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind SearchContent, Mode=OneWay}"/>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{x:Bind Identity.Pid}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Cpu, Mode=OneWay}" HorizontalAlignment="Right"/>
                                    <ProgressBar Value="{x:Bind CpuBar, Mode=OneWay}" Visibility="{x:Bind HasCpu, Mode=OneWay}" Maximum="100" Height="2" MinHeight="2"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{x:Bind Memory, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.EmptyLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" Margin="16" TextWrapping="Wrap" IsHitTestVisible="False"/>
                </Grid>
                <Border x:Name="Inspector" Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="14">
                    <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.SelectedState, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                        <Pivot x:Name="DetailsTabs" Grid.Row="1" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                            <PivotItem Header="{x:Bind ViewModel.DetailsLabel, Mode=OneWay}"><ScrollViewer Padding="{StaticResource ScrollContentPadding}" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="14">
                                <Button Content="{x:Bind ViewModel.RefreshDetailsLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshDetailsCommand}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedCounters, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedPath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedMetadata, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedDiagnostic, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel></ScrollViewer></PivotItem>
                            <PivotItem Header="{x:Bind ViewModel.PortsLabel, Mode=OneWay}"><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.PortsSummary, Mode=OneWay}" TextWrapping="Wrap"/>
                                <ListView Padding="{StaticResource ScrollContentPadding}" x:Name="PortsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Ports}" SelectionMode="None" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate x:DataType="vm:ProcessPortDisplay"><StackPanel Spacing="4" Padding="0,8">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                    <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                </StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                            </Grid></PivotItem>
                            <PivotItem Header="{x:Bind ViewModel.FilesLabel, Mode=OneWay}"><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.FilesHint, Mode=OneWay}" TextWrapping="Wrap"/>
                                    <CheckBox IsChecked="{x:Bind ViewModel.LicenseAccepted, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"><TextBlock Text="{x:Bind ViewModel.LicenseLabel, Mode=OneWay}" TextWrapping="Wrap"/></CheckBox>
                                    <HyperlinkButton Content="Microsoft Sysinternals · License" NavigateUri="https://learn.microsoft.com/en-us/sysinternals/license-terms" Padding="0"/>
                                    <Button Content="{x:Bind ViewModel.LoadFilesLabel, Mode=OneWay}" Command="{x:Bind ViewModel.LoadFilesCommand}"/>
                                    <TextBlock Text="{x:Bind ViewModel.FilesSummary, Mode=OneWay}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ListView Padding="{StaticResource ScrollContentPadding}" x:Name="OpenFilesList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" SelectionMode="None" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate x:DataType="models:ProcessOpenFile"><StackPanel Spacing="4" Padding="0,8">
                                    <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock Text="{x:Bind Handle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                            </Grid></PivotItem>
                            <PivotItem Header="{x:Bind ViewModel.NetworkLabel, Mode=OneWay}"><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.NetworkHint, Mode=OneWay}" TextWrapping="Wrap"/>
                                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"><Button x:Name="StartCaptureButton" Content="{x:Bind ViewModel.StartNetworkLabel, Mode=OneWay}" Command="{x:Bind ViewModel.StartNetworkCommand}"/><Button Content="{x:Bind ViewModel.StopNetworkLabel, Mode=OneWay}" Command="{x:Bind ViewModel.StopNetworkCommand}"/></controls:WrapPanel>
                                    <TextBlock Text="{x:Bind ViewModel.NetworkTotals, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind ViewModel.NetworkSummary, Mode=OneWay}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ListView Padding="{StaticResource ScrollContentPadding}" x:Name="HostTrafficList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Hosts}" SelectionMode="None" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate x:DataType="vm:ProcessIpDisplay"><StackPanel Spacing="4" Padding="0,8">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock Text="{x:Bind Totals}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                </StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                            </Grid></PivotItem>
                        </Pivot>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
