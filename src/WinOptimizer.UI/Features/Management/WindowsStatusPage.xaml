<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinOptimizer.UI.Features.Management.WindowsStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinOptimizer.UI.Features.Management"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
    xmlns:converters="using:WinOptimizer.UI.Features.Common.Converters"
    xmlns:popups="using:WinOptimizer.UI.Features.Common.Helpers"
    xmlns:fluent="using:FluentIcons.WinUI">
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="ReportVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="OverviewVisibilityConverter"/>
        <Style x:Key="ServicingCardIconStyle" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
            <Setter Property="Background" Value="{ThemeResource PageIconBackgroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ServicingCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ServicingTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="ServicingCardDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        </Style>
    </Page.Resources>
    <Grid SizeChanged="LayoutRoot_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="WideLayoutTrigger"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ScanAction.(Grid.Column)" Value="1"/>
                        <Setter Target="ScanAction.(Grid.Row)" Value="0"/>
                        <Setter Target="ScanAction.Margin" Value="32,0,12,0"/>
                        <Setter Target="ScanHero.Padding" Value="32"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="CompactLayoutTrigger" IsActive="True"/></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState x:Name="SideBySideCards">
                    <VisualState.StateTriggers><StateTrigger x:Name="SideBySideCardsTrigger"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ServicingCards.RowSpacing" Value="0"/>
                        <Setter Target="RepairCard.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="CleanupCard.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="CleanupCard.(Grid.Column)" Value="1"/>
                        <Setter Target="CleanupCard.(Grid.Row)" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StackedCards">
                    <VisualState.StateTriggers><StateTrigger x:Name="StackedCardsTrigger" IsActive="True"/></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
            <StackPanel Style="{StaticResource PageStackStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <common:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneWay}" Description="{x:Bind ViewModel.Description, Mode=OneWay}" Icon="ShieldCheckmark"/>
                    <Button x:Name="GuidanceButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}"
                            Width="36" Height="36" Padding="0" VerticalAlignment="Top"
                            AutomationProperties.Name="{x:Bind ViewModel.MaintenanceLabel, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.MaintenanceLabel, Mode=OneWay}"
                            popups:PopupHandler.PreferredWidth="480">
                        <popups:PopupHandler.Content>
                            <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind ViewModel.MaintenanceLabel, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                               TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                                    <TextBlock Style="{StaticResource ServicingTextStyle}" Text="{x:Bind ViewModel.Hint, Mode=OneWay}"/>
                                    <Border Style="{StaticResource ServicingCardDividerStyle}"/>
                                    <TextBlock Style="{StaticResource ServicingTextStyle}" Text="{x:Bind ViewModel.LogsHint, Mode=OneWay}" IsTextSelectionEnabled="True"/>
                                    <HyperlinkButton Padding="0,6" NavigateUri="https://learn.microsoft.com/en-us/windows-hardware/manufacture/desktop/repair-a-windows-image">
                                        <TextBlock Text="{x:Bind ViewModel.DocsLabel, Mode=OneWay}" TextWrapping="Wrap"/>
                                    </HyperlinkButton>
                                </StackPanel>
                            </ScrollViewer>
                        </popups:PopupHandler.Content>
                        <fluent:FluentIcon Icon="Info" IconVariant="Regular" FontSize="20"/>
                    </Button>
                </Grid>

                <!-- The primary action follows the same responsive presentation as Cleaner scans. -->
                <Border x:Name="ScanHero" Style="{StaticResource ScanHeroStyle}"
                        Visibility="{x:Bind ViewModel.IsOperationRunning, Mode=OneWay, Converter={StaticResource OverviewVisibilityConverter}}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Spacing="16" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ScanStep, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.IntroTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.IntroDescription, Mode=OneWay}" MaxWidth="600" HorizontalAlignment="Left" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Left" Content="{x:Bind ViewModel.AnalyzeLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RunCommand}" CommandParameter="AnalyzeStore"/>
                        </StackPanel>
                        <StackPanel x:Name="ScanAction" Grid.Row="1" Orientation="Horizontal" Spacing="12"
                                    Margin="0,24,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ToggleSwitch x:Name="QuickCheckSwitch" MinWidth="0" MaxWidth="112" VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsOn="{x:Bind ViewModel.UseQuickCheck, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                          AutomationProperties.Name="{x:Bind ViewModel.QuickCheckLabel, Mode=OneWay}">
                                <ToggleSwitch.Header>
                                    <TextBlock Text="{x:Bind ViewModel.QuickCheckLabel, Mode=OneWay}" TextWrapping="Wrap"/>
                                </ToggleSwitch.Header>
                            </ToggleSwitch>
                            <Grid Width="172" Height="172">
                                <Ellipse Fill="{ThemeResource AccentFillColorTertiaryBrush}" Opacity="0.35"/>
                                <Ellipse Margin="7" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" Opacity="0.35"/>
                                <Button x:Name="PrimaryActionButton" Command="{x:Bind ViewModel.RunCommand}" CommandParameter="{x:Bind ViewModel.DiagnosisAction, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Width="136" Height="136" CornerRadius="68" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind ViewModel.DiagnosisLabel, Mode=OneWay}">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                                        <fluent:FluentIcon Icon="ShieldCheckmark" IconVariant="Regular" FontSize="30" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.DiagnosisLabel, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <local:WindowsStatusProgressView x:Name="OperationProgress" ViewModel="{x:Bind ViewModel}"
                        Visibility="{x:Bind ViewModel.IsOperationRunning, Mode=OneWay, Converter={StaticResource ReportVisibilityConverter}}"/>

                <InfoBar IsOpen="{x:Bind ViewModel.ShowModeNotice, Mode=OneWay}" Message="{x:Bind ViewModel.ModeNotice, Mode=OneWay}" IsClosable="False" Visibility="{x:Bind ViewModel.ShowModeNotice, Mode=OneWay, Converter={StaticResource ReportVisibilityConverter}}"/>
                <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" Message="{x:Bind ViewModel.Status, Mode=OneWay}" Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" IsClosable="False" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource ReportVisibilityConverter}}"/>

                <common:NavigationCard x:Name="ReviewReport" Title="{x:Bind ViewModel.ResultsLabel, Mode=OneWay}"
                        Description="{x:Bind ViewModel.ReportActionLabel, Mode=OneWay}" Click="ReviewReport_Click"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource ReportVisibilityConverter}}">
                    <common:NavigationCard.Icon><fluent:FluentIcon Icon="DocumentText" IconVariant="Regular" FontSize="28"/></common:NavigationCard.Icon>
                </common:NavigationCard>

                <Grid x:Name="ServicingCards" ColumnSpacing="{StaticResource PageCardSpacing}" RowSpacing="{StaticResource PageCardSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="RepairCard" Grid.ColumnSpan="2" Style="{StaticResource PageCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ServicingCardIconStyle}">
                                    <fluent:FluentIcon Icon="WrenchScrewdriver" IconVariant="Regular" FontSize="20" Foreground="{ThemeResource PageIconForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource ServicingCardTitleStyle}" Text="{x:Bind ViewModel.RepairOptionsLabel, Mode=OneWay}" AutomationProperties.HeadingLevel="Level2"/>
                            </Grid>
                            <TextBlock Style="{StaticResource ServicingTextStyle}" Text="{x:Bind ViewModel.SourceHint, Mode=OneWay}"/>
                            <Border Style="{StaticResource ServicingCardDividerStyle}"/>
                            <TextBox Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.SourceLabel, Mode=OneWay}">
                                <TextBox.Header><TextBlock Text="{x:Bind ViewModel.SourceLabel, Mode=OneWay}" TextWrapping="Wrap"/></TextBox.Header>
                            </TextBox>
                            <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
                                <Button Content="{x:Bind ViewModel.BrowseWimLabel, Mode=OneWay}" Command="{x:Bind ViewModel.BrowseWimCommand}"/>
                                <Button Content="{x:Bind ViewModel.BrowseFolderLabel, Mode=OneWay}" Command="{x:Bind ViewModel.BrowseFolderCommand}"/>
                            </controls:WrapPanel>
                            <NumberBox Header="{x:Bind ViewModel.IndexLabel, Mode=OneWay}" Value="{x:Bind ViewModel.WimIndex, Mode=TwoWay}" Minimum="1" Maximum="2147483647" SpinButtonPlacementMode="Inline" SmallChange="1" Width="180" HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"/>
                            <CheckBox IsChecked="{x:Bind ViewModel.LimitAccess, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"><TextBlock Text="{x:Bind ViewModel.LimitAccessLabel, Mode=OneWay}" TextWrapping="Wrap"/></CheckBox>
                            <Button x:Name="RepairWindowsButton" Content="{x:Bind ViewModel.RepairLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RunCommand}" CommandParameter="Repair" Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CleanupCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource PageCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ServicingCardIconStyle}">
                                    <fluent:FluentIcon Icon="Database" IconVariant="Regular" FontSize="20" Foreground="{ThemeResource PageIconForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource ServicingCardTitleStyle}" Text="{x:Bind ViewModel.CleanupLabel, Mode=OneWay}" AutomationProperties.HeadingLevel="Level2"/>
                            </Grid>
                            <TextBlock Style="{StaticResource ServicingTextStyle}" Text="{x:Bind ViewModel.CleanupDescription, Mode=OneWay}"/>
                            <Border Style="{StaticResource ServicingCardDividerStyle}"/>
                            <CheckBox IsChecked="{x:Bind ViewModel.ResetBase, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"><TextBlock Text="{x:Bind ViewModel.ResetBaseLabel, Mode=OneWay}" TextWrapping="Wrap"/></CheckBox>
                            <Button x:Name="CleanupWindowsButton" Content="{x:Bind ViewModel.CleanupLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RunCommand}" CommandParameter="Cleanup"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
