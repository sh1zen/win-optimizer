<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinOptimizer.UI.Features.Management.WindowsStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinOptimizer.UI.Features.Management.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
    xmlns:converters="using:WinOptimizer.UI.Features.Common.Converters"
    xmlns:fluent="using:FluentIcons.WinUI">
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="ReportVisibilityConverter"/>
    </Page.Resources>
    <Grid SizeChanged="LayoutRoot_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="WideLayoutTrigger"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ScanAction.(Grid.Column)" Value="1"/>
                        <Setter Target="ScanAction.(Grid.Row)" Value="0"/>
                        <Setter Target="ScanAction.Margin" Value="32,0,12,0"/>
                        <Setter Target="ScanHero.Padding" Value="32"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="CompactLayoutTrigger" IsActive="True"/></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
            <StackPanel Style="{StaticResource PageStackStyle}">
                <common:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneWay}" Description="{x:Bind ViewModel.Description, Mode=OneWay}" Icon="ShieldCheckmark"/>

                <!-- The primary action follows the same responsive presentation as Cleaner scans. -->
                <Border x:Name="ScanHero" Style="{StaticResource PageCardStyle}" CornerRadius="20">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Spacing="16" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ScanStep, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.IntroTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.IntroDescription, Mode=OneWay}" MaxWidth="600" HorizontalAlignment="Left" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="8">
                                <Button Content="{x:Bind ViewModel.QuickCheckLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RunCommand}" CommandParameter="QuickCheck"/>
                                <Button Content="{x:Bind ViewModel.AnalyzeLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RunCommand}" CommandParameter="AnalyzeStore"/>
                                <Button Content="{x:Bind ViewModel.DiagnosisLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RunCommand}" CommandParameter="Diagnosis" Visibility="{x:Bind ViewModel.NeedsRepair, Mode=OneWay, Converter={StaticResource ReportVisibilityConverter}}"/>
                            </controls:WrapPanel>
                        </StackPanel>
                        <Grid x:Name="ScanAction" Grid.Row="1" Width="172" Height="172" Margin="0,24,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Fill="{ThemeResource AccentFillColorTertiaryBrush}" Opacity="0.35"/>
                            <Ellipse Margin="7" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" Opacity="0.35"/>
                            <Button x:Name="PrimaryActionButton" Command="{x:Bind ViewModel.RunCommand}" CommandParameter="{x:Bind ViewModel.PrimaryAction, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Width="136" Height="136" CornerRadius="68" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind ViewModel.PrimaryActionLabel, Mode=OneWay}">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <fluent:FluentIcon Icon="ShieldCheckmark" IconVariant="Regular" FontSize="30" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.PrimaryActionLabel, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <InfoBar IsOpen="{x:Bind ViewModel.ShowModeNotice, Mode=OneWay}" Message="{x:Bind ViewModel.ModeNotice, Mode=OneWay}" IsClosable="False" Visibility="{x:Bind ViewModel.ShowModeNotice, Mode=OneWay, Converter={StaticResource ReportVisibilityConverter}}"/>
                <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" Message="{x:Bind ViewModel.Status, Mode=OneWay}" Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" IsClosable="False" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource ReportVisibilityConverter}}"/>

                <!-- Completed receipts stay ahead of optional settings, including repair guidance. -->
                <StackPanel x:Name="ResultsPanel" Spacing="12" Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource ReportVisibilityConverter}}">
                    <TextBlock Text="{x:Bind ViewModel.ResultsLabel, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                    <InfoBar x:Name="ReportNotice" IsOpen="{x:Bind ViewModel.HasReport, Mode=OneWay}" Message="{x:Bind ViewModel.ReportSummary, Mode=OneWay}" Severity="{x:Bind ViewModel.ReportSeverity, Mode=OneWay}" IsClosable="False"/>
                    <TextBlock Text="{x:Bind ViewModel.HealthSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Steps, Mode=OneWay}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="{StaticResource PageCardSpacing}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:WindowsServicingStepViewModel">
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header><StackPanel Spacing="4"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Status}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Expander.Header>
                                <ScrollViewer Padding="{StaticResource ScrollContentPadding}" MaxHeight="400" VerticalScrollBarVisibility="Auto"><TextBlock Text="{x:Bind Output}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas"/></ScrollViewer>
                            </Expander>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="{StaticResource PageCardSpacing}">
                    <Expander x:Name="RepairOptionsExpander" Header="{x:Bind ViewModel.RepairOptionsLabel, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBox Header="{x:Bind ViewModel.SourceLabel, Mode=OneWay}" Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind ViewModel.SourceHint, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
                                <Button Content="{x:Bind ViewModel.BrowseWimLabel, Mode=OneWay}" Command="{x:Bind ViewModel.BrowseWimCommand}"/>
                                <Button Content="{x:Bind ViewModel.BrowseFolderLabel, Mode=OneWay}" Command="{x:Bind ViewModel.BrowseFolderCommand}"/>
                                <NumberBox Header="{x:Bind ViewModel.IndexLabel, Mode=OneWay}" Value="{x:Bind ViewModel.WimIndex, Mode=TwoWay}" Minimum="1" Maximum="2147483647" SpinButtonPlacementMode="Inline" SmallChange="1" Width="180" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"/>
                            </controls:WrapPanel>
                            <CheckBox IsChecked="{x:Bind ViewModel.LimitAccess, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"><TextBlock Text="{x:Bind ViewModel.LimitAccessLabel, Mode=OneWay}" TextWrapping="Wrap"/></CheckBox>
                            <Button x:Name="RepairWindowsButton" Content="{x:Bind ViewModel.RepairLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RunCommand}" CommandParameter="Repair" Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="{x:Bind ViewModel.CleanupLabel, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <CheckBox IsChecked="{x:Bind ViewModel.ResetBase, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"><TextBlock Text="{x:Bind ViewModel.ResetBaseLabel, Mode=OneWay}" TextWrapping="Wrap"/></CheckBox>
                            <Button Content="{x:Bind ViewModel.CleanupLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RunCommand}" CommandParameter="Cleanup"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="{x:Bind ViewModel.MaintenanceLabel, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.LogsHint, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <HyperlinkButton Content="{x:Bind ViewModel.DocsLabel, Mode=OneWay}" NavigateUri="https://learn.microsoft.com/en-us/windows-hardware/manufacture/desktop/repair-a-windows-image"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
