<UserControl x:Class="WinOptimizer.UI.Features.Management.WindowsStatusProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:FluentIcons.WinUI">
    <Border Style="{StaticResource ScanProgressCardStyle}">
        <StackPanel Spacing="9">
            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource ScanProgressIconStyle}">
                    <fluent:FluentIcon Icon="ShieldCheckmark" IconVariant="Regular" FontSize="25"
                                       Foreground="{ThemeResource PageIconForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="3">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse Width="9" Height="9" Fill="{ThemeResource ScanProgressAccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OperationLabel, Mode=OneWay}" FontSize="11"
                                   FontWeight="SemiBold" Foreground="{ThemeResource ScanProgressAccentBrush}" TextWrapping="Wrap"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.ProgressTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                               TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{x:Bind ViewModel.ProgressCaption, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <Button x:Name="CancelOperationButton" Grid.Column="1" Grid.Row="1" Padding="10,5" HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.CancelOperationCommand, Mode=OneWay}" Background="Transparent"
                        BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                        AutomationProperties.Name="{x:Bind ViewModel.CancelLabel, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <fluent:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.CancelLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid Height="7">
                <Border Style="{StaticResource ScanProgressTrackStyle}"/>
                <ProgressBar x:Name="OperationProgressBar" Style="{StaticResource ScanProgressBarStyle}"
                             IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                             Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                             AutomationProperties.Name="{x:Bind ViewModel.ProgressTitle, Mode=OneWay}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
