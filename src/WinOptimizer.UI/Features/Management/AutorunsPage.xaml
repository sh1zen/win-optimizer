<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinOptimizer.UI.Features.Management.AutorunsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinOptimizer.UI.Features.Management.ViewModels"
    xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:fluent="using:FluentIcons.WinUI">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AutorunListBrush" Color="#1B2029"/>
                    <SolidColorBrush x:Key="AutorunDetailsBrush" Color="#202631"/>
                    <SolidColorBrush x:Key="AutorunHeaderBrush" Color="#292F3C"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AutorunListBrush" Color="#F8FAFE"/>
                    <SolidColorBrush x:Key="AutorunDetailsBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AutorunHeaderBrush" Color="#E9EDF5"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AutorunListBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="AutorunDetailsBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="AutorunHeaderBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <CollectionViewSource x:Name="GroupedEntries" Source="{x:Bind ViewModel.Groups, Mode=OneTime}" IsSourceGrouped="True" ItemsPath="Rows"/>
            <Style x:Key="AutorunToolButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="6"/>
            </Style>
            <Style x:Key="AutorunIconTileStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PageIconBackgroundBrush}"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="AutorunSeparatorStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceStrokeBrush}"/>
                <Setter Property="Height" Value="1"/>
            </Style>
            <Style x:Key="AutorunSecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <ScrollViewer Padding="{StaticResource ScrollContentPadding}" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="Toolbar.RowSpacing" Value="8"/>
                        <Setter Target="FilterColumn.Width" Value="0"/>
                        <Setter Target="SearchArea.(Grid.ColumnSpan)" Value="3"/>
                        <Setter Target="FilterArea.(Grid.Row)" Value="1"/>
                        <Setter Target="FilterArea.(Grid.Column)" Value="0"/>
                        <Setter Target="FilterArea.(Grid.ColumnSpan)" Value="3"/>
                        <Setter Target="AdvancedArea.(Grid.Row)" Value="2"/>
                        <Setter Target="AdvancedArea.(Grid.Column)" Value="0"/>
                        <Setter Target="AdvancedArea.(Grid.ColumnSpan)" Value="3"/>
                        <Setter Target="AdvancedDivider.Visibility" Value="Collapsed"/>
                        <Setter Target="EntriesPanel.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="DetailsPanel.(Grid.Row)" Value="1"/>
                        <Setter Target="DetailsPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="DetailsPanel.(Grid.ColumnSpan)" Value="2"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide"/>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid Style="{StaticResource PageGridStyle}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <common:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneWay}" Description="{x:Bind ViewModel.Description, Mode=OneWay}" Icon="PlayCircle"/>
            <StackPanel Grid.Row="1" Spacing="8">
                <Grid x:Name="Toolbar" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="FilterColumn" Width="348"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid x:Name="SearchArea">
                        <TextBox x:Name="SearchBox" MinHeight="36" Padding="34,6,8,6"
                                 PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                                 ToolTipService.ToolTip="{x:Bind ViewModel.SearchLabel, Mode=OneWay}"
                                 AutomationProperties.Name="{x:Bind ViewModel.SearchLabel, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <fluent:FluentIcon Icon="Search" IconVariant="Regular" FontSize="16" Margin="10,0"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <Grid x:Name="FilterArea" Grid.Column="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="CategoryFilter" MinWidth="0" MinHeight="36" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.CategoryOptions, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.CategoryIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind ViewModel.CategoryLabel, Mode=OneWay}"/>
                        <ComboBox x:Name="StateFilter" Grid.Column="1" MinWidth="0" MinHeight="36" HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind ViewModel.StateFilter, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.StateLabel, Mode=OneWay}">
                            <ComboBoxItem Content="{x:Bind ViewModel.AllStatesLabel, Mode=OneWay}"/>
                            <ComboBoxItem Content="{x:Bind ViewModel.EnabledLabel, Mode=OneWay}"/>
                            <ComboBoxItem Content="{x:Bind ViewModel.DisabledLabel, Mode=OneWay}"/>
                            <ComboBoxItem Content="{x:Bind ViewModel.UnknownLabel, Mode=OneWay}"/>
                        </ComboBox>
                    </Grid>
                    <StackPanel x:Name="AdvancedArea" Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border x:Name="AdvancedDivider" Width="1" Height="22" Background="{ThemeResource AppSurfaceStrokeBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.AdvancedLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="AdvancedToggle" MinWidth="0" IsOn="{x:Bind ViewModel.Advanced, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                      OnContent="{x:Bind ViewModel.OnLabel, Mode=OneWay}" OffContent="{x:Bind ViewModel.OffLabel, Mode=OneWay}"
                                      AutomationProperties.Name="{x:Bind ViewModel.AdvancedLabel, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource PageSurfaceStyle}" Padding="12" Visibility="{x:Bind ViewModel.Advanced, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <CheckBox x:Name="LicenseConsent" Content="{x:Bind ViewModel.LicenseLabel, Mode=OneWay}" IsChecked="{x:Bind ViewModel.LicenseAccepted, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"/>
                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="4">
                            <HyperlinkButton Content="Microsoft Sysinternals · Autoruns" NavigateUri="https://learn.microsoft.com/en-us/sysinternals/downloads/autoruns/" Padding="0"/>
                            <HyperlinkButton Content="Microsoft Sysinternals · License" NavigateUri="https://learn.microsoft.com/en-us/sysinternals/license-terms" Padding="0"/>
                            <CheckBox x:Name="MicrosoftFilter" Content="{x:Bind ViewModel.HideMicrosoftLabel, Mode=OneWay}" IsChecked="{x:Bind ViewModel.HideVerifiedMicrosoft, Mode=TwoWay}"/>
                        </controls:WrapPanel>
                    </StackPanel>
                </Border>
                <InfoBar IsOpen="{x:Bind ViewModel.ShowModeNotice, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowModeNotice, Mode=OneWay}" Message="{x:Bind ViewModel.ModeNotice, Mode=OneWay}" IsClosable="False"/>
                <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}" Message="{x:Bind ViewModel.Status, Mode=OneWay}" Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" IsClosable="False"/>
                <InfoBar IsOpen="{x:Bind ViewModel.HasWarnings, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasWarnings, Mode=OneWay}" Message="{x:Bind ViewModel.WarningLabel, Mode=OneWay}" Severity="Warning" IsClosable="False"/>
            </StackPanel>
            <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="17*"/><ColumnDefinition Width="10*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="EntriesPanel" Style="{StaticResource PageSurfaceStyle}" Padding="10" Background="{ThemeResource AutorunListBrush}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.EntriesLabel, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock Text="{x:Bind ViewModel.VisibleCount, Mode=OneWay}" Style="{StaticResource AutorunSecondaryTextStyle}" VerticalAlignment="Center"/>
                            </controls:WrapPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20"/>
                                <Button x:Name="ScanButton" Style="{StaticResource AutorunToolButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.ScanLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.ScanLabel, Mode=OneWay}">
                                    <fluent:FluentIcon Icon="ArrowSync" IconVariant="Regular" FontSize="16"/>
                                </Button>
                                <Button x:Name="ActionsButton" Style="{StaticResource AutorunToolButtonStyle}" AutomationProperties.Name="{x:Bind ViewModel.ActionsLabel, Mode=OneWay}">
                                    <SymbolIcon Symbol="More"/>
                                    <Button.Resources>
                                        <MenuFlyoutItem x:Key="WindowsStartupSettings" Text="{x:Bind ViewModel.WindowsSettingsLabel, Mode=OneWay}" Command="{x:Bind ViewModel.OpenWindowsSettingsCommand}"/>
                                        <MenuFlyoutItem x:Key="ClearStartupFilters" Text="{x:Bind ViewModel.ClearFiltersLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ClearFiltersCommand}"/>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="ColumnHeaders" Grid.Row="1" Padding="10,7,24,7" ColumnSpacing="10" CornerRadius="8"
                              Background="{ThemeResource AutorunHeaderBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.ApplicationLabel, Mode=OneWay}" Margin="34,0,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CategoryLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.StateLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <ListView x:Name="EntriesList" Grid.Row="2" MinHeight="240" MaxHeight="520" Padding="0,0,14,0"
                                  ItemsSource="{x:Bind GroupedEntries.View, Mode=OneTime}" SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                                  SelectionMode="Single" HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind ViewModel.EntriesLabel, Mode=OneWay}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="MinHeight" Value="46"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.GroupStyle><GroupStyle>
                                <GroupStyle.HeaderTemplate><DataTemplate x:DataType="vm:AutorunGroup">
                                    <Border BorderBrush="{ThemeResource AppSurfaceStrokeBrush}" BorderThickness="0,0,0,1" Padding="10,6,10,8">
                                        <TextBlock Text="{x:Bind Header, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3"/>
                                    </Border>
                                </DataTemplate></GroupStyle.HeaderTemplate>
                            </GroupStyle></ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:AutorunRow">
                                    <Grid ColumnSpacing="10" Padding="10,8" MinHeight="48" AutomationProperties.Name="{x:Bind Entry.Name}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="3" Margin="-10,-8" CornerRadius="8" Background="{ThemeResource AccentSelectionBackgroundBrush}"
                                                Visibility="{x:Bind IsSelected, Mode=OneWay}" IsHitTestVisible="False"/>
                                        <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Margin="-2,0,-2,-8"
                                                Background="{ThemeResource AppSurfaceStrokeBrush}" IsHitTestVisible="False"/>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="14" Height="14" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" AutomationProperties.AccessibilityView="Raw">
                                                <fluent:FluentIcon Icon="Checkmark" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                   Visibility="{x:Bind IsSelected, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw"/>
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource AutorunIconTileStyle}">
                                                <fluent:FluentIcon Icon="{x:Bind Icon}" FontSize="18" IconVariant="Regular" Foreground="{ThemeResource PageIconForegroundBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Entry.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Entry.Name}"/>
                                                <TextBlock Text="{x:Bind Entry.Profile}" Style="{StaticResource AutorunSecondaryTextStyle}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Entry.Category}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Entry.Category}"/>
                                        <Grid Grid.Column="2" ColumnSpacing="7" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="16" Height="16" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" AutomationProperties.AccessibilityView="Raw">
                                                <TextBlock Text="{x:Bind StateGlyph}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind State, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind State, Mode=OneWay}"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.EmptyLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                                   TextWrapping="Wrap" Margin="10,12" IsHitTestVisible="False"/>
                        <Border Grid.Row="3" Style="{StaticResource AutorunSeparatorStyle}"/>
                        <Expander Grid.Row="4" Header="{x:Bind ViewModel.CountSummary, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.SnapshotSummary, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.Warnings, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasWarnings, Mode=OneWay}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                            </StackPanel>
                        </Expander>
                    </Grid>
                </Border>
                <Border x:Name="DetailsPanel" Grid.Column="1" MaxHeight="680" Style="{StaticResource PageSurfaceStyle}" Padding="16"
                        Background="{ThemeResource AutorunDetailsBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource AutorunIconTileStyle}" Width="44" Height="44" CornerRadius="10">
                                    <fluent:FluentIcon Icon="{x:Bind ViewModel.SelectedIcon, Mode=OneWay}" IconVariant="Regular" FontSize="24" Foreground="{ThemeResource PageIconForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.HeadingLevel="Level2"/>
                                    <TextBlock Text="{x:Bind ViewModel.DetailsLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}" Style="{StaticResource AutorunSecondaryTextStyle}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="9" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                                <Border Style="{StaticResource AutorunSeparatorStyle}"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.StateLabel, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                                  IsOn="{x:Bind ViewModel.SelectedEnabled, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanChangeSelected, Mode=OneWay}"
                                                  Toggled="StartupToggle_Toggled" AutomationProperties.Name="{x:Bind ViewModel.StateLabel, Mode=OneWay}"
                                                  AutomationProperties.HelpText="{x:Bind ViewModel.ControlHint, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.ControlHint, Mode=OneWay}"/>
                                    <TextBlock x:Name="SelectedState" Grid.Column="2" Text="{x:Bind ViewModel.SelectedState, Mode=OneWay}" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource AutorunSeparatorStyle}"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.CategoryLabel, Mode=OneWay}" Style="{StaticResource AutorunSecondaryTextStyle}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedEntryCategory, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                </Grid>
                                <Border Style="{StaticResource AutorunSeparatorStyle}"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.ProfileLabel, Mode=OneWay}" Style="{StaticResource AutorunSecondaryTextStyle}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedProfile, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                </Grid>
                                <Border Style="{StaticResource AutorunSeparatorStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.CommandLabel, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <Border Padding="10,8" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock x:Name="SelectedCommand" Text="{x:Bind ViewModel.SelectedCommand, Mode=OneWay}" FontFamily="Consolas" FontSize="12"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                </Border>
                                <Expander Header="{x:Bind ViewModel.TechnicalDetailsLabel, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind ViewModel.ControlHint, Mode=OneWay}" Style="{StaticResource AutorunSecondaryTextStyle}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind ViewModel.LocationLabel, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedLocation, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedImage, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="{x:Bind ViewModel.PublisherLabel, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedPublisher, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="{x:Bind ViewModel.SignerLabel, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSigner, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedDetails, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
