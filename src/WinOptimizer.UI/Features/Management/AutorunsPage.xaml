<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinOptimizer.UI.Features.Management.AutorunsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinOptimizer.UI.Features.Management.ViewModels"
    xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <CollectionViewSource x:Name="GroupedEntries" Source="{x:Bind ViewModel.Groups, Mode=OneTime}" IsSourceGrouped="True" ItemsPath="Rows"/>
    </Page.Resources>
    <ScrollViewer Padding="{StaticResource ScrollContentPadding}" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailsPanel.(Grid.Row)" Value="1"/><Setter Target="DetailsPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="DetailsPanel.(Grid.ColumnSpan)" Value="2"/><Setter Target="DetailsPanel.MaxHeight" Value="260"/>
                        <Setter Target="EntriesList.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="MicrosoftFilter.(Grid.Row)" Value="1"/><Setter Target="MicrosoftFilter.(Grid.Column)" Value="0"/>
                        <Setter Target="MicrosoftFilter.(Grid.ColumnSpan)" Value="4"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1050"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailsPanel.(Grid.Row)" Value="0"/><Setter Target="DetailsPanel.(Grid.Column)" Value="1"/>
                        <Setter Target="DetailsPanel.(Grid.ColumnSpan)" Value="1"/><Setter Target="DetailsPanel.MaxHeight" Value="Infinity"/>
                        <Setter Target="EntriesList.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="MicrosoftFilter.(Grid.Row)" Value="0"/><Setter Target="MicrosoftFilter.(Grid.Column)" Value="3"/>
                        <Setter Target="MicrosoftFilter.(Grid.ColumnSpan)" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    <Grid x:Name="PageRoot" Style="{StaticResource PageGridStyle}" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <common:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneWay}" Description="{x:Bind ViewModel.Description, Mode=OneWay}" Icon="PlayCircle"/>
        <StackPanel Grid.Row="1" Spacing="8">
            <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
                <ToggleSwitch x:Name="AdvancedToggle" Header="{x:Bind ViewModel.AdvancedLabel, Mode=OneWay}" IsOn="{x:Bind ViewModel.Advanced, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"/>
                <Button x:Name="ScanButton" Content="{x:Bind ViewModel.ScanLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshCommand}" VerticalAlignment="Bottom"/>
                <Button Content="{x:Bind ViewModel.WindowsSettingsLabel, Mode=OneWay}" Command="{x:Bind ViewModel.OpenWindowsSettingsCommand}" VerticalAlignment="Bottom"/>
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24"/>
            </controls:WrapPanel>
            <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Visibility="{x:Bind ViewModel.Advanced, Mode=OneWay}" Spacing="4">
                <CheckBox x:Name="LicenseConsent" Content="{x:Bind ViewModel.LicenseLabel, Mode=OneWay}" IsChecked="{x:Bind ViewModel.LicenseAccepted, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"/>
                <HyperlinkButton Content="Microsoft Sysinternals · Autoruns" NavigateUri="https://learn.microsoft.com/en-us/sysinternals/downloads/autoruns/" Padding="0"/>
                <HyperlinkButton Content="Microsoft Sysinternals · License" NavigateUri="https://learn.microsoft.com/en-us/sysinternals/license-terms" Padding="0"/>
            </StackPanel>
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="{x:Bind ViewModel.SearchLabel, Mode=OneWay}" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button x:Name="ClearFiltersButton" Grid.Column="1" Content="×" Command="{x:Bind ViewModel.ClearFiltersCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.ClearFiltersLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.ClearFiltersLabel, Mode=OneWay}"/>
                </Grid>
                <ComboBox x:Name="CategoryFilter" Grid.Column="1" PlaceholderText="{x:Bind ViewModel.AllLabel, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Categories}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" MinWidth="170" MaxWidth="300" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind ViewModel.CategoryLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.CategoryLabel, Mode=OneWay}"/>
                <ComboBox x:Name="StateFilter" Grid.Column="2" SelectedIndex="{x:Bind ViewModel.StateFilter, Mode=TwoWay}" MinWidth="150" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind ViewModel.AllStatesLabel, Mode=OneWay}">
                    <ComboBoxItem Content="{x:Bind ViewModel.AllStatesLabel, Mode=OneWay}"/>
                    <ComboBoxItem Content="{x:Bind ViewModel.EnabledLabel, Mode=OneWay}"/>
                    <ComboBoxItem Content="{x:Bind ViewModel.DisabledLabel, Mode=OneWay}"/>
                    <ComboBoxItem Content="{x:Bind ViewModel.UnknownLabel, Mode=OneWay}"/>
                </ComboBox>
                <CheckBox x:Name="MicrosoftFilter" Grid.Column="3" Content="{x:Bind ViewModel.HideMicrosoftLabel, Mode=OneWay}" IsChecked="{x:Bind ViewModel.HideVerifiedMicrosoft, Mode=TwoWay}" Visibility="{x:Bind ViewModel.Advanced, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="4">
            <InfoBar IsOpen="{x:Bind ViewModel.ShowModeNotice, Mode=OneWay}" Message="{x:Bind ViewModel.ModeNotice, Mode=OneWay}" IsClosable="False"/>
            <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" Message="{x:Bind ViewModel.Status, Mode=OneWay}" Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" IsClosable="False"/>
            <Expander Header="{x:Bind ViewModel.CountSummary, Mode=OneWay}" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.SnapshotSummary, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <TextBlock Text="{x:Bind ViewModel.Warnings, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                </StackPanel>
            </Expander>
            <InfoBar IsOpen="{x:Bind ViewModel.HasWarnings, Mode=OneWay}" Message="{x:Bind ViewModel.WarningLabel, Mode=OneWay}" Severity="Warning" IsClosable="False"/>
        </StackPanel>
        <Grid Grid.Row="3" ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ListView Padding="{StaticResource ScrollContentPadding}" x:Name="EntriesList" ItemsSource="{x:Bind GroupedEntries.View, Mode=OneTime}" SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}" SelectionMode="Single" HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                <ListView.GroupStyle><GroupStyle>
                    <GroupStyle.HeaderTemplate><DataTemplate x:DataType="vm:AutorunGroup">
                        <TextBlock Text="{x:Bind Header, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Margin="8,18,0,8" AutomationProperties.HeadingLevel="Level2"/>
                    </DataTemplate></GroupStyle.HeaderTemplate>
                </GroupStyle></ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AutorunRow">
                        <Grid Padding="8,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Width="32" Height="32" VerticalAlignment="Top"><TextBlock Text="{x:Bind StateGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/></Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{x:Bind Entry.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Entry.Name}"/>
                                <TextBlock Text="{x:Bind Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Entry.Command}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Entry.Command}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="{x:Bind ViewModel.EmptyLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" TextWrapping="Wrap" Margin="16" IsHitTestVisible="False"/>
            <Border x:Name="DetailsPanel" Grid.Column="1" Style="{StaticResource PageCardStyle}">
                <ScrollViewer Padding="{StaticResource ScrollContentPadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.SelectedState, Mode=OneWay}" FontWeight="SemiBold"/>
                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button x:Name="EnableButton" Content="{x:Bind ViewModel.EnableLabel, Mode=OneWay}" Command="{x:Bind ViewModel.EnableCommand}"/>
                                <Button Content="{x:Bind ViewModel.DisableLabel, Mode=OneWay}" Command="{x:Bind ViewModel.DisableCommand}"/>
                            </controls:WrapPanel>
                            <TextBlock Text="{x:Bind ViewModel.ControlHint, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.LocationLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedLocation, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            <TextBlock Text="{x:Bind ViewModel.CommandLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedCommand, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedImage, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            <TextBlock Text="{x:Bind ViewModel.PublisherLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedPublisher, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            <TextBlock Text="{x:Bind ViewModel.SignerLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedSigner, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            <TextBlock Text="{x:Bind ViewModel.ProfileLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedProfile, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedDetails, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
