<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinOptimizer.UI.Features.Management.EventsCleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinOptimizer.UI.Features.Management.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:common="using:WinOptimizer.UI.Features.Common.Controls">
    <Grid Style="{StaticResource PageGridStyle}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <common:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneWay}" Description="{x:Bind ViewModel.Description, Mode=OneWay}" Icon="DocumentBulletList"/>
            <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <controls:WrapPanel Grid.Row="1" HorizontalSpacing="10" VerticalSpacing="8">
            <Button Content="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshCommand}"/>
            <Button Content="{x:Bind ViewModel.SelectAllLabel, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAllCommand}"/>
            <Button Content="{x:Bind ViewModel.SelectNoneLabel, Mode=OneWay}" Command="{x:Bind ViewModel.SelectNoneCommand}"/>
            <Button x:Name="ClearEventsButton" Content="{x:Bind ViewModel.ClearLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ClearCommand}" Style="{StaticResource AccentButtonStyle}"/>
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24"/>
        </controls:WrapPanel>
        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar IsOpen="{x:Bind ViewModel.ShowModeNotice, Mode=OneWay}" Message="{x:Bind ViewModel.ModeNotice, Mode=OneWay}" IsClosable="False"/>
            <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" Message="{x:Bind ViewModel.Status, Mode=OneWay}" Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" IsClosable="False"/>
            <TextBlock Text="{x:Bind ViewModel.SelectionLabel, Mode=OneWay}"/>
            <TextBlock x:Name="SelectedLogSizeText" Text="{x:Bind ViewModel.SelectionSizeLabel, Mode=OneWay}" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind ViewModel.EmptyLabel, Mode=OneWay}" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="12" Padding="16,0,16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CountLabel, Mode=OneWay}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SizeLabel, Mode=OneWay}" TextWrapping="Wrap"/>
            </Grid>
            <ListView Padding="{StaticResource ScrollContentPadding}" Grid.Row="1" x:Name="EventChannelsList" ItemsSource="{x:Bind ViewModel.Channels}" SelectionMode="None" HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}">
                <ListView.ItemTemplate><DataTemplate x:DataType="vm:EventLogRow">
                    <Grid ColumnSpacing="12" Padding="8,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}" AutomationProperties.Name="{x:Bind Name}">
                                <CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></CheckBox.ContentTemplate>
                            </CheckBox>
                            <TextBlock Text="{x:Bind ResultText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind CountText, Mode=OneWay}" VerticalAlignment="Top" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Top" TextWrapping="Wrap"/>
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
