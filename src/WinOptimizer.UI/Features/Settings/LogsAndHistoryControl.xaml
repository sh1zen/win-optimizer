<UserControl x:Class="WinOptimizer.UI.Features.Settings.LogsAndHistoryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinOptimizer.UI.Features.Settings.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:fluent="using:FluentIcons.WinUI"
    xmlns:helpers="using:WinOptimizer.UI.Features.Common.Helpers">
    <Grid DataContext="{x:Bind ViewModel, Mode=OneWay}" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="10">
            <TextBox x:Name="JournalSearch" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding SearchPlaceholder}" AutomationProperties.Name="{Binding SearchPlaceholder}"
                     HorizontalAlignment="Stretch"/>
            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                <ComboBox x:Name="TopicFilter" ItemsSource="{Binding Topics}" DisplayMemberPath="Title" SelectedIndex="{Binding TopicIndex, Mode=TwoWay}"
                          Width="220" AutomationProperties.Name="{Binding TopicLabel}"/>
                <ComboBox x:Name="KindFilter" ItemsSource="{Binding Filters}" DisplayMemberPath="Title" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}"
                          Width="190" AutomationProperties.Name="{Binding FilterLabel}"/>
                <Button Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}"/>
                <Button x:Name="ClearLogsButton" Content="{Binding ClearLabel}" Command="{Binding ClearAppLogsCommand}"/>
                <ProgressRing Width="22" Height="22" IsActive="{Binding IsBusy}"
                              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </controls:WrapPanel>
            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/>
        </StackPanel>
        <ListView x:Name="TopicGroups" Grid.Row="1" ItemsSource="{Binding Groups}" SelectionMode="None" HorizontalContentAlignment="Stretch"
                  Padding="{StaticResource ScrollContentPadding}" Background="Transparent" helpers:ScrollBarAutoHide.HideAfter="0:0:2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/>
            </Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate x:DataType="vm:LogTopicGroup">
                <Expander IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Expander.Header>
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <fluent:FluentIcon Icon="{x:Bind Icon}" IconVariant="Regular" IconSize="Size20" VerticalAlignment="Center"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="4">
                                    <TextBlock Text="{x:Bind Summary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind Problems, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               Visibility="{x:Bind HasProblems, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </controls:WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <ListView ItemsSource="{x:Bind Items}" MaxHeight="460" SelectionMode="None" Padding="{StaticResource ScrollContentPadding}" Background="Transparent"
                              HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/>
                        </Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate x:DataType="vm:LogDisplayEntry">
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="2,10">
                                <StackPanel Spacing="6">
                                    <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="4">
                                        <TextBlock Text="{x:Bind Category, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind Timestamp, Mode=OneWay}" FontSize="12" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind Group, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind HasGroup, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </controls:WrapPanel>
                                    <TextBlock Text="{x:Bind Message, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                    <Grid ColumnSpacing="12" Visibility="{x:Bind HasValueChange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind BeforeLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind Before, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{x:Bind AfterLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind After, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold" IsTextSelectionEnabled="True"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Batch, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind HasBatch, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Expander Header="{x:Bind DetailsLabel, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <TextBlock Text="{x:Bind Details, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12"/>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Expander>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="1" Text="{Binding EmptyLabel}" TextWrapping="Wrap" Margin="12" VerticalAlignment="Top"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <Button Content="{Binding LoadMoreLabel}" Command="{Binding LoadMoreCommand}"
                    Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>
