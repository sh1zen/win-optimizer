<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cleaner="using:WinOptimizer.UI.Features.Cleaner" xmlns:drivers="using:WinOptimizer.UI.Features.Drivers" xmlns:settings="using:WinOptimizer.UI.Features.Settings" xmlns:vm="using:WinOptimizer.UI.Features.Settings.ViewModels" xmlns:controls="using:CommunityToolkit.WinUI.Controls" xmlns:fluent="using:FluentIcons.WinUI" xmlns:helpers="using:WinOptimizer.UI.Features.Common.Helpers" xmlns:common="using:WinOptimizer.UI.Features.Common.Controls" x:Class="WinOptimizer.UI.Features.Settings.SettingsPage">
    <Page.Resources>
        <CollectionViewSource x:Name="CategoryGroups" Source="{x:Bind ViewModel.VisibleGroups}" IsSourceGrouped="True" ItemsPath="Items"/>
    </Page.Resources>
    <Grid x:Name="LayoutRoot" SizeChanged="LayoutRoot_SizeChanged" Style="{StaticResource PageGridStyle}">
        <VisualStateManager.VisualStateGroups><VisualStateGroup>
            <VisualState x:Name="WideLayout"><VisualState.StateTriggers><StateTrigger x:Name="WideLayoutTrigger"/></VisualState.StateTriggers></VisualState>
            <VisualState x:Name="CompactLayout">
                <VisualState.StateTriggers><StateTrigger x:Name="CompactLayoutTrigger" IsActive="True"/></VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="CategoryNavigation.(Grid.ColumnSpan)" Value="2"/>
                    <Setter Target="DetailsPanel.(Grid.Column)" Value="0"/>
                    <Setter Target="DetailsPanel.(Grid.ColumnSpan)" Value="2"/>
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <common:PageHeader Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Description="{x:Bind ViewModel.PageDescription, Mode=OneWay}" Icon="Settings"/>
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid x:Name="CategoryNavigation" RowSpacing="12" Visibility="{x:Bind ViewModel.ShowCategories, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <AutoSuggestBox HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.Query, Mode=TwoWay}" QueryIcon="Find" PlaceholderText="{x:Bind ViewModel.SearchLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.SearchLabel, Mode=OneWay}"/>
                <ListView Padding="{StaticResource ScrollContentPadding}" x:Name="CategoryList" Grid.Row="1" ItemsSource="{x:Bind CategoryGroups.View, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=OneWay}" IsSynchronizedWithCurrentItem="False" SelectionChanged="CategoryList_SelectionChanged" SelectionMode="Single" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" helpers:ScrollBarAutoHide.HideAfter="0:0:2" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind ViewModel.PageTitle, Mode=OneWay}">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/>
                        <Setter Property="Margin" Value="0,0,0,3"/><Setter Property="CornerRadius" Value="10"/>
                        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                    </Style></ListView.ItemContainerStyle>
                    <ListView.GroupStyle><GroupStyle>
                        <GroupStyle.HeaderTemplate><DataTemplate x:DataType="vm:SettingsCategoryGroup">
                            <TextBlock Text="{x:Bind Title}" Margin="10,18,0,8" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.HeadingLevel="Level2"/>
                        </DataTemplate></GroupStyle.HeaderTemplate>
                    </GroupStyle></ListView.GroupStyle>
                    <ListView.ItemTemplate><DataTemplate x:DataType="vm:SettingsCategoryItem">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{ThemeResource PageIconBackgroundBrush}" VerticalAlignment="Center">
                                <fluent:FluentIcon Icon="{x:Bind Icon}" IconVariant="Regular" IconSize="Size20" FontSize="20" Foreground="{ThemeResource PageIconForegroundBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind DisplayDescription, Mode=OneWay}" FontSize="12" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <fluent:FluentIcon Grid.Column="2" Icon="ChevronRight" IconVariant="Regular" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.NoMatchesLabel, Mode=OneWay}" TextWrapping="Wrap" Margin="16,24" VerticalAlignment="Top" Visibility="{x:Bind ViewModel.NoMatches, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Polite"/>
            </Grid>
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Visibility="{x:Bind ViewModel.ShowPlaceholder, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Padding="32">
                    <fluent:FluentIcon Icon="Settings" IconVariant="Regular" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectCategoryLabel, Mode=OneWay}" FontSize="18" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid x:Name="DetailsPanel" Grid.Column="1" RowSpacing="16" Visibility="{x:Bind ViewModel.ShowDetails, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource PageIconBackgroundBrush}" VerticalAlignment="Top">
                        <fluent:FluentIcon Icon="{x:Bind ViewModel.SelectedIcon, Mode=OneWay}" IconVariant="Regular" IconSize="Size20" FontSize="24" Foreground="{ThemeResource PageIconForegroundBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedDescription, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
                <settings:LogsAndHistoryControl Grid.Row="1" ViewModel="{x:Bind ViewModel.Logs}" Visibility="{x:Bind ViewModel.ShowLogsAndHistory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ScrollViewer Padding="{StaticResource ScrollContentPadding}" Grid.Row="1" Visibility="{x:Bind ViewModel.ShowPreferenceDetails, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" helpers:ScrollBarAutoHide.HideAfter="0:0:2">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.ShowAppearance, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <controls:SettingsCard Header="{x:Bind ViewModel.LanguageHeader, Mode=OneWay}" Description="{x:Bind ViewModel.LanguageDescription, Mode=OneWay}" Style="{StaticResource PageSettingsCardStyle}">
                                <controls:SettingsCard.HeaderIcon><fluent:FluentIcon Icon="LocalLanguage" IconVariant="Regular" IconSize="Size20"/></controls:SettingsCard.HeaderIcon>
                                <ComboBox MinWidth="180" ItemsSource="{x:Bind ViewModel.Languages}" SelectedValue="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" SelectedValuePath="Value" FlowDirection="LeftToRight">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}" TextReadingOrder="UseFlowDirection"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="{x:Bind ViewModel.ThemeHeader, Mode=OneWay}" Description="{x:Bind ViewModel.ThemeDescription, Mode=OneWay}" Style="{StaticResource PageSettingsCardStyle}">
                                <controls:SettingsCard.HeaderIcon><fluent:FluentIcon Icon="PaintBrushSparkle" IconVariant="Regular" IconSize="Size20"/></controls:SettingsCard.HeaderIcon>
                                <ComboBox MinWidth="180" ItemsSource="{x:Bind ViewModel.Themes}" SelectedItem="{x:Bind ViewModel.SelectedThemeOption, Mode=TwoWay}" DisplayMemberPath="DisplayText"/>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="{x:Bind ViewModel.AppColorPreferences.Label, Mode=OneWay}" Description="{x:Bind ViewModel.AppColorPreferences.Description, Mode=OneWay}" Style="{StaticResource PageSettingsCardStyle}">
                                <controls:SettingsCard.HeaderIcon><fluent:FluentIcon Icon="PaintBrushSparkle" IconVariant="Regular" IconSize="Size20"/></controls:SettingsCard.HeaderIcon>
                                <ComboBox MinWidth="180" ItemsSource="{x:Bind ViewModel.AppColorPreferences.Colors}" SelectedItem="{x:Bind ViewModel.AppColorPreferences.SelectedOption, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.AppColorPreferences.CanEdit, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.AppColorPreferences.Label, Mode=OneWay}">
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AppColorOption">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Ellipse Width="16" Height="16" Fill="{x:Bind Swatch}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}"/>
                                        </StackPanel>
                                    </DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:SettingsCard>
                            <TextBlock Text="{x:Bind ViewModel.AppColorPreferences.Status, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
                            <controls:SettingsCard Header="{x:Bind ViewModel.SidebarPreferences.ExpandedLabel, Mode=OneWay}" Description="{x:Bind ViewModel.SidebarPreferences.ExpandedDescription, Mode=OneWay}" Style="{StaticResource PageSettingsCardStyle}">
                                <controls:SettingsCard.HeaderIcon><fluent:FluentIcon Icon="Navigation" IconVariant="Regular" IconSize="Size20"/></controls:SettingsCard.HeaderIcon>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.SidebarPreferences.IsExpanded, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SidebarPreferences.CanEdit, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.SidebarPreferences.ExpandedLabel, Mode=OneWay}"/>
                            </controls:SettingsCard>
                            <TextBlock Text="{x:Bind ViewModel.SidebarPreferences.Status, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <cleaner:CleanerSettingsControl ViewModel="{x:Bind ViewModel.Cleaner}" Section="{x:Bind ViewModel.SelectedCleanerSection, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowCleaner, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <drivers:DriverSettingsControl ViewModel="{x:Bind ViewModel.Drivers}" Visibility="{x:Bind ViewModel.ShowDrivers, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.ShowInfo, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <controls:SettingsCard Header="{x:Bind ViewModel.Info.VersionLabel, Mode=OneWay}" Description="{x:Bind ViewModel.Info.VersionInfo, Mode=OneWay}" Style="{StaticResource PageSettingsCardStyle}">
                                <controls:SettingsCard.HeaderIcon><fluent:FluentIcon Icon="Info" IconVariant="Regular" IconSize="Size20"/></controls:SettingsCard.HeaderIcon>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="{x:Bind ViewModel.Info.CheckForUpdatesLabel, Mode=OneWay}" IsClickEnabled="True" Command="{x:Bind ViewModel.Info.Updates.CheckForUpdatesCommand}" Style="{StaticResource PageSettingsCardStyle}">
                                <controls:SettingsCard.HeaderIcon><fluent:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size20"/></controls:SettingsCard.HeaderIcon>
                                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.Info.Updates.IsUpdateCheckInProgress, Mode=OneWay}" Visibility="{x:Bind ViewModel.Info.Updates.IsUpdateCheckInProgress, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </controls:SettingsCard>
                            <TextBlock Text="{x:Bind ViewModel.UpdatePreferences.ScheduleDescription, Mode=OneWay}" TextWrapping="Wrap" Margin="0,8,0,4" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <controls:SettingsCard Header="{x:Bind ViewModel.UpdatePreferences.ApplicationUpdatesLabel, Mode=OneWay}" Style="{StaticResource PageSettingsCardStyle}">
                                <controls:SettingsCard.HeaderIcon><fluent:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size20"/></controls:SettingsCard.HeaderIcon>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.UpdatePreferences.CheckApplicationUpdatesAutomatically, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.UpdatePreferences.CanEdit, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.UpdatePreferences.ApplicationUpdatesLabel, Mode=OneWay}"/>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="{x:Bind ViewModel.UpdatePreferences.ScriptUpdatesLabel, Mode=OneWay}" Style="{StaticResource PageSettingsCardStyle}">
                                <controls:SettingsCard.HeaderIcon><fluent:FluentIcon Icon="DocumentText" IconVariant="Regular" IconSize="Size20"/></controls:SettingsCard.HeaderIcon>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.UpdatePreferences.UpdateRemovalScriptsAutomatically, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.UpdatePreferences.CanEdit, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.UpdatePreferences.ScriptUpdatesLabel, Mode=OneWay}"/>
                            </controls:SettingsCard>
                            <TextBlock Text="{x:Bind ViewModel.UpdatePreferences.Status, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
                            <controls:SettingsCard x:Name="SupportCard" Header="{x:Bind ViewModel.Info.SupportLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.Info.SupportLabel, Mode=OneWay}" IsClickEnabled="True" Command="{x:Bind ViewModel.Info.SupportWinOptimizerCommand}" Margin="0,8,0,0" Style="{StaticResource PageSettingsCardStyle}">
                                <controls:SettingsCard.HeaderIcon><fluent:FluentIcon Icon="Heart" IconVariant="Regular" IconSize="Size20"/></controls:SettingsCard.HeaderIcon>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="{x:Bind ViewModel.Info.DocumentationLabel, Mode=OneWay}" IsClickEnabled="True" Command="{x:Bind ViewModel.Info.OpenDocsCommand}" Style="{StaticResource PageSettingsCardStyle}">
                                <controls:SettingsCard.HeaderIcon><fluent:FluentIcon Icon="BookQuestionMark" IconVariant="Regular" IconSize="Size20"/></controls:SettingsCard.HeaderIcon>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="{x:Bind ViewModel.Info.ReportBugLabel, Mode=OneWay}" IsClickEnabled="True" Command="{x:Bind ViewModel.Info.ReportBugCommand}" Style="{StaticResource PageSettingsCardStyle}">
                                <controls:SettingsCard.HeaderIcon><fluent:FluentIcon Icon="Bug" IconVariant="Regular" IconSize="Size20"/></controls:SettingsCard.HeaderIcon>
                            </controls:SettingsCard>
                        </StackPanel>
                        <Border x:Name="FullResetCard" Visibility="{x:Bind ViewModel.ShowResetAll, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource PageCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.FullResetDetails, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{x:Bind ViewModel.ResetLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ResetCommand}" IsEnabled="{x:Bind ViewModel.CanReset, Mode=OneWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Spacing="10">
                    <Border Padding="16" Visibility="{x:Bind ViewModel.ShowCleanerAccounts, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource PageCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Cleaner.RegistryAccountsLabel, Mode=OneWay}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3"/>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CleanerAccountChoices, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.Cleaner.CanEdit, Mode=OneWay}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:WrapPanel HorizontalSpacing="20" VerticalSpacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Title}"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{x:Bind ViewModel.CleanerAccountsDescription, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
                    <Button Content="{x:Bind ViewModel.ResetLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ResetCommand}" IsEnabled="{x:Bind ViewModel.CanReset, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowCategoryReset, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
