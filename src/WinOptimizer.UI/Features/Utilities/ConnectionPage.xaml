<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:WinOptimizer.UI.Features.Utilities.ViewModels" xmlns:controls="using:CommunityToolkit.WinUI.Controls" xmlns:common="using:WinOptimizer.UI.Features.Common.Controls" x:Class="WinOptimizer.UI.Features.Utilities.ConnectionPage">
    <Page.Resources>
        <DataTemplate x:Key="TrafficStat" x:DataType="vm:ConnectionTrafficStat">
            <StackPanel Spacing="4" MinWidth="175" Margin="0,0,24,8">
                <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind Value}" FontSize="22" FontWeight="SemiBold" IsTextSelectionEnabled="True"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <common:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneWay}" Description="{x:Bind ViewModel.Description, Mode=OneWay}" Icon="Globe"/>
                </StackPanel>
            <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
                <Button Content="{x:Bind ViewModel.SavedWifiLabel, Mode=OneWay}" Click="SavedWifi_Click"/>
                <TextBlock Text="{x:Bind ViewModel.CapturedAt, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </controls:WrapPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.ShowModeNotice, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowModeNotice, Mode=OneWay}" Message="{x:Bind ViewModel.ModeNotice, Mode=OneWay}" IsClosable="False"/>
            <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" Message="{x:Bind ViewModel.Status, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}" Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" IsClosable="False"/>
            <Border Style="{StaticResource PageCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.LiveTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.LiveStats, Mode=OneWay}" ItemTemplate="{StaticResource TrafficStat}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <controls:WrapPanel HorizontalSpacing="20" VerticalSpacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6"><Border x:Name="ReceivedLegend" Width="12" Height="12" CornerRadius="3" Background="{ThemeResource SystemFillColorSuccessBrush}"/><TextBlock Text="{x:Bind ViewModel.ReceivedLabel, Mode=OneWay}"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6"><Border x:Name="SentLegend" Width="12" Height="12" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}"/><TextBlock Text="{x:Bind ViewModel.SentLabel, Mode=OneWay}"/></StackPanel>
                    </controls:WrapPanel>
                    <TextBlock Text="{x:Bind ViewModel.LiveScale, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    <Canvas x:Name="LiveChart" Height="160" SizeChanged="Chart_SizeChanged" AutomationProperties.Name="{x:Bind ViewModel.LiveTitle, Mode=OneWay}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.FifteenMinutesAgoLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NowLabel, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.LiveCoverage, Mode=OneWay}" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.LiveDiagnostic, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasLiveDiagnostic, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.LiveHint, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.HistoryTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.HistoryTotal, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" IsTextSelectionEnabled="True"/>
                    <TextBlock Text="{x:Bind ViewModel.HistorySummary, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <controls:WrapPanel HorizontalSpacing="20" VerticalSpacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="3" Background="{ThemeResource SystemFillColorSuccessBrush}"/><TextBlock Text="{x:Bind ViewModel.ReceivedLabel, Mode=OneWay}"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}"/><TextBlock Text="{x:Bind ViewModel.SentLabel, Mode=OneWay}"/></StackPanel>
                    </controls:WrapPanel>
                    <TextBlock Text="{x:Bind ViewModel.HistoryScale, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    <!-- Keep loading feedback centered over the usage plot without moving its content. -->
                    <Grid>
                        <Canvas x:Name="DailyChart" Height="180" SizeChanged="Chart_SizeChanged" AutomationProperties.Name="{x:Bind ViewModel.HistoryTitle, Mode=OneWay}"/>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                      Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.HistoryStart, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HistoryEnd, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.HistoryDiagnostic, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasHistoryDiagnostic, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.HistoryHint, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.DnsTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.DnsHint, Mode=OneWay}" TextWrapping="Wrap"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.DnsChoices, Mode=OneWay}" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.SelectedDnsIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanWrite, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.DnsTitle, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.DnsUnavailable, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowDnsUnavailable, Mode=OneWay}" TextWrapping="Wrap"/>
                    <Button Content="{x:Bind ViewModel.DnsApplyLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ApplyDnsCommand}" Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.VpnTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.VpnHint, Mode=OneWay}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.VpnProfiles, Mode=OneWay}">
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ConnectionVpnCard">
                            <StackPanel Spacing="4" Margin="0,4">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Bind ViewModel.EmptyVpn, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowEmptyVpn, Mode=OneWay}" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.VpnDiagnostic, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasVpnDiagnostic, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <Button Content="{x:Bind ViewModel.ManageVpnLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ManageVpnCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
