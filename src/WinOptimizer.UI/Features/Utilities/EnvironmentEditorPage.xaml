<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:domain="using:WinOptimizer.Core.Features.Utilities" xmlns:controls="using:CommunityToolkit.WinUI.Controls" xmlns:vm="using:WinOptimizer.UI.Features.Utilities.ViewModels" xmlns:common="using:WinOptimizer.UI.Features.Common.Controls" x:Class="WinOptimizer.UI.Features.Utilities.EnvironmentEditorPage">
    <Grid>
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="EditorLayout">
            <VisualState x:Name="WideEditor"/>
            <VisualState x:Name="NarrowEditor"><VisualState.Setters>
                <Setter Target="VariablesPane.(Grid.ColumnSpan)" Value="2"/>
                <Setter Target="VariableForm.(Grid.Column)" Value="0"/><Setter Target="VariableForm.(Grid.Row)" Value="1"/>
                <Setter Target="VariableForm.(Grid.ColumnSpan)" Value="2"/>
            </VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <common:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneWay}" Description="{x:Bind ViewModel.Description, Mode=OneWay}" Icon="Code"/>
                </StackPanel>
            <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
                <ComboBox SelectedIndex="{x:Bind ViewModel.ScopeIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" MinWidth="210" AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}">
                    <ComboBoxItem Content="{x:Bind ViewModel.UserLabel, Mode=OneWay}"/><ComboBoxItem Content="{x:Bind ViewModel.SystemLabel, Mode=OneWay}"/>
                </ComboBox>
                <Button Content="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshCommand}"/>
                <Button Content="{x:Bind ViewModel.NewLabel, Mode=OneWay}" Command="{x:Bind ViewModel.NewCommand}"/>
                <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
            </controls:WrapPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.ShowModeNotice, Mode=OneWay}" Message="{x:Bind ViewModel.ModeNotice, Mode=OneWay}" IsClosable="False"/>
            <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" Message="{x:Bind ViewModel.Status, Mode=OneWay}" Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" IsClosable="False"/>
            <Grid ColumnSpacing="20" RowSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="VariablesPane" RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="430"/></Grid.RowDefinitions>
                    <TextBox Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Bind ViewModel.SearchLabel, Mode=OneWay}"/>
                    <ListView Padding="{StaticResource ScrollContentPadding}" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Variables}" SelectedItem="{x:Bind ViewModel.SelectedVariable, Mode=OneWay}" SelectionChanged="Variables_SelectionChanged" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" AutomationProperties.Name="{x:Bind ViewModel.SearchLabel, Mode=OneWay}">
                        <ListView.ItemTemplate><DataTemplate x:DataType="domain:EnvironmentVariableEntry">
                            <StackPanel Spacing="4" Padding="4,8">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Value}" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <Border x:Name="VariableForm" Grid.Column="1" Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBox Header="{x:Bind ViewModel.NameLabel, Mode=OneWay}" Text="{x:Bind ViewModel.VariableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.CanChangeName, Mode=OneWay}"/>
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsPath, Mode=OneWay}">
                            <ToggleSwitch OnContent="{x:Bind ViewModel.RawTextLabel, Mode=OneWay}" OffContent="{x:Bind ViewModel.RawTextLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.RawTextLabel, Mode=OneWay}" IsOn="{x:Bind ViewModel.EditPathAsText, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"/>
                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowPathEntries, Mode=OneWay}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.PathLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PathCountLabel, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.PathHint, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ListView Padding="{StaticResource ScrollContentPadding}" x:Name="PathEntriesList" ItemsSource="{x:Bind ViewModel.PathEntries}" SelectedItem="{x:Bind ViewModel.SelectedPathEntry, Mode=TwoWay}" MinHeight="100" MaxHeight="260" HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanWrite, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.PathLabel, Mode=OneWay}">
                                    <ListView.ItemTemplate><DataTemplate x:DataType="vm:EnvironmentPathEntryViewModel">
                                        <TextBox Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="0,3" PlaceholderText="C:\Tools" GettingFocus="PathEntry_GettingFocus" AutomationProperties.Name="{x:Bind Value, Mode=OneWay}"/>
                                    </DataTemplate></ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="{x:Bind ViewModel.PathEmptyLabel, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ShowPathEmpty, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                    <Button Content="{x:Bind ViewModel.AddPathLabel, Mode=OneWay}" Click="AddPathEntry_Click" IsEnabled="{x:Bind ViewModel.CanWrite, Mode=OneWay}"/>
                                    <Button Content="{x:Bind ViewModel.BrowsePathLabel, Mode=OneWay}" Click="BrowsePath_Click" IsEnabled="{x:Bind ViewModel.CanWrite, Mode=OneWay}"/>
                                    <Button Content="{x:Bind ViewModel.RemovePathLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RemovePathEntryCommand}"/>
                                    <Button Content="{x:Bind ViewModel.MoveUpLabel, Mode=OneWay}" Command="{x:Bind ViewModel.MovePathEntryUpCommand}"/>
                                    <Button Content="{x:Bind ViewModel.MoveDownLabel, Mode=OneWay}" Command="{x:Bind ViewModel.MovePathEntryDownCommand}"/>
                                </controls:WrapPanel>
                            </StackPanel>
                        </StackPanel>
                        <TextBox Header="{x:Bind ViewModel.ValueLabel, Mode=OneWay}" Text="{x:Bind ViewModel.VariableValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind ViewModel.ShowRawValue, Mode=OneWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="170" MaxHeight="300" FontFamily="Consolas" IsEnabled="{x:Bind ViewModel.CanWrite, Mode=OneWay}"/>
                        <ToggleSwitch Header="{x:Bind ViewModel.ExpandLabel, Mode=OneWay}" IsOn="{x:Bind ViewModel.Expandable, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanWrite, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.UnsavedLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasChanges, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="8">
                            <Button Content="{x:Bind ViewModel.SaveLabel, Mode=OneWay}" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="{x:Bind ViewModel.ResetLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ResetDraftCommand}"/>
                            <Button Content="{x:Bind ViewModel.DeleteLabel, Mode=OneWay}" Command="{x:Bind ViewModel.DeleteCommand}"/>
                        </controls:WrapPanel>
                        <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
