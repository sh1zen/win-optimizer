<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:local="using:WinOptimizer.UI.Features.AdvancedTools"
      x:Class="WinOptimizer.UI.Features.AdvancedTools.ExperimentalFeaturesPage">
    <Page.Resources>
        <Style x:Key="FeatureDetailsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <DataTemplate x:Key="FeatureDetailRowTemplate" x:DataType="local:ExperimentalDetailRow">
            <Grid ColumnSpacing="12" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FeatureDetailsTemplate" x:DataType="local:ExperimentalFeatureCard" x:DefaultBindMode="OneWay">
            <ScrollViewer x:Name="DetailsScroll" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,0,12,4" Spacing="12">
                    <StackPanel Spacing="4">
                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="2">
                            <TextBlock Text="{x:Bind Presentation.Category}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind Presentation.Restart}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </controls:WrapPanel>
                        <TextBlock Text="{x:Bind Presentation.Description}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <InfoBar IsOpen="{x:Bind Presentation.RecoveryRequired}" IsClosable="False" Severity="Warning"
                             Message="{x:Bind Presentation.RecoveryNotice}"
                             Visibility="{x:Bind Presentation.RecoveryRequired, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="6">
                        <Button Content="{x:Bind Presentation.Restore.Label}" Command="{x:Bind Change, Mode=OneTime}"
                                CommandParameter="{x:Bind Presentation.Restore}"
                                AutomationProperties.HelpText="{x:Bind Presentation.Restore.HelpText}"/>
                        <Button Content="{x:Bind Presentation.Undo.Label}" Command="{x:Bind Change, Mode=OneTime}"
                                CommandParameter="{x:Bind Presentation.Undo}"
                                AutomationProperties.HelpText="{x:Bind Presentation.Undo.HelpText}"/>
                    </controls:WrapPanel>
                    <TextBlock Text="{x:Bind Presentation.ActionReasons}" TextWrapping="Wrap"
                               Visibility="{x:Bind Presentation.ActionReasonsVisibility}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Border Style="{StaticResource FeatureDetailsCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Presentation.CompatibilityEvidence}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock Text="{x:Bind Presentation.Builds}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            <TextBlock Text="{x:Bind Presentation.Prerequisite}" TextWrapping="Wrap"
                                       Visibility="{x:Bind Presentation.PrerequisiteVisibility}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ItemsControl ItemsSource="{x:Bind Presentation.Sources}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:WrapPanel HorizontalSpacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <HyperlinkButton Content="{Binding Host}" NavigateUri="{Binding}" Padding="0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{x:Bind Presentation.SharedIds}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Visibility="{x:Bind Presentation.SharedIdsVisibility}"/>
                    <ItemsControl ItemsSource="{x:Bind Presentation.FeatureIds}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ExperimentalFeatureIdDetails" x:DefaultBindMode="OneTime">
                                <Border x:Name="FeatureIdCard" Style="{StaticResource FeatureDetailsCardStyle}">
                                    <StackPanel Spacing="6">
                                        <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="2">
                                            <TextBlock Text="{x:Bind Id}" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold"
                                                       IsTextSelectionEnabled="True" AutomationProperties.HeadingLevel="Level2"/>
                                            <TextBlock Text="{x:Bind Role}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Visibility="{x:Bind RoleVisibility}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </controls:WrapPanel>
                                        <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource FeatureDetailRowTemplate}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">
            <common:PageHeader x:Name="Heading" Icon="Beaker"/>
            <TextBlock x:Name="WindowsText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
            <controls:WrapPanel x:Name="Toolbar" HorizontalAlignment="Right" HorizontalSpacing="8" VerticalSpacing="8">
                <TextBox x:Name="SearchBox" Width="230" VerticalAlignment="Center" TextChanged="SearchChanged"/>
                <Button x:Name="RefreshButton" VerticalAlignment="Center" Click="RefreshClicked"/>
                <Button x:Name="ImportProfilesButton" VerticalAlignment="Center" Click="ImportProfilesClicked"/>
                <Button x:Name="CancelButton" VerticalAlignment="Center" Click="CancelClicked" Visibility="Collapsed"/>
                <ProgressRing x:Name="Progress" Width="24" Height="24" VerticalAlignment="Center" Visibility="Collapsed"/>
            </controls:WrapPanel>
            <InfoBar x:Name="Notice" IsClosable="False" Visibility="Collapsed"/>
            <TextBlock x:Name="Report" Visibility="Collapsed" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            <ItemsControl x:Name="Catalog" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ExperimentalFeatureCard" x:DefaultBindMode="OneWay">
                        <Border Style="{StaticResource PageCardStyle}" Padding="14,12" CornerRadius="12">
                            <Grid SizeChanged="FeatureHeaderSizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="FeatureSummary" Grid.ColumnSpan="2" Spacing="4">
                                    <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="2">
                                        <TextBlock Text="{x:Bind Presentation.Name}" FontSize="16" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                                        <TextBlock Text="{x:Bind Presentation.Category}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </controls:WrapPanel>
                                    <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="2">
                                        <TextBlock Text="{x:Bind Presentation.Configured}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind Presentation.Runtime}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind Presentation.Restart}" TextWrapping="Wrap"/>
                                    </controls:WrapPanel>
                                    <TextBlock Text="{x:Bind Presentation.CompatibilityNotice}" TextWrapping="Wrap"
                                               Visibility="{x:Bind Presentation.CompatibilityNoticeVisibility}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <controls:WrapPanel x:Name="PrimaryActions" Grid.Row="1" Grid.ColumnSpan="2"
                                                    Margin="0,8,0,0" VerticalAlignment="Center"
                                                    HorizontalSpacing="6" VerticalSpacing="6">
                                    <Button Content="{x:Bind Presentation.Enable.Label}" Command="{x:Bind Change, Mode=OneTime}"
                                            CommandParameter="{x:Bind Presentation.Enable}"
                                            AutomationProperties.HelpText="{x:Bind Presentation.Enable.HelpText}"/>
                                    <Button Content="{x:Bind Presentation.Disable.Label}" Command="{x:Bind Change, Mode=OneTime}"
                                            CommandParameter="{x:Bind Presentation.Disable}"
                                            AutomationProperties.HelpText="{x:Bind Presentation.Disable.HelpText}"/>
                                    <Button x:Name="DetailsButton" Content="{x:Bind Presentation.DetailsLabel}"
                                            CommandParameter="{x:Bind Mode=OneTime}" Click="DetailsClicked"/>
                                </controls:WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoMatches" Visibility="Collapsed" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
