<Page x:Class="WinOptimizer.UI.Features.Optimize.Pages.FeaturesOptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinOptimizer.UI.Features.Optimize.ViewModels"
    xmlns:common="using:WinOptimizer.UI.Features.Common.Controls" x:DefaultBindMode="OneWay">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">
            <TextBlock Text="{x:Bind ViewModel.SectionTitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <common:PageHeader Title="{x:Bind ViewModel.Title}" Description="{x:Bind ViewModel.Description}" Icon="Apps"/>
            <InfoBar IsOpen="{x:Bind ViewModel.ShowModeNotice}" Message="{x:Bind ViewModel.ModeNotice}" IsClosable="False"/>
            <InfoBar IsOpen="{x:Bind ViewModel.HasStatus}" Message="{x:Bind ViewModel.Status}" Severity="{x:Bind ViewModel.StatusSeverity}" IsClosable="False"/>
            <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsBusy}"/>
            <Button Content="{x:Bind ViewModel.RefreshLabel}" Command="{x:Bind ViewModel.RefreshCommand}"/>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Choices}" IsEnabled="{x:Bind ViewModel.CanWrite}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:FeatureOptimizationChoice">
                    <Border Style="{StaticResource PageCardStyle}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="12">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind Description, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                IsOn="{x:Bind IsOn, Mode=OneWay}" IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" Toggled="Feature_Toggled"
                                OnContent="" OffContent="" MinWidth="0"/>
                        </Grid>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
