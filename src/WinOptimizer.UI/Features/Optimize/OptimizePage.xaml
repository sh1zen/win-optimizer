<Page x:Class="WinOptimizer.UI.Features.Optimize.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
    NavigationCacheMode="Enabled">
    <common:SectionPageView x:Name="SectionView">
        <common:SectionPageView.OverviewFooter>
            <StackPanel Spacing="{StaticResource PageCardSpacing}">
                <common:NavigationCard Title="{x:Bind Network.Title, Mode=OneWay}" Description="{x:Bind Network.ControlsLabel, Mode=OneWay}" Click="Network_Click">
                    <common:NavigationCard.Icon><FontIcon Glyph="&#xE774;"/></common:NavigationCard.Icon>
                </common:NavigationCard>
                <common:NavigationCard Title="{x:Bind Features.Title, Mode=OneWay}" Description="{x:Bind Features.Description, Mode=OneWay}" Click="Features_Click">
                    <common:NavigationCard.Icon><FontIcon Glyph="&#xE713;"/></common:NavigationCard.Icon>
                </common:NavigationCard>
            </StackPanel>
        </common:SectionPageView.OverviewFooter>
    </common:SectionPageView>
</Page>
