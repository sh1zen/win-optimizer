<UserControl x:Class="WinOptimizer.UI.Features.Extensions.Notch.NotchQuickSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="QuickSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" Padding="0,0,4,2">
            <StackPanel.Resources>
                <Style x:Key="QuickButton" TargetType="Button">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="MinHeight" Value="34"/>
                    <Setter Property="Padding" Value="5,4"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="FontSize" Value="12"/>
                </Style>
                <Style x:Key="QuickToggle" TargetType="ToggleButton">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                    <Setter Property="MinHeight" Value="34"/>
                    <Setter Property="Padding" Value="5,4"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="FontSize" Value="12"/>
                </Style>
            </StackPanel.Resources>
            <Grid ColumnSpacing="10" RowSpacing="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <FontIcon Glyph="&#xE706;" FontSize="17" AutomationProperties.AccessibilityView="Raw"/>
                <Slider x:Name="Brightness" Grid.Column="1" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10"
                        IsEnabled="False" IsThumbToolTipEnabled="False" ValueChanged="OnBrightnessChanged"/>
                <TextBlock x:Name="BrightnessValue" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                <FontIcon Grid.Row="1" Glyph="&#xE767;" FontSize="17" AutomationProperties.AccessibilityView="Raw"/>
                <Slider x:Name="Volume" Grid.Row="1" Grid.Column="1" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10"
                        IsEnabled="False" IsThumbToolTipEnabled="False" ValueChanged="OnVolumeChanged"/>
                <TextBlock x:Name="VolumeValue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
            </Grid>
            <Grid x:Name="RadioSettings" ColumnSpacing="5">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.2*"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="WiFi" Checked="OnWiFi" Unchecked="OnWiFi" Style="{StaticResource QuickToggle}"/>
                <ToggleButton x:Name="Bluetooth" Grid.Column="1" Checked="OnBluetooth" Unchecked="OnBluetooth" Style="{StaticResource QuickToggle}"/>
                <ToggleButton x:Name="NightLight" Grid.Column="2" IsEnabled="False" Checked="OnNightLight" Unchecked="OnNightLight"
                              Style="{StaticResource QuickToggle}"/>
                <ToggleButton x:Name="DoNotDisturb" Grid.Column="3" IsEnabled="False" Checked="OnDoNotDisturb" Unchecked="OnDoNotDisturb"
                              Style="{StaticResource QuickToggle}">
                    <TextBlock x:Name="DoNotDisturbLabel" TextWrapping="Wrap" TextAlignment="Center"/>
                </ToggleButton>
                <ToggleButton x:Name="Mute" Grid.Column="4" Checked="OnMute" Unchecked="OnMute" Style="{StaticResource QuickToggle}"/>
            </Grid>
            <Grid x:Name="PowerModes" ColumnSpacing="5">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="BatteryColumn" Width="Auto"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel x:Name="Battery" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="&#xEBA7;" FontSize="17" Foreground="#71DDA2" AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock x:Name="BatteryValue" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="100"/>
                </StackPanel>
                <ToggleButton x:Name="Efficiency" Grid.Column="1" Checked="OnEfficiency" Unchecked="OnEfficiency" Style="{StaticResource QuickToggle}"/>
                <ToggleButton x:Name="Balanced" Grid.Column="2" Checked="OnBalanced" Unchecked="OnBalanced" Style="{StaticResource QuickToggle}"/>
                <ToggleButton x:Name="Performance" Grid.Column="3" Checked="OnPerformance" Unchecked="OnPerformance" Style="{StaticResource QuickToggle}"/>
                <Button x:Name="PowerSettings" Grid.Column="1" Grid.ColumnSpan="3" Click="OnPowerSettings" Style="{StaticResource QuickButton}"/>
            </Grid>
            <TextBlock x:Name="SettingsError" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
