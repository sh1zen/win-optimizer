<Window x:Class="WinOptimizer.UI.Features.Extensions.Notch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:WinOptimizer.UI.Features.Extensions.Notch"
        xmlns:fluent="using:FluentIcons.WinUI"
        xmlns:common="using:WinOptimizer.UI.Features.Common.Controls" Title="Notch">
    <Grid x:Name="Root" Background="#0E0F11" RequestedTheme="Dark" FlowDirection="LeftToRight">
        <Grid.Resources>
            <SolidColorBrush x:Key="NotchInk" Color="#F6F6F7"/>
            <SolidColorBrush x:Key="NotchMuted" Color="#B6B7BC"/>
            <SolidColorBrush x:Key="NotchSurface" Color="#1B1C20"/>
            <SolidColorBrush x:Key="NotchOverviewSurface" Color="#141517"/>
            <SolidColorBrush x:Key="NotchTransparent" Color="Transparent"/>
            <SolidColorBrush x:Key="NotchShortcutSurface" Color="#27282B"/>
            <SolidColorBrush x:Key="NotchStatusIcon" Color="#9CCBF6"/>
            <SolidColorBrush x:Key="NotchStatusValue" Color="#A6D5F7"/>
            <LinearGradientBrush x:Key="NotchStatusSurface" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#1A232C" Offset="0"/>
                <GradientStop Color="#14171B" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NotchChargingAccent" Color="#57E595"/>
            <LinearGradientBrush x:Key="NotchChargingSurface" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#19271F" Offset="0"/>
                <GradientStop Color="#121716" Offset="1"/>
            </LinearGradientBrush>
            <Thickness x:Key="NotchPanelMargin">23,8,23,17</Thickness>
            <Thickness x:Key="FullShortcutsPadding">14,8,14,10</Thickness>
            <ItemsPanelTemplate x:Key="FullShortcutsLayout">
                <common:UniformWrapPanel ItemWidth="120" ItemHeight="60" ColumnSpacing="7" RowSpacing="7" MaxColumns="3" StretchItems="True"/>
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="OverviewShortcutsLayout">
                <common:UniformWrapPanel ItemWidth="75" ItemHeight="46" ColumnSpacing="4" RowSpacing="4" MaxColumns="3" StretchItems="True"/>
            </ItemsPanelTemplate>
            <Style x:Key="NotchIconButton" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource NotchMuted}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="NotchPrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource NotchInk}"/>
                <Setter Property="Foreground" Value="#141518"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="10"/>
            </Style>
            <Style x:Key="NotchTab" TargetType="RadioButton">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="TabRoot" Background="Transparent" CornerRadius="9">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters><Setter Target="TabRoot.Background" Value="#202126"/></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters><Setter Target="TabRoot.Background" Value="#303137"/></VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked"/>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="TabIcon.Foreground" Value="#FFFFFF"/>
                                                <Setter Target="SelectionLine.Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="TabIcon" Content="{TemplateBinding Content}" Foreground="#A3A4AA"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3"/>
                                <Border x:Name="SelectionLine" Width="10" Height="2" CornerRadius="1" Background="#FFFFFF" Opacity="0"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NotchDot" TargetType="RadioButton">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="DotRoot" Background="Transparent" CornerRadius="6">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters><Setter Target="DotRoot.Background" Value="#26272C"/></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters><Setter Target="DotRoot.Background" Value="#34353A"/></VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked"/>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Dot.Background" Value="#FFFFFF"/>
                                                <Setter Target="Dot.Height" Value="12"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Dot" Width="5" Height="5" Background="#72737B" CornerRadius="3"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NotchMeter" TargetType="ProgressBar">
                <Setter Property="Width" Value="32"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="4"/>
                <Setter Property="Height" Value="4"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource NotchInk}"/>
                <Setter Property="Background" Value="#47484D"/>
                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw"/>
            </Style>
            <Style x:Key="NotchCompactMetricLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource NotchMuted}"/>
            </Style>
            <Style x:Key="NotchCompactText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource NotchInk}"/>
            </Style>
        </Grid.Resources>
        <Button x:Name="Grip" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                BorderThickness="0" Padding="14,0" MinHeight="0" HorizontalContentAlignment="Center"
                UseSystemFocusVisuals="True" Click="OnExpand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="GripSurface" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"/>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="GripContent.Opacity" Value="0.8"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="GripContent" Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
            <StackPanel x:Name="CompactReadouts" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"
                        Background="Transparent" PointerPressed="OnCompactPointerPressed" PointerMoved="OnCompactPointerMoved"
                        PointerReleased="OnCompactPointerReleased" PointerCanceled="OnCompactPointerCanceled"
                        PointerCaptureLost="OnCompactPointerCanceled">
                <StackPanel.Resources>
                    <x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
                    <CornerRadius x:Key="ProgressBarTrackCornerRadius">2</CornerRadius>
                </StackPanel.Resources>
                <Border x:Name="CompactHandle" Width="21" Height="3" CornerRadius="2" Background="#707178" VerticalAlignment="Center"/>
                <StackPanel x:Name="CompactCpu" Spacing="5" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="CPU" Style="{StaticResource NotchCompactMetricLabel}"/>
                    <ProgressBar x:Name="CpuMeter" Style="{StaticResource NotchMeter}"/>
                    <TextBlock x:Name="CpuValue" Text="—" Style="{StaticResource NotchCompactText}" MinWidth="26"/>
                </StackPanel>
                <StackPanel x:Name="CompactGpu" Spacing="5" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="GPU" Style="{StaticResource NotchCompactMetricLabel}"/>
                    <ProgressBar x:Name="GpuMeter" Style="{StaticResource NotchMeter}"/>
                    <TextBlock x:Name="GpuValue" Text="—" Style="{StaticResource NotchCompactText}" MinWidth="26"/>
                </StackPanel>
                <StackPanel x:Name="CompactMemory" Spacing="5" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="RAM" Style="{StaticResource NotchCompactMetricLabel}"/>
                    <ProgressBar x:Name="MemoryMeter" Style="{StaticResource NotchMeter}"/>
                    <TextBlock x:Name="MemoryValue" Text="—" Style="{StaticResource NotchCompactText}" MinWidth="26"/>
                </StackPanel>
                <TextBlock x:Name="CompactTraffic" Text="↓ —" Style="{StaticResource NotchCompactText}" Visibility="Collapsed"/>
                <ItemsControl x:Name="CompactBatteries" VerticalAlignment="Center" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:NotchBatteryBadge">
                            <StackPanel x:Name="CompactBatteryBadge" Orientation="Horizontal" Spacing="5"
                                        VerticalAlignment="Center" Background="Transparent"
                                        ToolTipService.ToolTip="{x:Bind Description}">
                                <Border x:Name="CompactBatteryIcon" Width="22" Height="22" CornerRadius="7" Background="#18372A"
                                        VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" Foreground="#71DDA2"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="CompactBatteryLabel" Text="{x:Bind Label}" FontSize="9"
                                               LineHeight="11" LineStackingStrategy="BlockLineHeight"
                                               Foreground="{StaticResource NotchMuted}" MaxWidth="46"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                                               AutomationProperties.AccessibilityView="Raw"/>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <TextBlock x:Name="CompactBattery" Text="{x:Bind Level}" Style="{StaticResource NotchCompactText}"
                                                   FontSize="12" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                                   AutomationProperties.Name="{x:Bind Description}"/>
                                        <fluent:FluentIcon x:Name="CompactBatteryCharging" Icon="Flash" IconVariant="Filled" FontSize="10"
                                                           Foreground="#71DDA2" VerticalAlignment="Center"
                                                           Visibility="{x:Bind ChargingVisibility}" AutomationProperties.AccessibilityView="Raw"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="CompactAudioVisualizer" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel x:Name="CompactMicBadge" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE720;" FontSize="12" Foreground="#71DDA2"/>
                        <TextBlock x:Name="CompactMicrophone" Style="{StaticResource NotchCompactText}"
                                   MaxWidth="102" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel x:Name="AudioWave" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="CompactFpsStrip" Background="#15273A" CornerRadius="7" Padding="7,2"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="CompactFps" Style="{StaticResource NotchCompactText}" Foreground="#B8DEF9"/>
                </Border>
                <TextBlock x:Name="CompactTime" Style="{StaticResource NotchCompactText}" Visibility="Collapsed"/>
            </StackPanel>
        </Button>
        <Grid x:Name="Panel" Visibility="Collapsed" Background="Transparent" Margin="{StaticResource NotchPanelMargin}"
              RowSpacing="8" ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="NavigationHeader" Grid.ColumnSpan="2" Height="34">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="3">
                    <RadioButton x:Name="OverviewTab" GroupName="NotchViews" Style="{StaticResource NotchTab}" Checked="OnViewChecked">
                        <fluent:FluentIcon Icon="Grid" IconVariant="Regular" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                    </RadioButton>
                    <RadioButton x:Name="MediaTab" GroupName="NotchViews" Style="{StaticResource NotchTab}" Checked="OnViewChecked">
                        <FontIcon Glyph="&#xE8D6;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                    </RadioButton>
                    <RadioButton x:Name="FocusTab" GroupName="NotchViews" Style="{StaticResource NotchTab}" Checked="OnViewChecked">
                        <FontIcon Glyph="&#xE916;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                    </RadioButton>
                    <RadioButton x:Name="CalendarTab" GroupName="NotchViews" Style="{StaticResource NotchTab}" Checked="OnViewChecked">
                        <FontIcon Glyph="&#xE787;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                    </RadioButton>
                    <RadioButton x:Name="ShortcutsTab" GroupName="NotchViews" Style="{StaticResource NotchTab}" Checked="OnViewChecked">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                    </RadioButton>
                    <RadioButton x:Name="WeatherTab" GroupName="NotchViews" Style="{StaticResource NotchTab}" Checked="OnViewChecked">
                        <fluent:FluentIcon Icon="WeatherSunny" IconVariant="Regular" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                    </RadioButton>
                    <RadioButton x:Name="DashboardTab" GroupName="NotchViews" Style="{StaticResource NotchTab}" Checked="OnViewChecked">
                        <FontIcon Glyph="&#xE9D9;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                    </RadioButton>
                    <RadioButton x:Name="BatteriesTab" GroupName="NotchViews" Style="{StaticResource NotchTab}" Checked="OnViewChecked">
                        <FontIcon Glyph="&#xEBA7;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                    </RadioButton>
                    <RadioButton x:Name="QuickSettingsTab" GroupName="NotchViews" Style="{StaticResource NotchTab}" Checked="OnViewChecked">
                        <FontIcon Glyph="&#xE9E9;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                    </RadioButton>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                    <Button x:Name="SettingsButton" Style="{StaticResource NotchIconButton}" Click="OnOpenOptimizer">
                        <FontIcon Glyph="&#xE713;" FontSize="16"/>
                    </Button>
                    <Button x:Name="CollapseButton" Style="{StaticResource NotchIconButton}" Click="OnCollapse">
                        <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="PageRail" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <RadioButton x:Name="OverviewDot" GroupName="NotchDots" Style="{StaticResource NotchDot}" Checked="OnViewChecked"/>
                <RadioButton x:Name="MediaDot" GroupName="NotchDots" Style="{StaticResource NotchDot}" Checked="OnViewChecked"/>
                <RadioButton x:Name="FocusDot" GroupName="NotchDots" Style="{StaticResource NotchDot}" Checked="OnViewChecked"/>
                <RadioButton x:Name="CalendarDot" GroupName="NotchDots" Style="{StaticResource NotchDot}" Checked="OnViewChecked"/>
                <RadioButton x:Name="ShortcutsDot" GroupName="NotchDots" Style="{StaticResource NotchDot}" Checked="OnViewChecked"/>
                <RadioButton x:Name="WeatherDot" GroupName="NotchDots" Style="{StaticResource NotchDot}" Checked="OnViewChecked"/>
                <RadioButton x:Name="DashboardDot" GroupName="NotchDots" Style="{StaticResource NotchDot}" Checked="OnViewChecked"/>
                <RadioButton x:Name="BatteriesDot" GroupName="NotchDots" Style="{StaticResource NotchDot}" Checked="OnViewChecked"/>
                <RadioButton x:Name="QuickSettingsDot" GroupName="NotchDots" Style="{StaticResource NotchDot}" Checked="OnViewChecked"/>
            </StackPanel>
            <Grid x:Name="Viewport" Grid.Row="1" Background="Transparent" SizeChanged="OnViewportSizeChanged">
                <Grid.Clip><RectangleGeometry x:Name="PageClip"/></Grid.Clip>
                <Grid x:Name="PageContent">
                    <Grid.RenderTransform><TranslateTransform x:Name="PageMotion"/></Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="LeadRow" Height="*"/>
                        <RowDefinition x:Name="DetailRow" Height="0"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="DetailColumn" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="MediaPanel" ColumnSpacing="17" RowSpacing="10" VerticalAlignment="Center"
                          Margin="0,0,9,0" CornerRadius="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ArtworkFrame" Width="91" Height="91" CornerRadius="15" Background="{StaticResource NotchSurface}">
                            <Grid>
                                <FontIcon Glyph="&#xE8D6;" FontSize="28" Foreground="{StaticResource NotchMuted}"/>
                                <Image x:Name="Artwork" Stretch="UniformToFill"/>
                                  <Border x:Name="MediaWaveFrame" Background="#D0181B22" CornerRadius="6" Padding="4,2"
                                          HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                          Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                      <StackPanel x:Name="MediaWave" Height="16" Orientation="Horizontal" Spacing="1"/>
                                  </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock x:Name="TrackTitle" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TrackArtist" Foreground="{StaticResource NotchMuted}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <StackPanel x:Name="MediaTransport" Orientation="Horizontal" Spacing="10" Margin="0,5,0,0">
                                <Button x:Name="PreviousButton" Style="{StaticResource NotchIconButton}" Click="OnPrevious"><SymbolIcon Symbol="Previous"/></Button>
                                <Button x:Name="PlaybackButton" Style="{StaticResource NotchPrimaryButton}" Width="41" Height="32" Padding="0" Click="OnPlayback">
                                    <Button.Resources>
                                        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="NotchSurface"/>
                                        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#82848A"/>
                                    </Button.Resources>
                                    <SymbolIcon x:Name="PlaybackIcon" Symbol="Play"/>
                                </Button>
                                <Button x:Name="NextButton" Style="{StaticResource NotchIconButton}" Click="OnNext"><SymbolIcon Symbol="Next"/></Button>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ProgressBar x:Name="Progress" Foreground="{StaticResource NotchInk}" Background="#44454A"/>
                              <Slider x:Name="TrackSeek" Minimum="0" Maximum="1" StepFrequency="1"
                                      SmallChange="5" LargeChange="15" MinHeight="0" Margin="0,-3,0,0" IsThumbToolTipEnabled="False"
                                      Visibility="Collapsed" ValueChanged="OnMediaSeekChanged"/>
                            <TextBlock x:Name="PositionText" Grid.Row="1" Foreground="{StaticResource NotchMuted}" FontSize="11"/>
                            <TextBlock x:Name="DurationText" Grid.Row="1" Foreground="{StaticResource NotchMuted}" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                    <Grid x:Name="FocusPanel" Visibility="Collapsed" ColumnSpacing="17" VerticalAlignment="Center" Margin="0,0,9,0" CornerRadius="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource NotchSurface}" CornerRadius="16" Padding="15,10">
                            <StackPanel VerticalAlignment="Center" Spacing="5">
                                <TextBlock x:Name="Remaining" FontSize="45" FontWeight="SemiLight" HorizontalAlignment="Center"/>
                                <ProgressBar x:Name="FocusProgress" Foreground="{StaticResource NotchInk}" Background="#45464C"/>
                                <TextBlock x:Name="Sessions" Foreground="{StaticResource NotchMuted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="FocusControls" Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                            <ComboBox x:Name="Phase" SelectionChanged="OnPhaseChanged" HorizontalAlignment="Stretch"/>
                            <NumberBox x:Name="TimerMinutes" Minimum="1" Maximum="180" Value="5" SpinButtonPlacementMode="Compact"
                                       Visibility="Collapsed" ValueChanged="OnTimerDurationChanged"/>
                            <StackPanel x:Name="FocusButtons" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="TimerToggle" Style="{StaticResource NotchPrimaryButton}" Click="OnTimerToggle"/>
                                <Button x:Name="TimerReset" Click="OnTimerReset" CornerRadius="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="CalendarPage" Visibility="Collapsed" ColumnSpacing="12" CornerRadius="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="CalendarDateColumn" Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TodayButton" Click="OnCalendarToday" Background="{StaticResource NotchSurface}" BorderThickness="0"
                                CornerRadius="15" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="10"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="TodayLabel" Foreground="{StaticResource NotchMuted}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TodayDay" FontSize="39" FontWeight="Light" TextAlignment="Center"/>
                                <TextBlock x:Name="TodayWeekday" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TodayMonth" Foreground="{StaticResource NotchMuted}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <Grid x:Name="CalendarHost" Grid.Column="1">
                            <CalendarView x:Name="CalendarPanel" SelectionMode="None" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="{StaticResource NotchSurface}" BorderThickness="0" CornerRadius="15"
                                          CalendarItemCornerRadius="7" TodayBackground="{StaticResource NotchInk}" TodayForeground="#151619"
                                          TodayHoverBackground="#DDDDE1" TodayPressedBackground="#C9C9CD" TodayFontWeight="SemiBold"
                                          OutOfScopeForeground="#7D7E86" DayItemFontSize="11" DayItemMargin="1">
                                <CalendarView.CalendarViewDayItemStyle>
                                    <Style TargetType="CalendarViewDayItem">
                                        <Setter Property="MinWidth" Value="25"/>
                                        <Setter Property="MinHeight" Value="20"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </CalendarView.CalendarViewDayItemStyle>
                                <CalendarView.Resources>
                                    <Thickness x:Key="CalendarViewWeekDayPadding">3,4</Thickness>
                                    <Thickness x:Key="CalendarViewHeaderNavigationButtonMargin">6,3,2,3</Thickness>
                                    <Thickness x:Key="CalendarViewHeaderNavigationButtonPadding">5,4</Thickness>
                                    <Thickness x:Key="CalendarViewNavigationButtonPadding">6,4</Thickness>
                                </CalendarView.Resources>
                            </CalendarView>
                        </Grid>
                    </Grid>
                    <Border x:Name="ShortcutsCard" Visibility="Collapsed" CornerRadius="14"
                            Background="{StaticResource NotchSurface}" Padding="{StaticResource FullShortcutsPadding}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="ShortcutsHeader" ColumnSpacing="6" MinHeight="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ShortcutsHeading" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel x:Name="ShortcutActions" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="EditShortcuts" Click="OnEditShortcuts" Padding="8,3" Height="30"/>
                                    <Button x:Name="AddShortcut" Click="OnAddShortcut" Style="{StaticResource NotchIconButton}">
                                        <FontIcon Glyph="&#xE7C3;" FontSize="14"/>
                                    </Button>
                                    <Button x:Name="ShareToPhone" Click="OnShareToPhone" Style="{StaticResource NotchIconButton}">
                                        <FontIcon Glyph="&#xE8EA;" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer x:Name="ShortcutsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Disabled">
                                <StackPanel x:Name="ShortcutsBody" Spacing="8">
                                    <TextBlock x:Name="ShortcutsStatus" TextWrapping="Wrap" Foreground="{StaticResource NotchMuted}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <StackPanel x:Name="AppPicker" Visibility="Collapsed" Spacing="8">
                                        <ComboBox x:Name="AppChoice" DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                                                  MaxDropDownHeight="145" IsEnabled="False" SelectionChanged="OnAppChoiceChanged"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button x:Name="ConfirmApp" Click="OnConfirmApp" IsEnabled="False"/>
                                            <Button x:Name="CancelApp" Click="OnCancelApp"/>
                                            <ProgressRing x:Name="AppPickerProgress" Width="20" Height="20"/>
                                        </StackPanel>
                                        <TextBlock x:Name="AppPickerStatus" TextWrapping="Wrap" Foreground="{StaticResource NotchMuted}"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                    <ItemsControl x:Name="ShortcutItems" ItemsPanel="{StaticResource FullShortcutsLayout}">
                                        <ItemsControl.Resources>
                                            <DataTemplate x:Key="ShortcutPinTemplate" x:DataType="local:NotchShortcutTile">
                                                <Grid>
                                                    <Button Tag="{x:Bind Shortcut}" Click="OnOpenShortcut" IsEnabled="{x:Bind CanOpen}"
                                                            ToolTipService.ToolTip="{x:Bind Hint}" AutomationProperties.Name="{x:Bind Shortcut.Name}"
                                                            Background="{x:Bind Surface}" BorderThickness="0" HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="9,6" CornerRadius="12">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="24" Height="24" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                                                <FontIcon Glyph="{x:Bind Shortcut.Glyph}" FontSize="20" Foreground="#9AB9FA"/>
                                                                <Image Tag="{x:Bind Shortcut}" Loaded="OnShortcutIconLoaded" />
                                                            </Grid>
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Shortcut.Name}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button x:Name="RemoveShortcut" Tag="{x:Bind Shortcut}" Click="OnRemoveShortcut"
                                                            Visibility="{x:Bind RemoveVisibility}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Width="24" Height="24" Margin="0,2,2,0" ToolTipService.ToolTip="{x:Bind RemoveLabel}"
                                                            AutomationProperties.Name="{x:Bind RemoveLabel}" Style="{StaticResource NotchIconButton}">
                                                        <FontIcon Glyph="&#xE711;" FontSize="10"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="ShortcutAddTemplate">
                                                <Button x:Name="AddFavoriteApp" Click="OnAddFavoriteApp" AutomationProperties.Name="{Binding}"
                                                        Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="0" CornerRadius="12">
                                                    <Grid AutomationProperties.AccessibilityView="Raw">
                                                        <Rectangle RadiusX="12" RadiusY="12" Stroke="#76777C" StrokeDashArray="4,3"/>
                                                        <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="{StaticResource NotchMuted}"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.Resources>
                                        <ItemsControl.ItemTemplateSelector>
                                            <local:NotchShortcutTemplateSelector PinTemplate="{StaticResource ShortcutPinTemplate}"
                                                                                AddTemplate="{StaticResource ShortcutAddTemplate}"/>
                                        </ItemsControl.ItemTemplateSelector>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border x:Name="WeatherPage" Background="{StaticResource NotchSurface}" CornerRadius="16" Padding="18,8"
                            Visibility="Collapsed">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid x:Name="WeatherDetails" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="0,0,64,0"
                                      RowSpacing="2" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition x:Name="WeatherReadingRow" Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="WeatherPlace" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="WeatherCondition" Foreground="{StaticResource NotchMuted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock x:Name="WeatherTemperature" Grid.Row="1" FontSize="39" FontWeight="Light" VerticalAlignment="Bottom"/>
                                </Grid>
                                <ContentControl x:Name="WeatherSymbol" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"/>
                                <HyperlinkButton x:Name="WeatherSource" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                 MinWidth="0" MinHeight="0" Padding="5" Foreground="{StaticResource NotchMuted}"
                                                 NavigateUri="https://open-meteo.com/en/licence" AutomationProperties.Name="Open-Meteo"
                                                 Visibility="Collapsed">
                                    <fluent:FluentIcon Icon="Info" IconVariant="Regular" FontSize="12" AutomationProperties.AccessibilityView="Raw"/>
                                </HyperlinkButton>
                                <StackPanel x:Name="WeatherHourly" Grid.Row="1" Grid.Column="1" Spacing="3" Width="224"
                                            Visibility="Collapsed">
                                    <TextBlock x:Name="WeatherHourlyHeading" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NotchMuted}"/>
                                    <Grid x:Name="WeatherHours" ColumnSpacing="4"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="WeatherWeekly" Grid.Row="1" Spacing="3" Margin="0,0,0,4" Visibility="Collapsed">
                                <Border Height="1" Margin="0,0,0,3" Background="{StaticResource NotchShortcutSurface}"/>
                                <TextBlock x:Name="WeatherWeeklyHeading" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NotchMuted}"/>
                                <Grid x:Name="WeatherDays" ColumnSpacing="4"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <local:NotchDashboard x:Name="DashboardPanel" Visibility="Collapsed"/>
                    <local:NotchBatteriesPanel x:Name="BatteriesPanel" Visibility="Collapsed"/>
                    <local:NotchQuickSettings x:Name="QuickSettingsPanel" Visibility="Collapsed"/>
                    <TextBlock x:Name="EmptyPanel" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource NotchMuted}"/>
                </Grid>
                <TextBlock x:Name="OverviewHint" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="15,0" Foreground="{StaticResource NotchMuted}"/>
                <Border x:Name="OverviewStatus" Visibility="Collapsed" VerticalAlignment="Bottom" Padding="8" CornerRadius="8"
                        Background="{StaticResource NotchSurface}" IsHitTestVisible="False">
                    <TextBlock x:Name="OverviewError" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </Border>
            </Grid>
        </Grid>
        <Border x:Name="StatusBanner" Width="284" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="8" Padding="9,0" CornerRadius="12"
                IsHitTestVisible="False" Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="StatusIcon" FontSize="20" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock x:Name="StatusLabel" Grid.Column="1" Style="{StaticResource NotchCompactText}" FontSize="13"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Name="StatusLevel" Grid.Column="1" Height="3" MinWidth="0" Value="0" Maximum="100"
                             VerticalAlignment="Bottom" Margin="0,0,0,5" Foreground="{StaticResource NotchStatusIcon}"
                             Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock x:Name="StatusValue" Grid.Column="2" Style="{StaticResource NotchCompactText}" FontSize="13"/>
            </Grid>
        </Border>
    </Grid>
</Window>
