<UserControl x:Class="WinOptimizer.UI.Features.Extensions.Notch.NotchModuleSettingsList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:WinOptimizer.UI.Features.Extensions.Notch"
             xmlns:fluent="using:FluentIcons.WinUI"
             xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <ItemsControl x:Name="ModuleList">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="{StaticResource PageCardSpacing}"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:NotchModuleOption">
                <controls:SettingsCard Header="{x:Bind Title, Mode=OneWay}" Description="{x:Bind Description, Mode=OneWay}"
                                       Style="{StaticResource PageSettingsCardStyle}">
                    <controls:SettingsCard.HeaderIcon>
                        <fluent:SymbolIcon Symbol="{x:Bind Icon}" IconVariant="Regular" FontSize="20"/>
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ToggleButton x:Name="CompactPin" Tag="{x:Bind}" IsChecked="{x:Bind IsPinned, Mode=OneWay}"
                                      IsEnabled="{x:Bind CanEditPin, Mode=OneWay}" Padding="8" VerticalAlignment="Center"
                                      Visibility="{x:Bind IsPinnable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      ToolTipService.ToolTip="{x:Bind PinLabel, Mode=OneWay}"
                                      AutomationProperties.Name="{x:Bind PinLabel, Mode=OneWay}"
                                      Checked="OnCompactPinToggled" Unchecked="OnCompactPinToggled">
                            <fluent:FluentIcon Icon="Pin" IconVariant="Regular" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                        </ToggleButton>
                        <ToggleSwitch Tag="{x:Bind}" IsOn="{x:Bind IsEnabled, Mode=OneWay}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                      AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" Toggled="OnModuleToggled"/>
                    </StackPanel>
                </controls:SettingsCard>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
