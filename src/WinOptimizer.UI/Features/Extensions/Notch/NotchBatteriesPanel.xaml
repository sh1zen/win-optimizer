<UserControl x:Class="WinOptimizer.UI.Features.Extensions.Notch.NotchBatteriesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:WinOptimizer.UI.Features.Extensions.Notch"
             xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
             xmlns:fluent="using:FluentIcons.WinUI">
    <Grid>
        <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <ItemsControl x:Name="BatteryCards" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <common:UniformWrapPanel ItemWidth="168" ItemHeight="68" MaxColumns="2" StretchItems="True" RowSpacing="7" ColumnSpacing="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:NotchBatteryBadge">
                        <Border Background="#1B1C20" CornerRadius="12" Padding="12,8" AutomationProperties.Name="{x:Bind Description}">
                            <Grid ColumnSpacing="9" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" Foreground="#B6B7BC" FontSize="18" AutomationProperties.AccessibilityView="Raw"/>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{x:Bind Label}" Foreground="#B6B7BC" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{x:Bind Level}" Foreground="#F6F6F7" FontWeight="SemiBold"/>
                                        <fluent:FluentIcon x:Name="BatteryCharging" Icon="Flash" IconVariant="Filled" FontSize="12" Foreground="#57E595"
                                                           Visibility="{x:Bind ChargingVisibility}" AutomationProperties.AccessibilityView="Raw"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="EmptyMessage" Foreground="#B6B7BC" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
