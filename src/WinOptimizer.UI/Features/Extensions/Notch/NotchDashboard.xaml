<UserControl x:Class="WinOptimizer.UI.Features.Extensions.Notch.NotchDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:WinOptimizer.UI.Features.Extensions.Notch"
             xmlns:extensions="using:WinOptimizer.UI.Features.Extensions"
             xmlns:common="using:WinOptimizer.UI.Features.Common.Controls">
    <UserControl.Resources>
        <x:Int32 x:Key="ReadingColumns">2</x:Int32>
        <Style x:Key="ReadingCard" TargetType="Border">
            <Setter Property="Background" Value="#1B1C20"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="60"/>
        </Style>
        <DataTemplate x:Key="TextReading" x:DataType="local:NotchReadingRow">
            <Border Style="{StaticResource ReadingCard}">
                <StackPanel Spacing="3">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Foreground="#B6B7BC" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind Value, Mode=OneWay}" Foreground="#F6F6F7" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Visibility="{x:Bind DetailVisibility}"
                               Foreground="#B6B7BC" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="GraphReading" x:DataType="local:NotchReadingRow">
            <Border Style="{StaticResource ReadingCard}">
                <StackPanel Spacing="3">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Foreground="#B6B7BC" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}" Foreground="#F6F6F7" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                    <extensions:SystemMonitorMetricChart Section="{x:Bind Graph}" PlotOnly="True" Foreground="#F6F6F7"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer x:Name="ReadingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <ItemsControl x:Name="Readings" VerticalAlignment="Top" SizeChanged="OnReadingsSizeChanged">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <common:UniformWrapPanel ItemWidth="168" MaxColumns="{StaticResource ReadingColumns}" StretchItems="True"
                                             RowSpacing="7" ColumnSpacing="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplateSelector>
                <local:NotchReadingTemplateSelector TextTemplate="{StaticResource TextReading}" GraphTemplate="{StaticResource GraphReading}"/>
            </ItemsControl.ItemTemplateSelector>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
