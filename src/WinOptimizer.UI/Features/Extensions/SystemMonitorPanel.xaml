<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinOptimizer.UI.Features.Extensions.SystemMonitorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:popups="using:WinOptimizer.UI.Features.Common.Helpers"
    xmlns:vm="using:WinOptimizer.UI.Features.Extensions.ViewModels"
    xmlns:extensions="using:WinOptimizer.UI.Features.Extensions"
    xmlns:controls="using:WinOptimizer.UI.Features.Common.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="MonitorSurface" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EADAE2" Offset="0"/>
                        <GradientStop Color="#E2E5F0" Offset="0.55"/>
                        <GradientStop Color="#CDDDE8" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="MonitorCard" Color="#ADFFFFFF"/>
                    <SolidColorBrush x:Key="MonitorTile" Color="#12404D70"/>
                    <SolidColorBrush x:Key="MonitorOutline" Color="#25404D70"/>
                    <SolidColorBrush x:Key="MonitorInk" Color="#182C42"/>
                    <SolidColorBrush x:Key="MonitorMuted" Color="#4A5E73"/>
                    <SolidColorBrush x:Key="MonitorAccent" Color="#087E87"/>
                    <SolidColorBrush x:Key="MonitorChart" Color="#176E9D"/>
                    <SolidColorBrush x:Key="MonitorUpload" Color="#A35236"/>
                    <SolidColorBrush x:Key="MonitorTrack" Color="#284A687E"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <LinearGradientBrush x:Key="MonitorSurface" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#583743" Offset="0"/>
                        <GradientStop Color="#353648" Offset="0.52"/>
                        <GradientStop Color="#1B394D" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="MonitorCard" Color="#70161D2C"/>
                    <SolidColorBrush x:Key="MonitorTile" Color="#14EDF5FA"/>
                    <SolidColorBrush x:Key="MonitorOutline" Color="#28D6E4EF"/>
                    <SolidColorBrush x:Key="MonitorInk" Color="#F0F6FA"/>
                    <SolidColorBrush x:Key="MonitorMuted" Color="#BFCCD9"/>
                    <SolidColorBrush x:Key="MonitorAccent" Color="#6DDED9"/>
                    <SolidColorBrush x:Key="MonitorChart" Color="#6CBCE6"/>
                    <SolidColorBrush x:Key="MonitorUpload" Color="#EEAD91"/>
                    <SolidColorBrush x:Key="MonitorTrack" Color="#725C7D85"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Thickness x:Key="MonitorHorizontalInset">11,0</Thickness>
            <Style x:Key="MonitorLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="{ThemeResource MonitorMuted}"/>
            </Style>
            <Style x:Key="MonitorSectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource MonitorInk}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="MonitorSectionUnit" TargetType="TextBlock" BasedOn="{StaticResource MonitorLabel}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="MonitorTileLabel" TargetType="TextBlock" BasedOn="{StaticResource MonitorLabel}">
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="MaxLines" Value="1"/>
            </Style>
            <Style x:Key="CompactLabel" TargetType="TextBlock" BasedOn="{StaticResource MonitorLabel}">
                <Setter Property="FontSize" Value="11"/>
            </Style>
            <Style x:Key="MonitorReadingValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource MonitorInk}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="MonitorPanel" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MonitorCard}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource MonitorOutline}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="10,8"/>
            </Style>
            <Style x:Key="MonitorValueTile" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MonitorTile}"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="4,6"/>
            </Style>
            <Style x:Key="MonitorIconButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="MinWidth" Value="28"/><Setter Property="MinHeight" Value="26"/>
                <Setter Property="Padding" Value="4"/><Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Foreground" Value="{ThemeResource MonitorInk}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot">
        <Border x:Name="WidgetBackdrop" Background="{ThemeResource MonitorSurface}"/>
        <Border x:Name="PanelFrame" BorderThickness="0">
            <Grid x:Name="InstrumentLayout" RowSpacing="7" Padding="0,6">
                <Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="Auto"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                <Grid x:Name="DragHeader" Background="Transparent" Margin="{StaticResource MonitorHorizontalInset}">
                    <StackPanel x:Name="WidgetTitle" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="AccentDot" Width="5" Height="5" VerticalAlignment="Center" Fill="{ThemeResource MonitorChart}"/>
                        <TextBlock Text="SysMonitor" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource MonitorInk}"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="ReadingsViewport" Grid.Row="1" Padding="{StaticResource MonitorHorizontalInset}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ReadingsSurface" Spacing="7" Tapped="ReadingsSurface_Tapped" SizeChanged="ReadingsSurface_SizeChanged">
                        <StackPanel x:Name="CompactLayout" Spacing="10"
                                    Visibility="{x:Bind ViewModel.IsCompact, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource MonitorPanel}">
                                <StackPanel Spacing="7">
                                    <Grid ColumnSpacing="5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Viewbox Width="13" Height="13" VerticalAlignment="Center"><Canvas Width="16" Height="16">
                                            <Path Data="M4,3H12V13H4Z M1,5H4 M1,8H4 M1,11H4 M12,5H15 M12,8H15 M12,11H15 M6,1V3 M10,1V3 M6,13V15 M10,13V15"
                                                  Stroke="{ThemeResource MonitorInk}" StrokeThickness="1"/>
                                        </Canvas></Viewbox>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CpuHeadline, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MonitorInk}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CpuTemperature, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource MonitorChart}" ToolTipService.ToolTip="{x:Bind ViewModel.CpuTemperatureName, Mode=OneWay}"/>
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.CpuHistoryLabel, Mode=OneWay}" Style="{StaticResource CompactLabel}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PrimaryFanValue, Mode=OneWay}" Style="{StaticResource CompactLabel}" FontSize="10"/>
                                    </Grid>
                                    <Canvas x:Name="CompactCpuChart" Height="32" SizeChanged="CpuChart_SizeChanged"/>
                                </StackPanel>
                            </Border>
                            <Grid ColumnSpacing="7" RowSpacing="6" Margin="11,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="↓" FontSize="13" Foreground="{ThemeResource MonitorAccent}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DownloadLabel, Mode=OneWay}" Style="{StaticResource CompactLabel}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DownloadValue, Mode=OneWay}" Style="{StaticResource MonitorReadingValue}"/>
                                <TextBlock Grid.Row="1" Text="↑" FontSize="13" Foreground="{ThemeResource MonitorUpload}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.UploadLabel, Mode=OneWay}" Style="{StaticResource CompactLabel}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind ViewModel.UploadValue, Mode=OneWay}" Style="{StaticResource MonitorReadingValue}"/>
                            </Grid>
                            <StackPanel Spacing="5" Margin="11,0">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{ThemeResource MonitorInk}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MemoryLabel, Mode=OneWay}" Style="{StaticResource CompactLabel}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.MemoryUsageValue, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MonitorInk}"/>
                                </Grid>
                                <ProgressBar Value="{x:Bind ViewModel.MemoryPercent, Mode=OneWay}" Height="4" Maximum="100" CornerRadius="2"
                                             Foreground="{ThemeResource MonitorAccent}" Background="{ThemeResource MonitorTrack}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="ExpandedLayout" Spacing="7"
                                    Visibility="{x:Bind ViewModel.IsExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border x:Name="TemperaturesCard" Style="{StaticResource MonitorPanel}"
                                    Visibility="{x:Bind ViewModel.ShowTemperatures, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.TemperaturesLabel, Mode=OneWay}" Style="{StaticResource MonitorSectionTitle}"/>
                                        <TextBlock Grid.Column="1" Text="°C" Style="{StaticResource MonitorSectionUnit}"/>
                                    </Grid>
                                    <ScrollViewer MaxHeight="116" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{x:Bind ViewModel.NoTemperatures, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <ItemsControl x:Name="TemperatureTiles" ItemsSource="{x:Bind ViewModel.Temperatures}" HorizontalContentAlignment="Stretch">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:UniformWrapPanel ItemWidth="54" ItemHeight="46" ColumnSpacing="6" RowSpacing="6"
                                                                               StretchItems="True" MaxColumns="3" CenterRows="True"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MonitorSensorItem">
                                                <Border Style="{StaticResource MonitorValueTile}">
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Value}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"
                                                                   Foreground="{ThemeResource MonitorInk}"/>
                                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource MonitorTileLabel}" ToolTipService.ToolTip="{x:Bind Name}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="{x:Bind ViewModel.UnavailableLabel, Mode=OneWay}" Style="{StaticResource MonitorLabel}"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               Visibility="{x:Bind ViewModel.NoTemperatures, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="FansCard" Style="{StaticResource MonitorPanel}"
                                    Visibility="{x:Bind ViewModel.ShowFans, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.FansLabel, Mode=OneWay}" Style="{StaticResource MonitorSectionTitle}"/>
                                        <TextBlock Grid.Column="1" Text="rpm" Style="{StaticResource MonitorSectionUnit}"/>
                                    </Grid>
                                    <ScrollViewer MaxHeight="85" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{x:Bind ViewModel.NoFans, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <ItemsControl x:Name="FanDials" ItemsSource="{x:Bind ViewModel.Fans}" HorizontalContentAlignment="Stretch">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:UniformWrapPanel ItemWidth="80" ColumnSpacing="6" RowSpacing="7"
                                                                               StretchItems="True" MaxColumns="2" CenterRows="True"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MonitorSensorItem">
                                                <StackPanel Spacing="5" Padding="0,2">
                                                    <Grid Width="48" Height="48" HorizontalAlignment="Center">
                                                        <Ellipse Margin="2" Stroke="{ThemeResource MonitorTrack}" StrokeThickness="4"/>
                                                        <Path Data="M9,38 A21,21 0 1 1 39,9" Stroke="{ThemeResource MonitorAccent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        <TextBlock Text="{x:Bind Value}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource MonitorInk}"/>
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource MonitorTileLabel}" ToolTipService.ToolTip="{x:Bind Name}"/>
                                                </StackPanel>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="{x:Bind ViewModel.UnavailableLabel, Mode=OneWay}" Style="{StaticResource MonitorLabel}"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               Visibility="{x:Bind ViewModel.NoFans, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="MemoryCard" Style="{StaticResource MonitorPanel}"
                                    Visibility="{x:Bind ViewModel.ShowMemory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.MemoryLabel, Mode=OneWay}" Style="{StaticResource MonitorSectionTitle}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalMemory, Mode=OneWay}" Style="{StaticResource MonitorSectionUnit}"/>
                                    </Grid>
                                    <Border Height="6" Background="{ThemeResource MonitorTrack}" CornerRadius="3"
                                            AutomationProperties.Name="{x:Bind ViewModel.MemoryLabel, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind ViewModel.MemoryValue, Mode=OneWay}">
                                        <Grid x:Name="MemoryBar">
                                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="UsedMemoryColumn"/><ColumnDefinition x:Name="FreeMemoryColumn"/></Grid.ColumnDefinitions>
                                            <Border Background="{ThemeResource MonitorAccent}" CornerRadius="3"/>
                                        </Grid>
                                    </Border>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource MonitorValueTile}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.UsedMemoryNumber, Mode=OneWay}" Style="{StaticResource MonitorReadingValue}" TextAlignment="Center"/>
                                                <TextBlock Text="{x:Bind ViewModel.UsedLabel, Mode=OneWay}" Style="{StaticResource MonitorTileLabel}"
                                                           ToolTipService.ToolTip="{x:Bind ViewModel.UsedLabel, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource MonitorValueTile}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.FreeMemoryNumber, Mode=OneWay}" Style="{StaticResource MonitorReadingValue}" TextAlignment="Center"/>
                                                <TextBlock Text="{x:Bind ViewModel.FreeLabel, Mode=OneWay}" Style="{StaticResource MonitorTileLabel}"
                                                           ToolTipService.ToolTip="{x:Bind ViewModel.FreeLabel, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource MonitorValueTile}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.MemoryUsageValue, Mode=OneWay}" Style="{StaticResource MonitorReadingValue}" TextAlignment="Center"/>
                                                <TextBlock Text="{x:Bind ViewModel.MemoryLabel, Mode=OneWay}" Style="{StaticResource MonitorTileLabel}"
                                                           ToolTipService.ToolTip="{x:Bind ViewModel.MemoryLabel, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="HardwareMetricCards" ItemsSource="{x:Bind ViewModel.MetricSections}" HorizontalContentAlignment="Stretch"
                                          Visibility="{x:Bind ViewModel.HasVisibleMetrics, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MonitorMetricSection">
                                        <Border Style="{StaticResource MonitorPanel}" Margin="0,0,0,7"
                                                Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource MonitorSectionTitle}"/>
                                                <extensions:SystemMonitorMetricChart Section="{x:Bind}" Foreground="{ThemeResource MonitorInk}"/>
                                                <TextBlock Text="{x:Bind UnavailableLabel, Mode=OneWay}" Style="{StaticResource MonitorLabel}" TextAlignment="Center" TextWrapping="Wrap"
                                                           Visibility="{x:Bind IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="CpuReadings" Style="{StaticResource MonitorPanel}" Padding="10,5"
                                  Visibility="{x:Bind ViewModel.ShowCpu, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.CpuHeadline, Mode=OneWay}" Style="{StaticResource MonitorSectionTitle}"/>
                                    <Canvas x:Name="ExpandedCpuChart" Grid.Column="1" Height="22" SizeChanged="CpuChart_SizeChanged"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.CpuHistoryLabel, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="NetworkReadings" Style="{StaticResource MonitorPanel}" Padding="6,6"
                                  Visibility="{x:Bind ViewModel.ShowNetwork, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <TextBlock Text="↓" FontSize="12" Foreground="{ThemeResource MonitorAccent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.DownloadValue, Mode=OneWay}" Style="{StaticResource MonitorSectionTitle}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Height="12" Background="{ThemeResource MonitorOutline}"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <TextBlock Text="↑" FontSize="12" Foreground="{ThemeResource MonitorUpload}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.UploadValue, Mode=OneWay}" Style="{StaticResource MonitorSectionTitle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ErrorText" Text="{x:Bind ViewModel.Error, Mode=OneWay}" FontSize="10" TextWrapping="Wrap" Foreground="{ThemeResource MonitorInk}"
                                   Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="Footer" Grid.Row="2" Margin="{StaticResource MonitorHorizontalInset}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="3" Height="1" Background="{ThemeResource MonitorOutline}" VerticalAlignment="Top"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource MonitorIconButton}" Click="Settings_Click" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SettingsLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.SettingsLabel, Mode=OneWay}">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="12"/>
                    </Button>
                    <Button x:Name="SizeButton" Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource MonitorIconButton}" Click="Size_Click"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ExpandLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.ExpandLabel, Mode=OneWay}">
                        <Path Width="12" Height="12" Data="M0,4V0H4 M8,0H12V4 M12,8V12H8 M4,12H0V8" Stroke="{ThemeResource MonitorInk}" StrokeThickness="1"/>
                    </Button>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button x:Name="DiagnosticsButton" Style="{StaticResource MonitorIconButton}"
                                Visibility="{x:Bind ViewModel.HasNotices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.DiagnosticsLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.DiagnosticsLabel, Mode=OneWay}">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;" FontSize="12"/>
                            <popups:PopupHandler.Content><StackPanel MaxWidth="280" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.SensorHint, Mode=OneWay}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.Notices, Mode=OneWay}" TextWrapping="Wrap"/>
                            </StackPanel></popups:PopupHandler.Content>
                        </Button>
                        <Button x:Name="DisableButton" Style="{StaticResource MonitorIconButton}" Click="Disable_Click"
                                ToolTipService.ToolTip="{x:Bind ViewModel.DisableLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.DisableLabel, Mode=OneWay}">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7E8;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
