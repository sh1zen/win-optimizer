<Page
    x:Class="WinOptimizer.UI.Features.Extensions.Preview.PreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
    xmlns:local="using:WinOptimizer.UI.Features.Extensions.Preview">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">
            <common:PageHeader Title="{x:Bind PreviewTitle}" Description="{x:Bind PreviewDescription}" Icon="Eye"/>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsClosable="False" Severity="Error"/>
            <local:PreviewOptions x:Name="Options" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"/>
            <Button Content="{x:Bind ReloadLabel}" Click="OnReload" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"/>
            <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
