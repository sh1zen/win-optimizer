<Page
    x:Class="WinOptimizer.UI.Features.Dashboard.DashboardPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
    xmlns:dashboard="using:WinOptimizer.UI.Features.Dashboard"
    xmlns:fluent="using:FluentIcons.WinUI">
    <Page.Resources>
        <DataTemplate x:Key="FactTemplate" x:DataType="dashboard:DashboardFact">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="MetricTemplate" x:DataType="dashboard:DashboardMetric">
            <Border Style="{StaticResource PageCardStyle}" Padding="18">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="58" Height="58" VerticalAlignment="Center">
                        <Ellipse Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="3" Margin="2"/>
                        <ProgressRing IsIndeterminate="False" IsActive="True" Value="{x:Bind Percent, Mode=OneWay}"
                                      Width="58" Height="58" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="{x:Bind Readout, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <fluent:FluentIcon Icon="{x:Bind Icon}" IconVariant="Regular" FontSize="16" VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageGridStyle}" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <common:PageHeader Title="{x:Bind ViewModel.Heading, Mode=OneWay}" Icon="Home" DescriptionVisibility="Collapsed"/>
        <ScrollView Grid.Row="1" x:Name="OverviewScrollViewer" Padding="{StaticResource ScrollContentPadding}"
                    HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden">
            <StackPanel Spacing="16">
                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.ComputerName}" Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock Text="{x:Bind ViewModel.WindowsDescription, Mode=OneWay}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                <Button HorizontalAlignment="Right" Click="Copy_Click" IsEnabled="{x:Bind ViewModel.CanCopy, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.CopyLabel, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fluent:FluentIcon Icon="Copy" IconVariant="Regular" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                                        <TextBlock Text="{x:Bind ViewModel.CopyLabel, Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="CopyStatus" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                           MaxWidth="144" TextAlignment="Right" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     AutomationProperties.AccessibilityView="Raw"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Facts, Mode=OneWay}" ItemTemplate="{StaticResource FactTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <common:UniformWrapPanel ItemWidth="198" MaxColumns="4" StretchItems="True" RowSpacing="16" ColumnSpacing="18"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="ResourceCards" ItemsSource="{x:Bind ViewModel.Metrics}" ItemTemplate="{StaticResource MetricTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <common:UniformWrapPanel ItemWidth="205" MaxColumns="3" StretchItems="True" RowSpacing="16" ColumnSpacing="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind ViewModel.QuickActionsTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                        <ItemsControl x:Name="QuickActions" ItemsSource="{x:Bind ViewModel.Actions, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <common:UniformWrapPanel ItemWidth="132" MaxColumns="5" ItemHeight="74" StretchItems="True" RowSpacing="10" ColumnSpacing="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dashboard:DashboardAction">
                                    <Button Tag="{x:Bind}" Click="QuickAction_Click" Padding="10,12"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            IsEnabled="{x:Bind IsEnabled}"
                                            HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind Label}"
                                            CornerRadius="{StaticResource ControlCornerRadius}">
                                        <StackPanel Spacing="7">
                                            <fluent:FluentIcon Icon="{x:Bind Icon}" IconVariant="Regular" FontSize="22" HorizontalAlignment="Center"
                                                               AutomationProperties.AccessibilityView="Raw"/>
                                            <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
