<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:WinOptimizer.UI.Features.SystemInformation.ViewModels" xmlns:fluent="using:FluentIcons.WinUI" xmlns:common="using:WinOptimizer.UI.Features.Common.Controls" x:Class="WinOptimizer.UI.Features.SystemInformation.SystemInformationPage">
    <Page.Resources>
        <Style x:Key="StretchItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <DataTemplate x:Key="CategoryTemplate" x:DataType="vm:SystemInformationCategoryViewModel">
            <Grid Padding="12,9" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <fluent:FluentIcon Icon="{x:Bind Icon}" IconVariant="Regular" IconSize="Size20" FontSize="18"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="LayoutRoot" SizeChanged="LayoutRoot_SizeChanged" Style="{StaticResource PageGridStyle}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="WideLayoutTrigger"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CategoryNavigation.Visibility" Value="Visible"/>
                        <Setter Target="CategoryPicker.Visibility" Value="Collapsed"/>
                        <Setter Target="DetailsPanel.(Grid.Column)" Value="1"/>
                        <Setter Target="DetailsPanel.(Grid.ColumnSpan)" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="CompactLayoutTrigger" IsActive="True"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CategoryNavigation.Visibility" Value="Collapsed"/>
                        <Setter Target="CategoryPicker.Visibility" Value="Visible"/>
                        <Setter Target="DetailsPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="DetailsPanel.(Grid.ColumnSpan)" Value="2"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <common:PageHeader Title="{x:Bind ViewModel.Heading, Mode=OneWay}" Description="{x:Bind ViewModel.Description, Mode=OneWay}" Icon="Info" Grid.ColumnSpan="2"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="{x:Bind ViewModel.CancelLabel, Mode=OneWay}" Command="{x:Bind ViewModel.CancelCommand}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{x:Bind ViewModel.CollectedAt, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ScrollViewer Padding="{StaticResource ScrollContentPadding}" MaxHeight="80" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.HasNotices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{x:Bind ViewModel.Notices, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </ScrollViewer>
        </StackPanel>
        <Grid Grid.Row="2" ColumnSpacing="20" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="CategoryNavigation" Padding="8" Style="{StaticResource PageCardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Margin="12,8,12,0" Text="{x:Bind ViewModel.CategoriesLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ListView Padding="{StaticResource ScrollContentPadding}" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Categories}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" ItemTemplate="{StaticResource CategoryTemplate}" ItemContainerStyle="{StaticResource StretchItemStyle}" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Bind ViewModel.CategoriesLabel, Mode=OneWay}"/>
                </Grid>
            </Border>
            <Border x:Name="DetailsPanel" Grid.Column="1" Style="{StaticResource PageCardStyle}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Spacing="16">
                    <ComboBox x:Name="CategoryPicker" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Categories}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" ItemTemplate="{StaticResource CategoryTemplate}" AutomationProperties.Name="{x:Bind ViewModel.CategoriesLabel, Mode=OneWay}"/>
                    <Grid ColumnSpacing="12" Padding="0,0,0,14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <fluent:FluentIcon Icon="{x:Bind ViewModel.SelectedIcon, Mode=OneWay}" IconVariant="Regular" IconSize="Size20" FontSize="22" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    </StackPanel>
                    <ListView Padding="{StaticResource ScrollContentPadding}" x:Name="OverviewList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Overview, Mode=OneWay}" ItemContainerStyle="{StaticResource StretchItemStyle}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OverviewList_ItemClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{x:Bind ViewModel.IsOverview, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SystemInformationCategoryViewModel">
                                <Grid Padding="8,10" ColumnSpacing="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="2*" MaxWidth="200"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                                    <fluent:FluentIcon Icon="{x:Bind Icon}" IconVariant="Regular" IconSize="Size20" FontSize="18" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind CountText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="5">
                                        <TextBlock Text="{x:Bind OverviewValue, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind OverviewDetail, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="3" Glyph="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ListView Padding="{StaticResource ScrollContentPadding}" x:Name="DeviceList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.SelectedItems, Mode=OneWay}" ItemContainerStyle="{StaticResource StretchItemStyle}" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{x:Bind ViewModel.IsDetail, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SystemInformationDeviceViewModel">
                                <StackPanel Spacing="12" Margin="0,0,0,24">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.HeadingLevel="Level3"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{x:Bind Properties}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SystemInformationPropertyViewModel">
                                                <Grid Padding="12,10" ColumnSpacing="24" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MaxWidth="220"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Label, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" TextWrapping="Wrap" Margin="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.HasEmptyCategory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
