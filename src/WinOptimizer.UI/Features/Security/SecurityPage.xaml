<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinOptimizer.UI.Features.Security.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinOptimizer.UI.Features.Security" xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls" xmlns:fluent="using:FluentIcons.WinUI">
    <Page.Resources>
        <DataTemplate x:Key="SecurityCategoryTemplate" x:DataType="vm:SecurityCategoryRow">
            <StackPanel Spacing="4" Padding="8">
                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind Summary, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="LayoutRoot" Style="{StaticResource PageGridStyle}" SizeChanged="LayoutRoot_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Padding="{StaticResource ScrollContentPadding}" MaxHeight="300" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12">
                <common:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneWay}" Description="{x:Bind ViewModel.Description, Mode=OneWay}" Icon="ShieldCheckmark"/>
                <toolkit:WrapPanel x:Name="ScanActions" HorizontalSpacing="8" VerticalSpacing="8">
                    <Button Content="{x:Bind ViewModel.ScanLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ScanCommand}" Padding="20,10" Style="{StaticResource AccentButtonStyle}"/>
                    <Button Content="{x:Bind ViewModel.DeepScanLabel, Mode=OneWay}" Command="{x:Bind ViewModel.DeepScanCommand}" Padding="20,10"/>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24"/>
                </toolkit:WrapPanel>
                <InfoBar IsOpen="{x:Bind ViewModel.ShowModeNotice, Mode=OneWay}" Message="{x:Bind ViewModel.ModeNotice, Mode=OneWay}" IsClosable="False"/>
                <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" Message="{x:Bind ViewModel.Status, Mode=OneWay}" Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" IsClosable="False"/>
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource PageCardStyle}" Padding="32" Visibility="{x:Bind ViewModel.ShowIntroduction, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer Padding="{StaticResource ScrollContentPadding}" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="20" VerticalAlignment="Center" MaxWidth="620">
                <fluent:FluentIcon Icon="ShieldCheckmark" FontSize="64" HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.Intro, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid x:Name="ResultsLayout" Grid.Row="1" Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" RowSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="CategoryColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <ListView Padding="{StaticResource ScrollContentPadding}" x:Name="CategoryList" Grid.RowSpan="2" ItemsSource="{x:Bind ViewModel.Categories}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                ItemTemplate="{StaticResource SecurityCategoryTemplate}" Visibility="Collapsed" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" SelectionMode="Single" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"/>
            <ComboBox x:Name="CategoryPicker" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Categories}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                ItemTemplate="{StaticResource SecurityCategoryTemplate}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"/>
            <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource PageCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="TableHeaders" Padding="16,12" ColumnSpacing="12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.NameLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StateLabel, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.RecommendationLabel, Mode=OneWay}" TextWrapping="Wrap"/>
                    </Grid>
                    <ListView Padding="{StaticResource ScrollContentPadding}" x:Name="FindingsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Findings}" SelectionMode="None" HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.NameLabel, Mode=OneWay}">
                        <ListView.ItemTemplate><DataTemplate x:DataType="vm:SecurityFindingRow">
                            <Grid Padding="4,12" ColumnSpacing="12" RowSpacing="8" SizeChanged="FindingLayout_SizeChanged">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel x:Name="FindingContent" Grid.ColumnSpan="3" Spacing="6">
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    </CheckBox>
                                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                    <TextBlock Text="{x:Bind Evidence, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="FindingState" Grid.Column="1" Text="{x:Bind State, Mode=OneWay}" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <TextBlock x:Name="FindingRecommendation" Grid.Column="2" Text="{x:Bind Recommendation, Mode=OneWay}" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <TextBlock x:Name="CompactReview" Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Bind ReviewSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Padding="16" Style="{StaticResource PageCardStyle}" Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <toolkit:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
                <TextBlock Text="{x:Bind ViewModel.Selection, Mode=OneWay}" VerticalAlignment="Center"/>
                <Button Content="{x:Bind ViewModel.SelectAllLabel, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAllCommand}"/>
                <Button Content="{x:Bind ViewModel.FixLabel, Mode=OneWay}" Command="{x:Bind ViewModel.FixCommand}" Style="{StaticResource AccentButtonStyle}"/>
            </toolkit:WrapPanel>
        </Border>
    </Grid>
</Page>
