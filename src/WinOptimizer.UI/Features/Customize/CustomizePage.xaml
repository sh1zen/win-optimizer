<Page x:Class="WinOptimizer.UI.Features.Customize.CustomizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
    NavigationCacheMode="Enabled">
    <common:SectionPageView x:Name="SectionView">
        <common:SectionPageView.OverviewFooter>
            <common:NavigationCard Title="{x:Bind ContextMenus.Title, Mode=OneWay}"
                Description="{x:Bind ContextMenus.Description, Mode=OneWay}" Click="ContextMenus_Click">
                <common:NavigationCard.Icon><FontIcon Glyph="&#xE8A5;"/></common:NavigationCard.Icon>
            </common:NavigationCard>
        </common:SectionPageView.OverviewFooter>
    </common:SectionPageView>
</Page>
