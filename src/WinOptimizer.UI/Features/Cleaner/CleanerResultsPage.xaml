<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fluent="using:FluentIcons.WinUI"
      xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
      xmlns:vm="using:WinOptimizer.UI.Features.Cleaner.ViewModels"
      x:Class="WinOptimizer.UI.Features.Cleaner.CleanerResultsPage">
    <Page.Resources>
        <Style x:Key="ReportCardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CornerRadius" Value="{StaticResource PageSurfaceCornerRadius}"/>
            <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AppSurfaceStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ReportMetricCardStyle" TargetType="Border" BasedOn="{StaticResource PageCardStyle}">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
        </Style>
        <Style x:Key="ReportMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="ReportMetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <DataTemplate x:Key="CategoryDetailsTemplate" x:DataType="vm:CleanerCategoryReport">
            <ScrollViewer x:Name="CategoryDetailsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12" Padding="0,0,8,0">
                    <Border CornerRadius="{StaticResource OverlayCornerRadius}" Padding="14"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <fluent:FluentIcon Icon="{x:Bind Icon}" FontSize="24" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="CategoryDetailsOverview" Grid.Column="1" Text="{x:Bind Overview, Mode=OneWay}"
                                       FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Grid>
                    </Border>
                    <common:UniformWrapPanel ItemWidth="126" MaxColumns="3" StretchItems="True" ColumnSpacing="8" RowSpacing="8">
                        <Border Style="{StaticResource ReportMetricCardStyle}"><StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind FoundCount}" Style="{StaticResource ReportMetricValueStyle}"/>
                            <TextBlock Text="{x:Bind FoundLabel, Mode=OneWay}" Style="{StaticResource ReportMetricLabelStyle}"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource ReportMetricCardStyle}"><StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind SelectedCount, Mode=OneWay}" Style="{StaticResource ReportMetricValueStyle}"/>
                            <TextBlock Text="{x:Bind SelectedLabel, Mode=OneWay}" Style="{StaticResource ReportMetricLabelStyle}"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource ReportMetricCardStyle}"><StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind CompletedCount, Mode=OneWay}" Style="{StaticResource ReportMetricValueStyle}"/>
                            <TextBlock Text="{x:Bind CompletedLabel, Mode=OneWay}" Style="{StaticResource ReportMetricLabelStyle}"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource ReportMetricCardStyle}"><StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind RemovedCount, Mode=OneWay}" Style="{StaticResource ReportMetricValueStyle}"/>
                            <TextBlock Text="{x:Bind RemovedLabel, Mode=OneWay}" Style="{StaticResource ReportMetricLabelStyle}"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource ReportMetricCardStyle}"><StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind FailedCount, Mode=OneWay}" Style="{StaticResource ReportMetricValueStyle}"/>
                            <TextBlock Text="{x:Bind FailedLabel, Mode=OneWay}" Style="{StaticResource ReportMetricLabelStyle}"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource ReportMetricCardStyle}"><StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind UnprocessedCount, Mode=OneWay}" Style="{StaticResource ReportMetricValueStyle}"/>
                            <TextBlock Text="{x:Bind UnprocessedLabel, Mode=OneWay}" Style="{StaticResource ReportMetricLabelStyle}"/>
                        </StackPanel></Border>
                    </common:UniformWrapPanel>
                    <Border x:Name="CategoryFileSpace" Style="{StaticResource ReportMetricCardStyle}"
                            Visibility="{x:Bind HasFileSelection, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind FreedSize, Mode=OneWay}" Style="{StaticResource ReportMetricValueStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Bind FreedLabel, Mode=OneWay}" Style="{StaticResource ReportMetricLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CategoryRegistryData" Style="{StaticResource ReportMetricCardStyle}"
                            Visibility="{x:Bind HasRegistrySelection, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind RegistrySize, Mode=OneWay}" Style="{StaticResource ReportMetricValueStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Bind RegistryLabel, Mode=OneWay}" Style="{StaticResource ReportMetricLabelStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="LayoutRoot" SizeChanged="LayoutRoot_SizeChanged" Style="{StaticResource PageGridStyle}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="WideLayoutTrigger"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SummaryColumn2.Width" Value="*"/>
                        <Setter Target="OutcomeMetrics.(Grid.Row)" Value="0"/>
                        <Setter Target="OutcomeMetrics.(Grid.Column)" Value="1"/>
                        <Setter Target="SummaryPanel.ColumnSpacing" Value="{StaticResource PageCardSpacing}"/>
                        <Setter Target="SummaryPanel.RowSpacing" Value="0"/>
                        <Setter Target="SelectionActions.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="ApplyAction.(Grid.Row)" Value="0"/>
                        <Setter Target="ApplyAction.(Grid.Column)" Value="1"/>
                        <Setter Target="ApplyAction.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="ApplyAction.HorizontalAlignment" Value="Right"/>
                        <Setter Target="ActionLayout.RowSpacing" Value="0"/>
                        <Setter Target="CategoryColumn.Width" Value="280"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="CompactLayoutTrigger" IsActive="True"/></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <common:PageHeader x:Name="ResultsHeader" Title="{x:Bind ViewModel.ReportTitle, Mode=OneWay}"
                                   Description="{x:Bind ViewModel.ReportDescription, Mode=OneWay}" Icon="Broom"/>
                <Button x:Name="RescanAction" Grid.Column="1" Command="{x:Bind ViewModel.ScanCommand}" Content="{x:Bind ViewModel.ScanLabel, Mode=OneWay}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="StatusText" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       Visibility="{x:Bind ViewModel.HasScanStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Grid x:Name="SummaryPanel" RowSpacing="{StaticResource PageCardSpacing}"
                  Visibility="{x:Bind ViewModel.HasSummary, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SummaryColumn2" Width="0"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid ColumnSpacing="{StaticResource PageCardSpacing}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Padding="16" Style="{StaticResource PageCardStyle}"><StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}" Style="{StaticResource ReportMetricValueStyle}" FontSize="28"/>
                        <TextBlock Text="{x:Bind ViewModel.FoundLabel, Mode=OneWay}" Style="{StaticResource ReportMetricLabelStyle}"/>
                    </StackPanel></Border>
                    <Border Grid.Column="1" Padding="16" Style="{StaticResource PageCardStyle}"><StackPanel Spacing="4">
                        <TextBlock x:Name="OutcomeCount" Text="{x:Bind ViewModel.OutcomeCount, Mode=OneWay}" Style="{StaticResource ReportMetricValueStyle}" FontSize="28"/>
                        <TextBlock Text="{x:Bind ViewModel.OutcomeLabel, Mode=OneWay}" Style="{StaticResource ReportMetricLabelStyle}"/>
                    </StackPanel></Border>
                </Grid>
                <Grid x:Name="OutcomeMetrics" Grid.Row="1" ColumnSpacing="{StaticResource PageCardSpacing}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Padding="16" Style="{StaticResource PageCardStyle}"><StackPanel Spacing="4">
                        <TextBlock x:Name="IssueCount" Text="{x:Bind ViewModel.IssueCount, Mode=OneWay}" Style="{StaticResource ReportMetricValueStyle}" FontSize="28"/>
                        <TextBlock Text="{x:Bind ViewModel.IssueLabel, Mode=OneWay}" Style="{StaticResource ReportMetricLabelStyle}"/>
                    </StackPanel></Border>
                    <Border Grid.Column="1" Padding="16" Style="{StaticResource PageCardStyle}"><StackPanel Spacing="4">
                        <TextBlock x:Name="ReportedSpace" Text="{x:Bind ViewModel.ReportSpace, Mode=OneWay}" Style="{StaticResource ReportMetricValueStyle}" FontSize="28"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.SpaceLabel, Mode=OneWay}" Style="{StaticResource ReportMetricLabelStyle}"/>
                    </StackPanel></Border>
                </Grid>
            </Grid>
        </StackPanel>
        <ScrollViewer x:Name="CategoryReportViewport" Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}" Padding="0"
                      VerticalContentAlignment="Top"
                      Visibility="{x:Bind ViewModel.HasCleanupReport, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl x:Name="CategoryReportList" ItemsSource="{x:Bind ViewModel.CategoryReports}" VerticalAlignment="Top"
                          IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <common:UniformWrapPanel ItemWidth="320" MaxColumns="2" StretchItems="True"
                                                 ColumnSpacing="{StaticResource PageCardSpacing}" RowSpacing="{StaticResource PageCardSpacing}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CleanerCategoryReport">
                        <Button Style="{StaticResource ReportCardButtonStyle}" Click="ShowCategoryDetails_Click"
                                CommandParameter="{x:Bind}" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                AutomationProperties.HelpText="{x:Bind Overview, Mode=OneWay}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="{StaticResource ControlCornerRadius}"
                                        Background="{ThemeResource PageIconBackgroundBrush}">
                                    <fluent:FluentIcon Icon="{x:Bind Icon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource PageIconForegroundBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind Overview, Mode=OneWay}" Style="{StaticResource ReportMetricLabelStyle}"/>
                                </StackPanel>
                                <fluent:FluentIcon Grid.Column="2" Icon="ChevronRight" FontSize="14" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid x:Name="ResultsRegion" Grid.Row="1" ColumnSpacing="{StaticResource PageCardSpacing}" Visibility="{x:Bind ViewModel.ShowCategoryReview, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="CategoryColumn" Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PageCardStyle}" Padding="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.CategoriesLabel, Mode=OneWay}" FontWeight="SemiBold" Margin="8"/>
                    <ListView x:Name="CategorySelector" Grid.Row="1" ItemsSource="{x:Bind ViewModel.CategoryReports}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" SelectionMode="Single" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" HorizontalContentAlignment="Stretch" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource ListViewItemExpanded}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,12"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate x:DataType="vm:CleanerCategoryReport">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <fluent:FluentIcon Icon="{x:Bind Icon}" FontSize="18" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2"><TextBlock Text="{x:Bind FoundLabel, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind FoundCount}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{x:Bind SelectedLabel, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind SelectedCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Grid Grid.Column="1" RowSpacing="{StaticResource PageCardSpacing}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource PageCardStyle}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.SelectedCategory.Title, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <toolkit:WrapPanel HorizontalSpacing="24" VerticalSpacing="8">
                            <StackPanel Spacing="2"><TextBlock Text="{x:Bind ViewModel.FoundLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.SelectedCategory.FoundCount, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Spacing="2"><TextBlock Text="{x:Bind ViewModel.SelectedCategory.ProtectedLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.SelectedCategory.ProtectedCount, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Spacing="2"><TextBlock Text="{x:Bind ViewModel.SelectedLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.SelectedCategory.SelectedCount, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Spacing="2"><TextBlock Text="{x:Bind ViewModel.SpaceLabel, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.SelectedCategory.SelectedSize, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                        </toolkit:WrapPanel>
                    </StackPanel>
                </Border>
                <common:GroupedResultsList x:Name="ResultsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.SelectedCategoryGroups, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanSelectResults, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasCategoryItems, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Border x:Name="EmptyResults" Grid.Row="1" Style="{StaticResource PageCardStyle}" VerticalAlignment="Top" Visibility="{x:Bind ViewModel.HasEmptyCategory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind ViewModel.NoSelectableItemsLabel, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </Grid>
        </Grid>
        <Expander x:Name="NoticeDetails" Grid.Row="2" Header="{x:Bind ViewModel.ScanDetailsLabel, Mode=OneWay}" HorizontalAlignment="Stretch"
                  IsExpanded="{x:Bind ViewModel.AreDetailsExpanded, Mode=TwoWay}"
                  Visibility="{x:Bind ViewModel.ShowScanNotices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="NoticesText" Text="{x:Bind ViewModel.Notices, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </ScrollViewer>
        </Expander>
        <Border x:Name="ActionBar" Grid.Row="3" Padding="16,12" Style="{StaticResource PageCardStyle}" Visibility="{x:Bind ViewModel.ShowReviewItems, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid x:Name="ActionLayout" ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <toolkit:WrapPanel x:Name="SelectionActions" Grid.ColumnSpan="2" HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.SelectAllCommand}" Content="{x:Bind ViewModel.SelectAllLabel, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanSelectResults, Mode=OneWay}"/>
                    <Button Command="{x:Bind ViewModel.ClearSelectionCommand}" Content="{x:Bind ViewModel.ClearLabel, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanSelectResults, Mode=OneWay}"/>
                </toolkit:WrapPanel>
                <Button x:Name="ApplyAction" Grid.Row="1" Grid.ColumnSpan="2" Command="{x:Bind ViewModel.ApplyCommand}" Content="{x:Bind ViewModel.ApplyLabel, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Padding="20,10" HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>
    </Grid>
</Page>
