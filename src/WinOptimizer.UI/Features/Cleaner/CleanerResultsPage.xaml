<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fluent="using:FluentIcons.WinUI"
      xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
      xmlns:vm="using:WinOptimizer.UI.Features.Cleaner.ViewModels"
      x:Class="WinOptimizer.UI.Features.Cleaner.CleanerResultsPage">
    <Grid x:Name="LayoutRoot" SizeChanged="LayoutRoot_SizeChanged" Style="{StaticResource PageGridStyle}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="WideLayoutTrigger"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SummaryColumn3.Width" Value="*"/>
                        <Setter Target="SummaryColumn4.Width" Value="*"/>
                        <Setter Target="IssueMetric.(Grid.Row)" Value="0"/>
                        <Setter Target="IssueMetric.(Grid.Column)" Value="2"/>
                        <Setter Target="SpaceMetric.(Grid.Row)" Value="0"/>
                        <Setter Target="SpaceMetric.(Grid.Column)" Value="3"/>
                        <Setter Target="SummaryPanel.RowSpacing" Value="0"/>
                        <Setter Target="SelectionActions.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="ApplyAction.(Grid.Row)" Value="0"/>
                        <Setter Target="ApplyAction.(Grid.Column)" Value="1"/>
                        <Setter Target="ApplyAction.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="ApplyAction.HorizontalAlignment" Value="Right"/>
                        <Setter Target="ActionLayout.RowSpacing" Value="0"/>
                        <Setter Target="CategoryColumn.Width" Value="280"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="CompactLayoutTrigger" IsActive="True"/></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="12">
            <common:PageHeader Title="{x:Bind ViewModel.ReportTitle, Mode=OneWay}" Description="{x:Bind ViewModel.ReportDescription, Mode=OneWay}" Icon="Broom"/>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="ReportStatus" Text="{x:Bind ViewModel.ReportState, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="StatusText" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind ViewModel.HasScanStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <Button x:Name="RescanAction" Grid.Column="1" Command="{x:Bind ViewModel.ScanCommand}" Content="{x:Bind ViewModel.ScanLabel, Mode=OneWay}" VerticalAlignment="Top"/>
            </Grid>
                <Grid x:Name="SummaryPanel" ColumnSpacing="12" RowSpacing="12" Visibility="{x:Bind ViewModel.HasSummary, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SummaryColumn3" Width="0"/><ColumnDefinition x:Name="SummaryColumn4" Width="0"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Padding="16" Style="{StaticResource PageCardStyle}"><StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.FoundLabel, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/>
                    </StackPanel></Border>
                    <Border Grid.Column="1" Padding="16" Style="{StaticResource PageCardStyle}"><StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.OutcomeLabel, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="OutcomeCount" Text="{x:Bind ViewModel.OutcomeCount, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/>
                    </StackPanel></Border>
                    <Border x:Name="IssueMetric" Grid.Row="1" Padding="16" Style="{StaticResource PageCardStyle}"><StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.IssueLabel, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="IssueCount" Text="{x:Bind ViewModel.IssueCount, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/>
                    </StackPanel></Border>
                    <Border x:Name="SpaceMetric" Grid.Row="1" Grid.Column="1" Padding="16" Style="{StaticResource PageCardStyle}"><StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.SpaceLabel, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="ReportedSpace" Text="{x:Bind ViewModel.ReportSpace, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel></Border>
                </Grid>
        </StackPanel>
        <ScrollViewer x:Name="HeaderViewport" Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}" Visibility="{x:Bind ViewModel.HasCleanupReport, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl x:Name="CategoryReportList" ItemsSource="{x:Bind ViewModel.CategoryReports}" Visibility="{x:Bind ViewModel.HasCleanupReport, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CleanerCategoryReport">
                        <Border Style="{StaticResource PageCardStyle}" Margin="0,0,0,12"><StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <fluent:FluentIcon Icon="{x:Bind Icon}" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <toolkit:WrapPanel HorizontalSpacing="24" VerticalSpacing="16">
                                <StackPanel Spacing="4" MinWidth="100"><TextBlock Text="{x:Bind FoundLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind FoundCount}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Spacing="4" MinWidth="100"><TextBlock Text="{x:Bind SelectedLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind SelectedCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Spacing="4" MinWidth="100"><TextBlock Text="{x:Bind CompletedLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind CompletedCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Spacing="4" MinWidth="100"><TextBlock Text="{x:Bind FailedLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind FailedCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Spacing="4" MinWidth="100"><TextBlock Text="{x:Bind RemovedLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind RemovedCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Spacing="4" MinWidth="100"><TextBlock Text="{x:Bind UnprocessedLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind UnprocessedCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Spacing="4" MinWidth="150" MaxWidth="220"><TextBlock Text="{x:Bind FreedLabel, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind FreedSize, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Spacing="4" MinWidth="150" MaxWidth="220"><TextBlock Text="{x:Bind RegistryLabel, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind RegistrySize, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                            </toolkit:WrapPanel>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
        </ScrollViewer>
        <Grid x:Name="ResultsRegion" Grid.Row="1" ColumnSpacing="16" Visibility="{x:Bind ViewModel.ShowCategoryReview, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="CategoryColumn" Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PageCardStyle}" Padding="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.CategoriesLabel, Mode=OneWay}" FontWeight="SemiBold" Margin="8"/>
                    <ListView x:Name="CategorySelector" Grid.Row="1" ItemsSource="{x:Bind ViewModel.CategoryReports}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" SelectionMode="Single" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" HorizontalContentAlignment="Stretch" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,12"/><Setter Property="Margin" Value="0,0,0,8"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate x:DataType="vm:CleanerCategoryReport">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <fluent:FluentIcon Icon="{x:Bind Icon}" FontSize="18" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2"><TextBlock Text="{x:Bind FoundLabel, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind FoundCount}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{x:Bind SelectedLabel, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind SelectedCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource PageCardStyle}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.SelectedCategory.Title, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <toolkit:WrapPanel HorizontalSpacing="24" VerticalSpacing="8">
                            <StackPanel Spacing="2"><TextBlock Text="{x:Bind ViewModel.FoundLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.SelectedCategory.FoundCount, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Spacing="2"><TextBlock Text="{x:Bind ViewModel.SelectedCategory.ProtectedLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.SelectedCategory.ProtectedCount, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Spacing="2"><TextBlock Text="{x:Bind ViewModel.SelectedLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.SelectedCategory.SelectedCount, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Spacing="2"><TextBlock Text="{x:Bind ViewModel.SpaceLabel, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.SelectedCategory.SelectedSize, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                        </toolkit:WrapPanel>
                    </StackPanel>
                </Border>
                <common:GroupedResultsList x:Name="ResultsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.SelectedCategoryGroups, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanSelectResults, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasCategoryItems, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Border x:Name="EmptyResults" Grid.Row="1" Style="{StaticResource PageCardStyle}" VerticalAlignment="Top" Visibility="{x:Bind ViewModel.HasEmptyCategory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind ViewModel.NoSelectableItemsLabel, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </Grid>
        </Grid>
                <Expander x:Name="NoticeDetails" Grid.Row="2" Header="{x:Bind ViewModel.DetailsLabel, Mode=OneWay}" HorizontalAlignment="Stretch" IsExpanded="{x:Bind ViewModel.AreDetailsExpanded, Mode=TwoWay}" Visibility="{x:Bind ViewModel.HasReportDetails, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="NoticesText" Text="{x:Bind ViewModel.ReportDetails, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer>
                </Expander>
        <Border x:Name="ActionBar" Grid.Row="3" Padding="16,12" Style="{StaticResource PageCardStyle}" Visibility="{x:Bind ViewModel.ShowReviewItems, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid x:Name="ActionLayout" ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <toolkit:WrapPanel x:Name="SelectionActions" Grid.ColumnSpan="2" HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.SelectAllCommand}" Content="{x:Bind ViewModel.SelectAllLabel, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanSelectResults, Mode=OneWay}"/>
                    <Button Command="{x:Bind ViewModel.ClearSelectionCommand}" Content="{x:Bind ViewModel.ClearLabel, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanSelectResults, Mode=OneWay}"/>
                </toolkit:WrapPanel>
                <Button x:Name="ApplyAction" Grid.Row="1" Grid.ColumnSpan="2" Command="{x:Bind ViewModel.ApplyCommand}" Content="{x:Bind ViewModel.ApplyLabel, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Padding="20,10" HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>
    </Grid>
</Page>
