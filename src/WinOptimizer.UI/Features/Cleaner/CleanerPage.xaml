<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:WinOptimizer.UI.Features.Common.Controls" xmlns:fluent="using:FluentIcons.WinUI" xmlns:common="using:WinOptimizer.UI.Features.Common.Controls" x:Class="WinOptimizer.UI.Features.Cleaner.CleanerPage">
    <Page.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="CleanerScanAccentBrush" Color="#FFFFB36B"/>
                <SolidColorBrush x:Key="CleanerScanIconBrush" Color="#FF603819"/>
                <SolidColorBrush x:Key="CleanerScanTrackBrush" Color="#FF414248"/>
                <SolidColorBrush x:Key="CleanerScanStrokeBrush" Color="#FF3C3D44"/>
                <SolidColorBrush x:Key="CleanerScanOnAccentBrush" Color="#FF26170C"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="CleanerScanAccentBrush" Color="#FF9B4200"/>
                <SolidColorBrush x:Key="CleanerScanIconBrush" Color="#FF9B4200"/>
                <SolidColorBrush x:Key="CleanerScanTrackBrush" Color="#FFD6D1CD"/>
                <SolidColorBrush x:Key="CleanerScanStrokeBrush" Color="#FFD2CFCC"/>
                <SolidColorBrush x:Key="CleanerScanOnAccentBrush" Color="White"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
                <SolidColorBrush x:Key="CleanerScanAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                <SolidColorBrush x:Key="CleanerScanIconBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                <SolidColorBrush x:Key="CleanerScanTrackBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                <SolidColorBrush x:Key="CleanerScanStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                <SolidColorBrush x:Key="CleanerScanOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <ItemsPanelTemplate x:Key="CleanerScanAreasPanel">
            <controls:UniformWrapPanel ItemWidth="256" ItemHeight="86" ColumnSpacing="{StaticResource PageCardSpacing}"
                                       RowSpacing="{StaticResource PageCardSpacing}" StretchItems="True" MaxColumns="3"/>
        </ItemsPanelTemplate>
        <Style x:Key="CleanerStepNumber" TargetType="Border">
            <Setter Property="Width" Value="23"/><Setter Property="Height" Value="23"/>
            <Setter Property="CornerRadius" Value="12"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}"/>
        </Style>
        <Style x:Key="CleanerStepConnector" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{ThemeResource CleanerScanStrokeBrush}"/>
        </Style>
        <DataTemplate x:Key="CleanerAreaContent">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Width="44" Height="44" VerticalAlignment="Center">
                    <Border CornerRadius="12" Background="{ThemeResource PageIconBackgroundBrush}"/>
                    <Border CornerRadius="12" Background="{ThemeResource CleanerScanIconBrush}"
                            Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <fluent:FluentIcon Icon="{Binding Choice.Icon}" IconVariant="Regular" FontSize="24"
                                       Foreground="{ThemeResource PageIconForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Choice.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Choice.Description}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <Grid ColumnSpacing="7" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ProgressRing Width="14" Height="14" IsActive="{Binding IsActive}" Foreground="{ThemeResource CleanerScanAccentBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{ThemeResource CleanerScanAccentBrush}"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- Native checkbox semantics, full-card hit targets and system keyboard focus. -->
        <Style x:Key="CleanerAreaCard" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="CardRoot" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters><Setter Target="CardBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters><Setter Target="CardRoot.Opacity" Value="0.75"/></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="CardBorder.Padding" Value="12,10"/>
                                            <Setter Target="SelectionBadgeHost.Width" Value="16"/>
                                            <Setter Target="SelectionBadgeHost.Height" Value="16"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked"/>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <Setter Target="SelectionBadge.Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <Setter Target="SelectionBadge.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <Setter Target="CheckGlyph.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="CardBorder" Style="{StaticResource PageCardStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"/>
                                    <Grid x:Name="SelectionBadgeHost" Grid.Column="1" Width="20" Height="20" VerticalAlignment="Top">
                                        <Border x:Name="SelectionBadge" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                                            <FontIcon x:Name="CheckGlyph" Glyph="" FontSize="12" Opacity="0" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </Border>
                                        <Border Background="{ThemeResource CleanerScanAccentBrush}" CornerRadius="6"
                                                Visibility="{Binding Content.HasScanCheck, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <FontIcon Glyph="" FontSize="12" Foreground="{ThemeResource CleanerScanOnAccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border x:Name="ActiveCardOutline" BorderBrush="{ThemeResource CleanerScanAccentBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource PageSurfaceCornerRadius}" IsHitTestVisible="False"
                                    Visibility="{Binding Content.IsActive, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Page.Resources>
    <Grid x:Name="LayoutRoot" SizeChanged="LayoutRoot_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="WideLayoutTrigger"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ScanAction.(Grid.Column)" Value="1"/>
                        <Setter Target="ScanAction.(Grid.Row)" Value="0"/>
                        <Setter Target="ScanAction.Margin" Value="32,0,12,0"/>
                        <Setter Target="ScanHero.Padding" Value="32"/>
                        <Setter Target="CancelScanButton.(Grid.Row)" Value="0"/>
                        <Setter Target="CancelScanButton.(Grid.Column)" Value="2"/>
                        <Setter Target="ScanProgressHeader.RowSpacing" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="CompactLayoutTrigger" IsActive="True"/></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState x:Name="ScanAreasInProgress">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AreaCards.ItemsPanel" Value="{StaticResource CleanerScanAreasPanel}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
            <StackPanel Style="{StaticResource PageStackStyle}">
                <controls:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneWay}" Description="{x:Bind ViewModel.Description, Mode=OneWay}" Icon="Broom"/>

                <!-- Guidance and the scan action share a bounded, responsive hero. -->
                <Border x:Name="ScanHero" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20" Padding="20"
                        Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Spacing="16" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ScanStep, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.IntroTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.IntroDescription, Mode=OneWay}" MaxWidth="600" HorizontalAlignment="Left" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.CategorySummary, Mode=OneWay}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Grid x:Name="ScanAction" Grid.Row="1" Width="172" Height="172" Margin="0,24,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Fill="{ThemeResource AccentFillColorTertiaryBrush}" Opacity="0.35"/>
                            <Ellipse Margin="7" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" Opacity="0.35"/>
                            <Button x:Name="StartScanButton" Command="{x:Bind ViewModel.ScanCommand}" Style="{StaticResource AccentButtonStyle}" Width="136" Height="136" CornerRadius="68" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind ViewModel.ScanLabel, Mode=OneWay}">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <fluent:FluentIcon Icon="Search" IconVariant="Regular" FontSize="30" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.ScanLabel, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="ScanProgressPanel" Padding="16,12,16,8" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{ThemeResource CleanerScanStrokeBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="9">
                        <Grid x:Name="ScanProgressHeader" ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource CleanerScanIconBrush}" VerticalAlignment="Top">
                                <fluent:FluentIcon Icon="{x:Bind ViewModel.ScanIcon, Mode=OneWay}" IconVariant="Regular" FontSize="25"
                                                   Foreground="{ThemeResource PageIconForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="{ThemeResource CleanerScanAccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ScanInProgressLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource CleanerScanAccentBrush}" TextWrapping="Wrap"/>
                                </Grid>
                                <TextBlock x:Name="ScanProgressTitle" Text="{x:Bind ViewModel.ScanProgressTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                                           TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock x:Name="ScanProgressDescription" Text="{x:Bind ViewModel.ScanProgressDescription, Mode=OneWay}" FontSize="12"
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button x:Name="CancelScanButton" Grid.Column="1" Grid.Row="1" Padding="10,5" VerticalAlignment="Top" HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.CancelScanCommand}" Background="Transparent" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                    AutomationProperties.Name="{x:Bind ViewModel.CancelScanLabel, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <fluent:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.CancelScanLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Height="7">
                            <Border Background="{ThemeResource CleanerScanTrackBrush}" CornerRadius="4"/>
                            <ProgressBar x:Name="ScanProgressBar" Height="7" MinHeight="7" CornerRadius="4" Background="Transparent" Foreground="{ThemeResource CleanerScanAccentBrush}"
                                         IsIndeterminate="{x:Bind ViewModel.IsScanIndeterminate, Mode=OneWay}" Value="{x:Bind ViewModel.ScanPercentage, Mode=OneWay}"
                                         AutomationProperties.Name="{x:Bind ViewModel.ScanInProgressLabel, Mode=OneWay}"/>
                        </Grid>
                        <Grid ColumnSpacing="12" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="44"/><ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="44"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Border Style="{StaticResource CleanerStepNumber}" Background="{ThemeResource CleanerScanAccentBrush}" BorderThickness="0">
                                    <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource CleanerScanOnAccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.ScanLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource CleanerScanAccentBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource CleanerStepConnector}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9">
                                <Border Style="{StaticResource CleanerStepNumber}">
                                    <TextBlock Text="2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.ReviewStepLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="3" Style="{StaticResource CleanerStepConnector}"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="9">
                                <Border Style="{StaticResource CleanerStepNumber}">
                                    <TextBlock Text="3" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.CleanStepLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="0,5,0,0">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.ScanResultsHint, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button x:Name="ScanDetailsButton" Grid.Column="1" Command="{x:Bind ViewModel.ShowScanDetailsCommand}" Style="{StaticResource SubtleButtonStyle}"
                                        MinHeight="28" Padding="7,4" AutomationProperties.Name="{x:Bind ViewModel.ScanDetailsLabel, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="{x:Bind ViewModel.ScanDetailsLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/>
                                        <fluent:FluentIcon Icon="ChevronRight" IconVariant="Regular" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.AreasLabel, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CategorySummary, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                    <ItemsControl x:Name="AreaCards" ItemsSource="{x:Bind ViewModel.ScanAreaCards}" IsEnabled="{x:Bind ViewModel.CanChooseAreas, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:UniformWrapPanel ItemWidth="300" ItemHeight="108" ColumnSpacing="{StaticResource PageCardSpacing}" RowSpacing="{StaticResource PageCardSpacing}" StretchItems="True" MaxColumns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource CleanerAreaCard}" Content="{Binding}" ContentTemplate="{StaticResource CleanerAreaContent}"
                                          IsChecked="{Binding Choice.IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Choice.Title}"
                                          AutomationProperties.HelpText="{Binding Choice.Description}" AutomationProperties.ItemStatus="{Binding Status}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Bind ViewModel.AreaSelectionError, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind ViewModel.HasAreaSelectionError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind ViewModel.HasScanStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Click="ReviewResults_Click" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasScanned, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.ReviewLabel, Mode=OneWay}"/>
                        <FontIcon Glyph="" FontSize="14"/>
                    </StackPanel>
                </Button>
                <common:NavigationCard x:Name="EventsCleanupCard" Title="{x:Bind ViewModel.EventsCleanupDisplayName, Mode=OneWay}" Description="{x:Bind ViewModel.EventsCleanupDescription, Mode=OneWay}" Click="EventsCleanupCard_Click">
                    <common:NavigationCard.Icon><fluent:FluentIcon Icon="DocumentBulletList" IconVariant="Regular" FontSize="28"/></common:NavigationCard.Icon>
                </common:NavigationCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
