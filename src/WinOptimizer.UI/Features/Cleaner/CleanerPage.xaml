<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:WinOptimizer.UI.Features.Common.Controls" xmlns:fluent="using:FluentIcons.WinUI" xmlns:common="using:WinOptimizer.UI.Features.Common.Controls" x:Class="WinOptimizer.UI.Features.Cleaner.CleanerPage">
    <Page.Resources>
        <!-- Native checkbox semantics, full-card hit targets and system keyboard focus. -->
        <Style x:Key="CleanerAreaCard" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="CardRoot" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters><Setter Target="CardBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters><Setter Target="CardRoot.Opacity" Value="0.75"/></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters><Setter Target="CardRoot.Opacity" Value="0.45"/></VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked"/>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <Setter Target="SelectionBadge.Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <Setter Target="SelectionBadge.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <Setter Target="CheckGlyph.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="CardBorder" MinHeight="108" Style="{StaticResource PageCardStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"/>
                                    <Border x:Name="SelectionBadge" Grid.Column="1" Width="20" Height="20" VerticalAlignment="Top" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                                        <FontIcon x:Name="CheckGlyph" Glyph="" FontSize="12" Opacity="0" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid x:Name="LayoutRoot" SizeChanged="LayoutRoot_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="WideLayoutTrigger"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ScanAction.(Grid.Column)" Value="1"/>
                        <Setter Target="ScanAction.(Grid.Row)" Value="0"/>
                        <Setter Target="ScanAction.Margin" Value="32,0,12,0"/>
                        <Setter Target="ScanHero.Padding" Value="32"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers><StateTrigger x:Name="CompactLayoutTrigger" IsActive="True"/></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
            <StackPanel Style="{StaticResource PageStackStyle}">
                <controls:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneWay}" Description="{x:Bind ViewModel.Description, Mode=OneWay}" Icon="Broom"/>

                <!-- Guidance and the scan action share a bounded, responsive hero. -->
                <Border x:Name="ScanHero" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20" Padding="20">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Spacing="16" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ScanStep, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.IntroTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.IntroDescription, Mode=OneWay}" MaxWidth="600" HorizontalAlignment="Left" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.CategorySummary, Mode=OneWay}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Grid x:Name="ScanAction" Grid.Row="1" Width="172" Height="172" Margin="0,24,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Fill="{ThemeResource AccentFillColorTertiaryBrush}" Opacity="0.35"/>
                            <Ellipse Margin="7" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" Opacity="0.35"/>
                            <Button Command="{x:Bind ViewModel.ScanCommand}" Style="{StaticResource AccentButtonStyle}" Width="136" Height="136" CornerRadius="68" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind ViewModel.ScanLabel, Mode=OneWay}">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <fluent:FluentIcon Icon="Search" IconVariant="Regular" FontSize="30" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.ScanLabel, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind ViewModel.AreasLabel, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                    <ItemsControl x:Name="AreaCards" ItemsSource="{x:Bind ViewModel.Areas}" IsEnabled="{x:Bind ViewModel.CanChooseAreas, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:UniformWrapPanel ItemWidth="300" ItemHeight="108" ColumnSpacing="12" RowSpacing="12" StretchItems="True" MaxColumns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource CleanerAreaCard}" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource PageIconBackgroundBrush}" VerticalAlignment="Center">
                                            <fluent:FluentIcon Icon="{Binding Icon}" IconVariant="Regular" FontSize="24" Foreground="{ThemeResource PageIconForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Bind ViewModel.AreaSelectionError, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind ViewModel.HasAreaSelectionError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind ViewModel.HasScanStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Click="ReviewResults_Click" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasScanned, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.ReviewLabel, Mode=OneWay}"/>
                            <FontIcon Glyph="" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <common:NavigationCard x:Name="EventsCleanupCard" Title="{x:Bind ViewModel.EventsCleanupDisplayName, Mode=OneWay}" Description="{x:Bind ViewModel.EventsCleanupDescription, Mode=OneWay}" Click="EventsCleanupCard_Click">
                    <common:NavigationCard.Icon><fluent:FluentIcon Icon="DocumentBulletList" IconVariant="Regular" FontSize="28"/></common:NavigationCard.Icon>
                </common:NavigationCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
