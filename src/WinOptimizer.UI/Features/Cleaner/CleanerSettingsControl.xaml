<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="WinOptimizer.UI.Features.Cleaner.CleanerSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <StackPanel Spacing="12">
        <ContentControl IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">
                <StackPanel x:Name="BackupsSection" Spacing="6">
                    <controls:SettingsCard Header="{x:Bind ViewModel.BackupLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.BackupBeforeCleaning, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.BackupLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.HiveBackupLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.BackupBeforeRegistryDefrag, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.HiveBackupLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsExpander Header="{x:Bind ViewModel.RestoreLabel, Mode=OneWay}">
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                                    <ComboBox ItemsSource="{x:Bind ViewModel.Backups}" SelectedItem="{x:Bind ViewModel.SelectedBackup, Mode=TwoWay}" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind ViewModel.BackupsLabel, Mode=OneWay}"/>
                                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                        <Button Content="{x:Bind ViewModel.ReloadBackupsLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ReloadBackupsCommand}"/>
                                        <Button Content="{x:Bind ViewModel.RestoreLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RestoreBackupCommand}"/>
                                        <Button Content="{x:Bind ViewModel.OpenBackupsLabel, Mode=OneWay}" Command="{x:Bind ViewModel.OpenBackupsCommand}"/>
                                    </controls:WrapPanel>
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                </StackPanel>
                <StackPanel x:Name="RegistrySection" Spacing="6">
                    <controls:SettingsCard Header="{x:Bind ViewModel.DeepLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.DeepClean, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.DeepLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RegistryCategories}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <controls:SettingsCard Header="{Binding Title}" Margin="0,0,0,6">
                                <ToggleSwitch IsOn="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}"/>
                            </controls:SettingsCard>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel x:Name="PrivacySection" Spacing="6">
                    <controls:SettingsCard Header="{x:Bind ViewModel.WindowsHistoryLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.WindowsHistory, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.WindowsHistoryLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.RecentLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.RecentFiles, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.RecentLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.CacheLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.BrowserCache, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.CacheLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.HistoryLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.BrowserHistory, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.HistoryLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.OfflineCacheLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.BrowserOfflineCache, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.OfflineCacheLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.JumpListsLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.JumpLists, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.JumpListsLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.ApplicationHistoryLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ApplicationHistory, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.ApplicationHistoryLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.PrivacyCachesLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ApplicationPrivacyCaches, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.PrivacyCachesLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.CertificateCacheLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.CertificateCache, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.CertificateCacheLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.DefenderLogsLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.DefenderLogs, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.DefenderLogsLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                </StackPanel>
                <StackPanel x:Name="JunkSection" Spacing="6">
                    <controls:SettingsCard Header="{x:Bind ViewModel.TempLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.UserTemp, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.TempLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.WindowsTempLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.WindowsTemp, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.WindowsTempLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.WindowsLogsLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.WindowsLogs, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.WindowsLogsLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.ShaderLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ShaderCache, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.ShaderLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.ThumbnailLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ThumbnailCache, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.ThumbnailLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.ReportsLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ErrorReports, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.ReportsLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.CrashDumpsLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.CrashDumps, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.CrashDumpsLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.InternetCacheLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.InternetCache, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.InternetCacheLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.AgeLabel, Mode=OneWay}">
                        <NumberBox Value="{x:Bind ViewModel.MinimumAgeDays, Mode=TwoWay}" Minimum="0" Maximum="365" SpinButtonPlacementMode="Compact" Width="132" AutomationProperties.Name="{x:Bind ViewModel.AgeLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <TextBlock Text="{x:Bind ViewModel.AppsLabel, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,16,0,6"/>
                    <TextBlock Text="{x:Bind ViewModel.ApplicationStatus, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Applications}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <controls:SettingsCard Header="{Binding Title}" Margin="0,0,0,6">
                                <ToggleSwitch IsOn="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}"/>
                            </controls:SettingsCard>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel x:Name="ShortcutsSection" Spacing="6">
                    <controls:SettingsCard Header="{x:Bind ViewModel.DesktopLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.DesktopShortcuts, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.DesktopLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.StartMenuLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.StartMenuShortcuts, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.StartMenuLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.RecentLabel, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.RecentShortcuts, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.RecentLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                </StackPanel>
                <StackPanel x:Name="DiskSection">
                    <controls:SettingsCard Header="{x:Bind ViewModel.DiskLabel, Mode=OneWay}">
                        <ComboBox ItemsSource="{x:Bind ViewModel.Drives}" SelectedItem="{x:Bind ViewModel.DiskRoot, Mode=TwoWay}" MinWidth="144" AutomationProperties.Name="{x:Bind ViewModel.DiskLabel, Mode=OneWay}"/>
                    </controls:SettingsCard>
                </StackPanel>
            </StackPanel>
        </ContentControl>
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
    </StackPanel>
</UserControl>
