<Page x:Class="WinOptimizer.UI.Features.Disks.DisksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:WinOptimizer.UI.Features.Common.Controls">
    <Grid Style="{StaticResource PageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <common:PageHeader Title="{x:Bind Title}" Description="{x:Bind Description}" Icon="HardDrive"/>
        <ScrollView x:Name="PageScroll" Grid.Row="1" Padding="{StaticResource ScrollContentPadding}" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="ToolCards" Spacing="{StaticResource PageCardSpacing}"/>
        </ScrollView>
    </Grid>
</Page>
