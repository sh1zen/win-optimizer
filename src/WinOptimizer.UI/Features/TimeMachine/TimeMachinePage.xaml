<Page x:Class="WinOptimizer.UI.Features.TimeMachine.TimeMachinePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:fluent="using:FluentIcons.WinUI"
      xmlns:helpers="using:WinOptimizer.UI.Features.Common.Helpers"
      xmlns:local="using:WinOptimizer.UI.Features.TimeMachine"
      x:DefaultBindMode="OneWay">
    <Page.Resources>
        <Style x:Key="TimeMachineListStyle" TargetType="ListView">
            <Setter Property="SelectionMode" Value="None"/>
            <Setter Property="Padding" Value="{StaticResource ScrollContentBottomPadding}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="helpers:ScrollBarAutoHide.HideAfter" Value="0:0:2"/>
        </Style>
        <Style x:Key="TimeMachineRowContainer" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
        <DataTemplate x:Key="ChangeRowTemplate" x:DataType="local:TimeMachineRow" x:DefaultBindMode="OneTime">
            <Border Style="{StaticResource PageCardStyle}" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanRestore}"
                              AutomationProperties.Name="{x:Bind Title}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Resource}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{x:Bind HasResource, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{x:Bind Values}" TextWrapping="Wrap"
                                   Visibility="{x:Bind HasValues, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{x:Bind HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <common:PageHeader Title="{x:Bind ViewModel.Title}" Icon="History" DescriptionVisibility="Collapsed"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="{StaticResource ScrollContentBottomPadding}" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SegmentedSurfaceStyle}" HorizontalAlignment="Left">
                    <SelectorBar SelectedItem="{x:Bind HistoryTab, Mode=OneTime}"
                                 IsEnabled="{x:Bind ViewModel.CanInteract}">
                        <SelectorBar.Resources>
                            <StaticResource x:Key="SelectorBarItemBackgroundSelected" ResourceKey="AccentSelectionBackgroundBrush"/>
                            <StaticResource x:Key="SelectorBarItemForegroundSelected" ResourceKey="AccentSelectionForegroundBrush"/>
                        </SelectorBar.Resources>
                        <SelectorBarItem x:Name="HistoryTab" Text="{x:Bind ViewModel.HistoryLabel}">
                            <SelectorBarItem.Icon><fluent:FluentIcon Icon="History" IconVariant="Regular"/></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="SnapshotsTab" Text="{x:Bind ViewModel.SnapshotsLabel}">
                            <SelectorBarItem.Icon><fluent:FluentIcon Icon="Camera" IconVariant="Regular"/></SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing Width="24" Height="24" VerticalAlignment="Center"
                                  IsActive="{x:Bind ViewModel.IsBusy}" Visibility="{x:Bind ViewModel.IsBusy}"/>
                    <Grid Visibility="{x:Bind SnapshotsTab.IsSelected}">
                        <Button Command="{x:Bind ViewModel.CaptureCommand}" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="{x:Bind ViewModel.CreateSnapshotLabel}"
                                IsEnabled="{x:Bind ViewModel.CanInteract}" Visibility="{x:Bind ViewModel.IsSnapshotList}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluent:FluentIcon Icon="Camera" IconVariant="Regular" IconSize="Size16"/>
                                <TextBlock Text="{x:Bind ViewModel.CreateSnapshotLabel}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource PageCardStyle}" Padding="16,12"
                    Margin="{StaticResource ScrollContentBottomPadding}" Visibility="{x:Bind ViewModel.HasStatus}">
                <ScrollViewer Style="{StaticResource PageScrollViewerStyle}" MaxHeight="116">
                    <TextBlock Text="{x:Bind ViewModel.Status}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                </ScrollViewer>
            </Border>

            <ContentControl Grid.Row="2" IsEnabled="{x:Bind ViewModel.CanInteract}" IsTabStop="False"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid Visibility="{x:Bind HistoryTab.IsSelected}">
                        <Grid Visibility="{x:Bind ViewModel.IsDayList}" RowSpacing="{StaticResource PageCardSpacing}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" Margin="{StaticResource ScrollContentPadding}">
                                <Button Command="{x:Bind ViewModel.RefreshCommand}" AutomationProperties.Name="{x:Bind ViewModel.RefreshLabel}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <fluent:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" IconSize="Size16"/>
                                        <TextBlock Text="{x:Bind ViewModel.RefreshLabel}"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="{x:Bind ViewModel.LoadMoreLabel}" Command="{x:Bind ViewModel.LoadMoreCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasMore}"/>
                            </controls:WrapPanel>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Days}" Style="{StaticResource TimeMachineListStyle}"
                                      AutomationProperties.Name="{x:Bind ViewModel.HistoryLabel}"
                                      ItemContainerStyle="{StaticResource TimeMachineRowContainer}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:TimeMachineDay" x:DefaultBindMode="OneTime">
                                        <Button Click="DayCard_Click" Tag="{x:Bind}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                CornerRadius="{StaticResource PageSurfaceCornerRadius}" Padding="{StaticResource PageCardPadding}"
                                                BorderBrush="{ThemeResource AppSurfaceStrokeBrush}"
                                                AutomationProperties.Name="{x:Bind Title}" AutomationProperties.HelpText="{x:Bind CountText}">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <SymbolIcon Symbol="Calendar" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{x:Bind CountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <fluent:FluentIcon Grid.Column="3" Icon="ChevronRight" IconVariant="Regular" IconSize="Size16" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <Grid Visibility="{x:Bind ViewModel.HasOpenDay}" RowSpacing="{StaticResource PageCardSpacing}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource PageCardStyle}" Margin="{StaticResource ScrollContentPadding}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind ViewModel.OpenDateLabel}" Style="{StaticResource SubtitleTextBlockStyle}"
                                               TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                        <Button Command="{x:Bind ViewModel.CloseDayCommand}" AutomationProperties.Name="{x:Bind ViewModel.CloseLabel}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <fluent:FluentIcon Icon="ArrowLeft" IconVariant="Regular" IconSize="Size16"/>
                                                <TextBlock Text="{x:Bind ViewModel.CloseLabel}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Content="{x:Bind ViewModel.RestoreLabel}" Command="{x:Bind ViewModel.RestoreHistoryCommand}"/>
                                    </controls:WrapPanel>
                                </StackPanel>
                            </Border>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DayDetails}" Style="{StaticResource TimeMachineListStyle}"
                                      ItemTemplate="{StaticResource ChangeRowTemplate}" ItemContainerStyle="{StaticResource TimeMachineRowContainer}"
                                      AutomationProperties.Name="{x:Bind ViewModel.OpenDateLabel}"/>
                        </Grid>
                    </Grid>

                    <Grid Visibility="{x:Bind SnapshotsTab.IsSelected}">
                        <Grid Visibility="{x:Bind ViewModel.IsSnapshotList}">
                            <ListView ItemsSource="{x:Bind ViewModel.Snapshots}" Style="{StaticResource TimeMachineListStyle}"
                                      AutomationProperties.Name="{x:Bind ViewModel.SnapshotsLabel}"
                                      ItemContainerStyle="{StaticResource TimeMachineRowContainer}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:TimeMachineSnapshotCard" x:DefaultBindMode="OneTime">
                                        <Border Style="{StaticResource PageCardStyle}" Padding="16,12">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <fluent:FluentIcon Icon="Camera" IconVariant="Regular" IconSize="Size20" VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button Content="{x:Bind ExploreLabel}" Command="{x:Bind ExploreCommand}" CommandParameter="{x:Bind}"
                                                            AutomationProperties.HelpText="{x:Bind Title}"/>
                                                    <Button Content="{x:Bind RestoreLabel}" Command="{x:Bind ReviewCommand}" CommandParameter="{x:Bind}"
                                                            AutomationProperties.HelpText="{x:Bind Title}"/>
                                                    <Button Content="{x:Bind DeleteLabel}" Command="{x:Bind DeleteCommand}" CommandParameter="{x:Bind}"
                                                            AutomationProperties.HelpText="{x:Bind Title}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Border Style="{StaticResource PageCardStyle}" Margin="{StaticResource ScrollContentPadding}"
                                    Visibility="{x:Bind ViewModel.HasNoSnapshots}" VerticalAlignment="Top">
                                <TextBlock Text="{x:Bind ViewModel.NoSnapshotsLabel}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                            </Border>
                        </Grid>

                        <Grid Visibility="{x:Bind ViewModel.HasOpenSnapshot}" RowSpacing="{StaticResource PageCardSpacing}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource PageCardStyle}" Margin="{StaticResource ScrollContentPadding}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind ViewModel.OpenSnapshotLabel}" Style="{StaticResource SubtitleTextBlockStyle}"
                                               TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                        <Button Command="{x:Bind ViewModel.CloseSnapshotCommand}" AutomationProperties.Name="{x:Bind ViewModel.SnapshotsLabel}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <fluent:FluentIcon Icon="ArrowLeft" IconVariant="Regular" IconSize="Size16"/>
                                                <TextBlock Text="{x:Bind ViewModel.SnapshotsLabel}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Content="{x:Bind ViewModel.RestoreLabel}" Command="{x:Bind ViewModel.RestoreSnapshotCommand}"
                                                Visibility="{x:Bind ViewModel.IsSnapshotComparison}"/>
                                    </controls:WrapPanel>
                                </StackPanel>
                            </Border>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Differences}" Style="{StaticResource TimeMachineListStyle}"
                                      ItemTemplate="{StaticResource ChangeRowTemplate}" ItemContainerStyle="{StaticResource TimeMachineRowContainer}"
                                      Visibility="{x:Bind ViewModel.IsSnapshotComparison}"
                                      AutomationProperties.Name="{x:Bind ViewModel.CompareLabel}"/>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.SnapshotEntries}" Style="{StaticResource TimeMachineListStyle}"
                                      Visibility="{x:Bind ViewModel.IsExploringSnapshot}" ItemContainerStyle="{StaticResource TimeMachineRowContainer}"
                                      AutomationProperties.Name="{x:Bind ViewModel.OpenSnapshotLabel}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:TimeMachineSnapshotEntry" x:DefaultBindMode="OneTime">
                                        <Border Style="{StaticResource PageCardStyle}" Padding="16,12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind Resource}" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Border Grid.Row="1" Style="{StaticResource PageCardStyle}" Margin="{StaticResource ScrollContentPadding}"
                                    Visibility="{x:Bind ViewModel.HasEmptySnapshot}" VerticalAlignment="Top">
                                <TextBlock Text="{x:Bind ViewModel.EmptySnapshotLabel}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </ContentControl>
        </Grid>
    </Grid>
</Page>
