<Page
    x:Class="WinOptimizer.UI.Features.Benchmark.BenchmarkPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bench="using:WinOptimizer.UI.Features.Benchmark"
    xmlns:benchModel="using:WinOptimizer.Core.Features.Benchmark"
    xmlns:common="using:WinOptimizer.UI.Features.Common.Controls"
    xmlns:fluent="using:FluentIcons.WinUI"
    xmlns:info="using:WinOptimizer.UI.Features.SystemInformation.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <DataTemplate x:Key="HardwareFactTemplate" x:DataType="info:SystemInformationPropertyViewModel">
            <StackPanel Spacing="3">
                <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="BenchRowTemplate" x:DataType="bench:BenchmarkRow">
            <Border Style="{StaticResource PageCardStyle}" Padding="14">
                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Width="40" Height="40" CornerRadius="{StaticResource ControlCornerRadius}" VerticalAlignment="Top"
                            Background="{ThemeResource PageIconBackgroundBrush}">
                        <fluent:FluentIcon Icon="{x:Bind Icon}" IconVariant="Regular" FontSize="20"
                                           Foreground="{ThemeResource PageIconForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           AutomationProperties.AccessibilityView="Raw"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Result, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind HasDetail, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="1" Tag="{x:Bind}" Click="RunTest_Click" IsEnabled="{x:Bind CanRun, Mode=OneWay}"
                            Content="{x:Bind RunLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind RunName, Mode=OneWay}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageGridStyle}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <common:PageHeader Icon="Gauge" Title="{x:Bind ViewModel.Heading, Mode=OneWay}" DescriptionVisibility="Collapsed"/>
        <ScrollView x:Name="BenchScrollViewer" Grid.Row="1" Padding="{StaticResource ScrollContentPadding}" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="{StaticResource PageCardSpacing}">
                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.HardwareTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <InfoBar IsOpen="{x:Bind ViewModel.HasHardwareError, Mode=OneWay}" IsClosable="False" Severity="Warning"
                                 Message="{x:Bind ViewModel.HardwareError, Mode=OneWay}"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.HardwareFacts, Mode=OneWay}" ItemTemplate="{StaticResource HardwareFactTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <common:UniformWrapPanel ItemWidth="190" MaxColumns="3" StretchItems="True" RowSpacing="12" ColumnSpacing="16"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.TestsTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                        <toolkit:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button x:Name="RunAllButton" Content="{x:Bind ViewModel.RunAllLabel, Mode=OneWay}" Click="RunAll_Click"
                                    IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"/>
                            <Button x:Name="CancelButton" Content="{x:Bind ViewModel.CancelLabel, Mode=OneWay}" Click="Cancel_Click"
                                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.DriveLabel, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <ComboBox x:Name="DrivePicker" MinWidth="76" ItemsSource="{x:Bind ViewModel.DriveRoots, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedDrive, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanSelectDrive, Mode=OneWay}"
                                          AutomationProperties.Name="{x:Bind ViewModel.DriveLabel, Mode=OneWay}"/>
                            </StackPanel>
                        </toolkit:WrapPanel>
                        <ComboBox x:Name="GraphicsAdapterPicker" HorizontalAlignment="Stretch" MaxWidth="420"
                                  Header="{x:Bind ViewModel.GraphicsLabel, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.GraphicsAdapters, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedGraphicsAdapter, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanSelectGraphicsAdapter, Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind ViewModel.GraphicsLabel, Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="benchModel:BenchmarkGraphicsAdapter">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ItemsControl x:Name="ResultCards" ItemsSource="{x:Bind ViewModel.Rows}" ItemTemplate="{StaticResource BenchRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <common:UniformWrapPanel ItemWidth="224" MaxColumns="3" StretchItems="True" RowSpacing="10" ColumnSpacing="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
