<UserControl x:Class="WinOptimizer.UI.Features.Common.Dialogs.ConfigImportDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:FluentIcons.WinUI"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <UserControl.Resources>
        <Style x:Key="ImportSourceCardStyle" TargetType="RadioButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Card" Background="{ThemeResource AppSurfaceBrush}"
                              BorderBrush="{ThemeResource AppSurfaceStrokeBrush}" BorderThickness="1"
                              CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                              ColumnSpacing="12">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Card.Background" Value="{ThemeResource ButtonBackgroundPointerOver}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Card.Background" Value="{ThemeResource ButtonBackgroundPressed}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked"/>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Card.BorderBrush" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <Setter Target="SelectionMark.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                            <fluent:FluentIcon x:Name="SelectionMark" Grid.Column="1" Icon="Checkmark"
                                               Width="20" FontSize="18" Opacity="0" IsHitTestVisible="False"
                                               VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ImportSourceTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ImportSourceDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="ImportAppOptionStyle" TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style x:Key="ImportApplyButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
        </Style>
        <Style x:Key="ImportCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="12">
            <TextBlock x:Name="Intro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel x:Name="Sources" Spacing="6"/>
            <Border Style="{StaticResource PageSurfaceStyle}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="14,10">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="164"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="WindowsAppsLabel" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <toolkit:WrapPanel Grid.Column="1" HorizontalSpacing="12">
                            <RadioButton x:Name="WindowsAppsUninstall" Style="{StaticResource ImportAppOptionStyle}"
                                         GroupName="WindowsApps" IsChecked="True"/>
                            <RadioButton x:Name="WindowsAppsSelectOnly" Style="{StaticResource ImportAppOptionStyle}"
                                         GroupName="WindowsApps"/>
                        </toolkit:WrapPanel>
                        <TextBlock x:Name="ExternalAppsLabel" Grid.Row="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <toolkit:WrapPanel Grid.Row="1" Grid.Column="1" HorizontalSpacing="12">
                            <RadioButton x:Name="ExternalAppsUninstall" Style="{StaticResource ImportAppOptionStyle}"
                                         GroupName="ExternalApps"/>
                            <RadioButton x:Name="ExternalAppsSelectOnly" Style="{StaticResource ImportAppOptionStyle}"
                                         GroupName="ExternalApps" IsChecked="True"/>
                        </toolkit:WrapPanel>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource AppSurfaceStrokeBrush}"/>
                    <StackPanel>
                        <CheckBox x:Name="ThemeWallpaper" IsChecked="True"/>
                        <CheckBox x:Name="CleanTaskbar" IsChecked="True"/>
                        <CheckBox x:Name="CleanStartMenu" IsChecked="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
