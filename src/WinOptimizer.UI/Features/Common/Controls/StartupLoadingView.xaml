<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinOptimizer.UI.Features.Common.Controls.StartupLoadingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="LoadingRoot"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          Visibility="Visible"
          AutomationProperties.LiveSetting="Polite">
        <!-- Center the content itself so a tall viewport cannot stretch the splash. -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Center"
                      Padding="24">
            <StackPanel x:Name="LoadingContent"
                        MaxWidth="420"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                <Image x:Name="LoadingLogo"
                       Width="80" Height="80"
                       HorizontalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock x:Name="LoadingTitleText" Text="win-optimizer"
                           Margin="0,20,0,0"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="LoadingTaglineText"
                           Margin="0,6,0,0"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <!-- Keep real startup activity together in a small, naturally sized status surface. -->
                <Border x:Name="LoadingStatusCard" MaxWidth="380"
                        Margin="0,32,0,0"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,14">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="LoadingProgressRing"
                                      Width="24" Height="24"
                                      VerticalAlignment="Center"
                                      IsActive="True"
                                      IsIndeterminate="True"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      AutomationProperties.LabeledBy="{Binding ElementName=LoadingStatusText}"/>
                        <TextBlock x:Name="LoadingStatusText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   LineHeight="20"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="LoadingTitleBar" Height="48" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
