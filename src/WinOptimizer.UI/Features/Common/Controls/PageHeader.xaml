<UserControl
    x:Class="WinOptimizer.UI.Features.Common.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:FluentIcons.WinUI">
    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="52" Height="52" CornerRadius="14" Background="{ThemeResource PageIconBackgroundBrush}" VerticalAlignment="Top">
            <fluent:FluentIcon Icon="{x:Bind Icon, Mode=OneWay}" IconVariant="Regular" FontSize="28"
                              Foreground="{ThemeResource PageIconForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold"
                       TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{x:Bind Description, Mode=OneWay}" Visibility="{x:Bind DescriptionVisibility, Mode=OneWay}"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
