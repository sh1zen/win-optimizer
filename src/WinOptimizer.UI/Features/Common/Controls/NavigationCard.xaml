<UserControl x:Class="WinOptimizer.UI.Features.Common.Controls.NavigationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <toolkit:SettingsCard x:Name="Card" Style="{StaticResource PageSettingsCardStyle}" IsClickEnabled="True" Click="Card_Click"
                         AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
        <toolkit:SettingsCard.Header>
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="14" Background="{ThemeResource PageIconBackgroundBrush}" VerticalAlignment="Center">
                    <ContentPresenter Content="{x:Bind Icon, Mode=OneWay}" Foreground="{ThemeResource PageIconForegroundBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <toolkit:WrapPanel HorizontalSpacing="8" VerticalSpacing="4">
                        <TextBlock x:Name="CardTitle" Text="{x:Bind Title, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <ContentPresenter Content="{x:Bind TitleAccessory, Mode=OneWay}" VerticalAlignment="Center"/>
                    </toolkit:WrapPanel>
                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </toolkit:SettingsCard.Header>
        <toolkit:WrapPanel HorizontalSpacing="12" VerticalSpacing="8" Visibility="{x:Bind FooterVisibility(Badges, Actions), Mode=OneWay}">
            <ContentPresenter Content="{x:Bind Badges, Mode=OneWay}" VerticalAlignment="Center"/>
            <ContentPresenter Content="{x:Bind Actions, Mode=OneWay}" VerticalAlignment="Center"/>
        </toolkit:WrapPanel>
    </toolkit:SettingsCard>
</UserControl>
