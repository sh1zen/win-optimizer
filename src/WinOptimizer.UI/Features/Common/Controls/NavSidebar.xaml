<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinOptimizer.UI.Features.Common.Controls.NavSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinOptimizer.UI.Features.Common.Controls">

    <Grid x:Name="SidebarGrid"
          Width="{x:Bind ActualSidebarWidth, Mode=OneWay}"
          Background="{ThemeResource SidebarBackgroundBrush}"
          AutomationProperties.LandmarkType="Navigation">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>     <!-- Scrollable Top Nav Buttons -->
            <RowDefinition Height="Auto"/>  <!-- Bottom Nav Buttons -->
        </Grid.RowDefinitions>

        <!-- Top Navigation Buttons -->
        <!-- Fixed-width nav buttons use the full pane width; panel padding supplies their inset. -->
        <ScrollViewer Padding="0" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="TopNavPanel"
                    Spacing="4"
                    Padding="{x:Bind NavPanelPadding, Mode=OneWay}"
                    Margin="0,8,0,0">

            <local:NavButton x:Name="SoftwareAppsButton"
                             IconData="{StaticResource NavSoftwareAppsIcon}"
                             Text="{x:Bind ViewModel.NavSoftwareAppsText, Mode=OneWay}"
                             AutomationProperties.Name="{x:Bind ViewModel.NavSoftwareAppsText, Mode=OneWay}"
                             NavigationTag="SoftwareApps"
                             IsCompact="{x:Bind IsCompact, Mode=OneWay}"
                             Clicked="NavButton_Clicked"/>

            <local:NavButton x:Name="OptimizeButton"
                             IconData="{StaticResource NavOptimizeIcon}"
                             Text="{x:Bind ViewModel.NavOptimizeText, Mode=OneWay}"
                             AutomationProperties.Name="{x:Bind ViewModel.NavOptimizeText, Mode=OneWay}"
                             NavigationTag="Optimize"
                             IsCompact="{x:Bind IsCompact, Mode=OneWay}"
                             Clicked="NavButton_Clicked"/>

            <local:NavButton x:Name="CleanerButton"
                             IconData="{StaticResource NavCleanerIcon}"
                             Text="{x:Bind ViewModel.NavCleanerText, Mode=OneWay}"
                             AutomationProperties.Name="{x:Bind ViewModel.NavCleanerText, Mode=OneWay}"
                             NavigationTag="Cleaner"
                             IsCompact="{x:Bind IsCompact, Mode=OneWay}"
                             Clicked="NavButton_Clicked"/>

            <local:NavButton x:Name="DriversButton"
                             IconData="{StaticResource NavDriversIcon}"
                             Text="{x:Bind ViewModel.NavDriversText, Mode=OneWay}"
                             AutomationProperties.Name="{x:Bind ViewModel.NavDriversText, Mode=OneWay}"
                             NavigationTag="Drivers"
                             IsCompact="{x:Bind IsCompact, Mode=OneWay}"
                             Clicked="NavButton_Clicked"/>

            <local:NavButton x:Name="FunctionalitiesButton"
                             IconData="{StaticResource NavFunctionalitiesIcon}"
                             Text="{x:Bind ViewModel.NavFunctionalitiesText, Mode=OneWay}"
                             AutomationProperties.Name="{x:Bind ViewModel.NavFunctionalitiesText, Mode=OneWay}"
                             NavigationTag="Functionalities"
                             IsCompact="{x:Bind IsCompact, Mode=OneWay}"
                             Clicked="NavButton_Clicked"/>

            <local:NavButton x:Name="ManagementButton"
                             IconData="{StaticResource NavManagementIcon}"
                             Text="{x:Bind ViewModel.NavManagementText, Mode=OneWay}"
                             AutomationProperties.Name="{x:Bind ViewModel.NavManagementText, Mode=OneWay}"
                             NavigationTag="Management"
                             IsCompact="{x:Bind IsCompact, Mode=OneWay}"
                             Clicked="NavButton_Clicked"/>

            <local:NavButton x:Name="SecurityButton"
                             IconData="{StaticResource NavSecurityIcon}"
                             Text="{x:Bind ViewModel.NavSecurityText, Mode=OneWay}"
                             AutomationProperties.Name="{x:Bind ViewModel.NavSecurityText, Mode=OneWay}"
                             NavigationTag="Security"
                             IsCompact="{x:Bind IsCompact, Mode=OneWay}"
                             Clicked="NavButton_Clicked"/>

            <local:NavButton x:Name="CustomizeButton"
                             IconData="{StaticResource NavCustomizeIcon}"
                             Text="{x:Bind ViewModel.NavCustomizeText, Mode=OneWay}"
                             AutomationProperties.Name="{x:Bind ViewModel.NavCustomizeText, Mode=OneWay}"
                             NavigationTag="Customize"
                             IsCompact="{x:Bind IsCompact, Mode=OneWay}"
                             Clicked="NavButton_Clicked"/>
        </StackPanel>
        </ScrollViewer>

        <!-- Bottom Navigation Buttons -->
        <StackPanel x:Name="BottomNavPanel"
                    Grid.Row="1"
                    Spacing="4"
                    Padding="{x:Bind NavPanelPadding, Mode=OneWay}"
                    Margin="0,0,0,8">

            <local:NavButton x:Name="AdvancedToolsButton"
                             IconData="{StaticResource NavAdvancedToolsIcon}"
                             Text="{x:Bind ViewModel.NavAdvancedToolsText, Mode=OneWay}"
                             AutomationProperties.Name="{x:Bind ViewModel.NavAdvancedToolsText, Mode=OneWay}"
                             NavigationTag="AdvancedTools"
                             IsCompact="{x:Bind IsCompact, Mode=OneWay}"
                             Clicked="NavButton_Clicked"/>

            <local:NavButton x:Name="SettingsButton"
                             IconData="{StaticResource NavSettingsIcon}"
                             Text="{x:Bind ViewModel.NavSettingsText, Mode=OneWay}"
                             AutomationProperties.Name="{x:Bind ViewModel.NavSettingsText, Mode=OneWay}"
                             NavigationTag="Settings"
                             IsCompact="{x:Bind IsCompact, Mode=OneWay}"
                             Clicked="NavButton_Clicked"/>

        </StackPanel>
    </Grid>
</UserControl>
