<UserControl
    x:Class="WinOptimizer.UI.Features.Common.Controls.UpdateToast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <InfoBar x:Name="Notification" IsClosable="True"
             CornerRadius="{StaticResource OverlayCornerRadius}"
             IsOpen="{x:Bind ViewModel.IsUpdateToastOpen, Mode=OneWay}"
             Title="{x:Bind ViewModel.UpdateToastTitle, Mode=OneWay}"
             Message="{x:Bind ViewModel.UpdateToastMessage, Mode=OneWay}"
             Severity="{x:Bind ViewModel.UpdateToastSeverity, Mode=OneWay}"
             Closed="Notification_Closed">
        <InfoBar.ActionButton>
            <Button Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.UpdateToastHasAction, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Content="{x:Bind ViewModel.UpdateToastActionText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.UpdateToastActionCommand, Mode=OneWay}"/>
        </InfoBar.ActionButton>
    </InfoBar>
</UserControl>
