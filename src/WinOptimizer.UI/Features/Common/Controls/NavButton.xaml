<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinOptimizer.UI.Features.Common.Controls.NavButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinOptimizer.UI.Features.Common.Controls"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    AutomationProperties.Name="{x:Bind Text, Mode=OneWay}">

    <Grid x:Name="RootGrid"
          Width="{x:Bind ActualButtonWidth, Mode=OneWay}"
          MinHeight="{x:Bind ActualButtonHeight, Mode=OneWay}"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited"
          PointerPressed="RootGrid_PointerPressed"
          PointerReleased="RootGrid_PointerReleased">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource AccentSelectionBackgroundBrush}"/>
                        <Setter Target="IconPath.Stroke" Value="{ThemeResource AccentSelectionForegroundBrush}"/>
                        <Setter Target="IconPath.StrokeThickness" Value="2.25"/>
                        <Setter Target="ButtonText.Foreground" Value="{ThemeResource AccentSelectionForegroundBrush}"/>
                        <Setter Target="ButtonText.FontWeight" Value="SemiBold"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind IsCompact, Mode=OneWay}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ButtonContent.HorizontalAlignment" Value="Center"/>
                        <Setter Target="ButtonContent.Padding" Value="0"/>
                        <Setter Target="ButtonContent.ColumnSpacing" Value="0"/>
                        <Setter Target="SelectionIndicator.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Main Button Background -->
        <Border x:Name="BackgroundBorder"
                Background="Transparent"
                CornerRadius="13"/>

        <Rectangle x:Name="SelectionIndicator" Width="2" RadiusX="1" RadiusY="1"
                   Margin="0,5" HorizontalAlignment="Left" IsHitTestVisible="False"
                   Fill="{ThemeResource AccentFillColorDefaultBrush}"
                   Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <Grid x:Name="ButtonContent" Padding="13,6,10,6" ColumnSpacing="12"
              Opacity="{x:Bind ContentOpacity, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- A shared coordinate space keeps every navigation icon at the same visual scale. -->
            <Viewbox x:Name="ButtonIcon"
                     Width="{x:Bind IconSize, Mode=OneWay}"
                     Height="{x:Bind IconSize, Mode=OneWay}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="{x:Bind IconMargin, Mode=OneWay}"
                     Visibility="{x:Bind IconVisibility, Mode=OneWay}">
                <Canvas Width="24" Height="24">
                    <Path x:Name="IconPath" Data="{x:Bind IconData, Mode=OneWay, Converter={StaticResource StringToGeometryConverter}}"
                          Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                          StrokeThickness="1.75"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                </Canvas>
            </Viewbox>

            <!-- Long translations can wrap while the automation name retains the full text. -->
            <TextBlock x:Name="ButtonText" Grid.Column="1"
                       Text="{x:Bind Text, Mode=OneWay}"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="2"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind TextVisibility, Mode=OneWay}"/>
        </Grid>

        <!-- InfoBadge Overlay -->
        <InfoBadge x:Name="Badge"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,2,-4,0"
                   Visibility="{x:Bind BadgeVisibility, Mode=OneWay}"
                   Value="{x:Bind BadgeValue, Mode=OneWay}"/>

        <!-- Locked Overlay -->
        <Grid Visibility="{x:Bind LockedVisibility, Mode=OneWay}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Viewbox Width="14" Height="14">
                <PathIcon Data="{StaticResource PrivacyIconPath}"
                          Foreground="#FFA500"/>
            </Viewbox>
        </Grid>
    </Grid>
</UserControl>
