<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="WinOptimizer.UI.Features.Common.Controls.GroupedResultsList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="using:FluentIcons.WinUI"
             xmlns:common="using:WinOptimizer.UI.Features.Common.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="CompactDetailTemplate">
            <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="{Binding DetailMaxLines}" FontSize="12" IsTextSelectionEnabled="True" VerticalAlignment="Center">
                <ToolTipService.ToolTip><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" MaxWidth="720"/></ToolTipService.ToolTip>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="ReportDetailTemplate">
            <StackPanel Spacing="16" Padding="4,12">
                <TextBlock Text="{Binding Report.Title}" FontSize="16" FontWeight="SemiBold" IsTextSelectionEnabled="True"/>
                <ItemsControl ItemsSource="{Binding Report.Sections}" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16" Margin="0,0,0,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Visibility="{Binding HasHeading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <ItemsControl ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="20" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Grid.ColumnSpan="{Binding LabelColumnSpan}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" TextAlignment="Right" FontWeight="SemiBold" IsTextSelectionEnabled="True"
                                                               Visibility="{Binding HasValue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <common:ResultDetailTemplateSelector x:Key="DetailTemplateSelector" CompactTemplate="{StaticResource CompactDetailTemplate}" ReportTemplate="{StaticResource ReportDetailTemplate}"/>
    </UserControl.Resources>
    <ListView ItemsSource="{x:Bind ItemsSource, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch"
              Padding="{StaticResource ScrollContentPadding}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
            <DataTemplate>
                <Border Margin="0,0,0,8" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <!-- Keep selection separate from the expander's toggle surface. -->
                    <CheckBox Visibility="{Binding ShowSelection, Converter={StaticResource BooleanToVisibilityConverter}}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsThreeState="False" IsEnabled="{Binding CanClean}"
                              AutomationProperties.Name="{Binding Header}" MinWidth="0" MinHeight="32" Padding="0"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0"/>
                    <Expander Grid.Column="1" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" MinHeight="52" CornerRadius="8"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Resources>
                            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent"/>
                            <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                            <Thickness x:Key="ExpanderDropdownDownBorderThickness">0,1,0,0</Thickness>
                            <Thickness x:Key="ExpanderDropdownUpBorderThickness">0,0,0,1</Thickness>
                            <Thickness x:Key="ExpanderContentPadding">0,8,12,12</Thickness>
                        </Expander.Resources>
                        <Expander.Header>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <fluent:FluentIcon Icon="{Binding Icon}" IconVariant="Regular" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Header}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Expander.Header>
                        <!-- Bound each list so large file/registry categories retain virtualization. -->
                        <Grid>
                        <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" Margin="8"
                                   Visibility="{Binding HasEmptyMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ListView ItemsSource="{Binding Items}" MaxHeight="360" SelectionMode="None" HorizontalContentAlignment="Stretch" Padding="{StaticResource ScrollContentPadding}" Background="Transparent"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="36"/></Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,2" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox Visibility="{Binding ShowSelection, Converter={StaticResource BooleanToVisibilityConverter}}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanClean}" AutomationProperties.Name="{Binding Detail}" VerticalAlignment="Center" MinWidth="0" MinHeight="32" Padding="0"/>
                                        <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplateSelector="{StaticResource DetailTemplateSelector}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        </Grid>
                    </Expander>
                </Grid>
                </Border>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
