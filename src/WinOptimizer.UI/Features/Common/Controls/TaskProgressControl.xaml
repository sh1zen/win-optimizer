<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinOptimizer.UI.Features.Common.Controls.TaskProgressControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:WinOptimizer.UI.Features.Common.Helpers"
    xmlns:fluent="using:FluentIcons.WinUI"
    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, FallbackValue=Collapsed}">

    <Button x:Name="TaskStatusButton"
            Style="{StaticResource TitleBarButtonStyle}"
            ToolTipService.ToolTip="{x:Bind ViewModel.OutputLabel, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ViewModel.OutputLabel, Mode=OneWay}"
            helpers:PopupHandler.PreferredWidth="360">
        <helpers:PopupHandler.Content>
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Bind ViewModel.AppName, Mode=OneWay}"
                           TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.LastTerminalLine, Mode=OneWay}" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxLines="2"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"/>
                <Grid ColumnSpacing="10" Visibility="{x:Bind ViewModel.IsQueueVisible, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.QueueNextItemName, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.QueueStatusText, Mode=OneWay}"/>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TaskOutputAction" Command="{x:Bind ViewModel.ShowDetailsCommand, Mode=OneWay}"
                            helpers:PopupHandler.DismissOnClick="True">
                        <TextBlock Text="{x:Bind ViewModel.OutputLabel, Mode=OneWay}" TextWrapping="Wrap"/>
                    </Button>
                    <Button x:Name="TaskCancelAction" Grid.Column="1"
                            Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}"
                            Content="{x:Bind ViewModel.CancelButtonLabel, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowCancelAction, Mode=OneWay}"/>
                    <Button x:Name="TaskDismissAction" Grid.Column="1"
                            Command="{x:Bind ViewModel.CloseFailedTaskCommand, Mode=OneWay}"
                            Content="{x:Bind ViewModel.CloseButtonLabel, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowDismissAction, Mode=OneWay}"
                            helpers:PopupHandler.DismissOnClick="True"/>
                </Grid>
            </StackPanel>
        </helpers:PopupHandler.Content>
        <fluent:FluentIcon Icon="DocumentBulletList" IconVariant="Regular" FontSize="20"/>
    </Button>
</UserControl>
