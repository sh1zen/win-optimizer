<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Toolkit cards use these keys in their own resource scope. WinUI aliases share these brushes. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SettingsCardBackgroundPointerOver" Color="#F4F5F7"/>
            <SolidColorBrush x:Key="SettingsCardBackgroundPressed" Color="#EDEEF2"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SettingsCardBackgroundPointerOver" Color="#2C2E34"/>
            <SolidColorBrush x:Key="SettingsCardBackgroundPressed" Color="#282A30"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SettingsCardBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="SettingsCardBackgroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
