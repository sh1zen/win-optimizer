<ResourceDictionary
    x:Class="WinOptimizer.UI.Features.Common.Resources.AppColorResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0067C0"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E60067C0"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC0067C0"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0067C0"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#0067C0"/>
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#0067C0"/>
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#140067C0"/>
            <SolidColorBrush x:Key="NavigationSelectedBackgroundBrush" Color="#1A0067C0"/>
            <SolidColorBrush x:Key="PageIconBackgroundBrush" Color="#0067C0"/>
            <SolidColorBrush x:Key="PageIconForegroundBrush" Color="White"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#60CDFF"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E660CDFF"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC60CDFF"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#60CDFF"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#60CDFF"/>
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#60CDFF"/>
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1460CDFF"/>
            <SolidColorBrush x:Key="NavigationSelectedBackgroundBrush" Color="#1A60CDFF"/>
            <SolidColorBrush x:Key="PageIconBackgroundBrush" Color="#0067C0"/>
            <SolidColorBrush x:Key="PageIconForegroundBrush" Color="White"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="NavigationSelectedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="PageIconBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="PageIconForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
