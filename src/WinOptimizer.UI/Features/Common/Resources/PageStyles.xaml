<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
                    xmlns:fluent="using:FluentIcons.WinUI">
    <!-- The shell owns side margins once; page containers retain vertical spacing and responsive behavior. -->
    <Thickness x:Key="PageHorizontalMargin">16,0,16,0</Thickness>
    <Thickness x:Key="PageContentPadding">0,8,0,24</Thickness>
    <x:Double x:Key="PageCardSpacing">12</x:Double>
    <Thickness x:Key="PageCardPadding">20</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="PageSurfaceCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="PageIconCornerRadius">16</CornerRadius>
    <Style x:Key="PageGridStyle" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource PageContentPadding}"/>
        <Setter Property="RowSpacing" Value="{StaticResource PageCardSpacing}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="PageStackStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="{StaticResource PageContentPadding}"/>
        <Setter Property="Spacing" Value="{StaticResource PageCardSpacing}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <!-- Reserve room for overlay scrollbars plus a small gap from content. -->
    <Thickness x:Key="ScrollContentPadding">0,0,16,0</Thickness>
    <Thickness x:Key="ScrollContentBottomPadding">0,0,16,12</Thickness>
    <Thickness x:Key="BidirectionalScrollContentPadding">0,0,16,16</Thickness>
    <Style x:Key="PageScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Padding" Value="{StaticResource ScrollContentPadding}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style x:Key="PageSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppSurfaceStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource PageSurfaceCornerRadius}"/>
    </Style>
    <Style x:Key="PageCardStyle" TargetType="Border" BasedOn="{StaticResource PageSurfaceStyle}">
        <Setter Property="Padding" Value="{StaticResource PageCardPadding}"/>
    </Style>
    <Style x:Key="ScanHeroStyle" TargetType="Border" BasedOn="{StaticResource PageCardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="20"/>
    </Style>
    <Style x:Key="ScanActionStyle" TargetType="ContentControl">
        <Setter Property="Width" Value="172"/>
        <Setter Property="Height" Value="172"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Ellipse Fill="{ThemeResource AccentFillColorTertiaryBrush}" Opacity="0.35" IsHitTestVisible="False"/>
                        <Ellipse Margin="7" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" Opacity="0.35" IsHitTestVisible="False"/>
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScanActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Width" Value="136"/>
        <Setter Property="Height" Value="136"/>
        <Setter Property="CornerRadius" Value="68"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <fluent:FluentIcon Icon="Search" IconVariant="Regular" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SegmentedSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PageSurfaceStyle}">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="3"/>
    </Style>
    <Style x:Key="PageSettingsCardStyle" TargetType="toolkit:SettingsCard">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppSurfaceStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource PageSurfaceCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource PageCardPadding}"/>
    </Style>
</ResourceDictionary>
