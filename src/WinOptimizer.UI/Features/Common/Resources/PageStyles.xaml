<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <!-- The shell owns side margins once; page containers retain vertical spacing and responsive behavior. -->
    <Thickness x:Key="PageHorizontalMargin">16,0,16,0</Thickness>
    <Thickness x:Key="PageContentPadding">0,8,0,24</Thickness>
    <x:Double x:Key="PageSectionSpacing">24</x:Double>
    <x:Double x:Key="PageCardSpacing">10</x:Double>
    <Thickness x:Key="PageCardPadding">20</Thickness>
    <Style x:Key="PageGridStyle" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource PageContentPadding}"/>
        <Setter Property="RowSpacing" Value="{StaticResource PageSectionSpacing}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="PageStackStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="{StaticResource PageContentPadding}"/>
        <Setter Property="Spacing" Value="{StaticResource PageSectionSpacing}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <!-- Reserve room for overlay scrollbars plus a small gap from content. -->
    <Thickness x:Key="ScrollContentPadding">0,0,16,0</Thickness>
    <Thickness x:Key="ScrollContentBottomPadding">0,0,16,12</Thickness>
    <Thickness x:Key="BidirectionalScrollContentPadding">0,0,16,16</Thickness>
    <Style x:Key="PageScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Padding" Value="{StaticResource ScrollContentPadding}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style x:Key="PageCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="{StaticResource PageCardPadding}"/>
    </Style>
    <Style x:Key="PageSettingsCardStyle" TargetType="toolkit:SettingsCard">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="{StaticResource PageCardPadding}"/>
    </Style>
</ResourceDictionary>
