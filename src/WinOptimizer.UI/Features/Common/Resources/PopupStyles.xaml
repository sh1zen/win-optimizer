<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared popup frames; feature templates supply only their own contents. -->
    <Thickness x:Key="Popup.ContentPadding">16</Thickness>
    <Thickness x:Key="Popup.ViewportMargin">24,40</Thickness>
    <x:Double x:Key="Popup.MaxWidth">760</x:Double>
    <Style x:Key="Popup.FlyoutPresenter" TargetType="FlyoutPresenter">
        <Setter Property="Padding" Value="{StaticResource Popup.ContentPadding}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MaxWidth" Value="{StaticResource Popup.MaxWidth}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="Popup.MenuPresenter" TargetType="MenuFlyoutPresenter">
        <Setter Property="Padding" Value="4"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="MaxWidth" Value="{StaticResource Popup.MaxWidth}"/>
    </Style>
    <Style x:Key="Popup.Dialog" TargetType="ContentDialog">
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style x:Key="Popup.ToolTip" TargetType="ToolTip">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource Popup.ToolTip}"/>
</ResourceDictionary>
