<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:WinOptimizer.UI.Features.Common.Resources">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Features/Common/Resources/PopupStyles.xaml" />
        <ResourceDictionary Source="ms-appx:///Features/Common/Resources/PageStyles.xaml" />
        <!-- Value converters -->
        <ResourceDictionary Source="ms-appx:///Features/Common/Resources/Converters.xaml" />
        <!-- Shared setting templates and styles (code-behind enabled for x:Bind) -->
        <resources:SettingTemplates />
        <!-- Centralized feature icons -->
        <ResourceDictionary Source="ms-appx:///Features/Common/Resources/FeatureIcons.xaml" />
        <!-- InfoBadge pill styles, foreground brushes, and icon template selector -->
        <ResourceDictionary Source="ms-appx:///Features/Common/Resources/BadgeStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Title Bar Button Style -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
</ResourceDictionary>
