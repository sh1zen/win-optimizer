<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinOptimizer.UI.Features.Common.Converters">

    <!--
    Converters.xaml
    Registers shared value converters.
    Use these converters with {StaticResource ConverterName} in XAML.
    -->

    <!-- Boolean Converters -->
    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

    <!-- Null Converter -->
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

    <!-- Icon Converters -->
    <converters:IconConverter x:Key="IconConverter"/>
    <converters:StringToGeometryConverter x:Key="StringToGeometryConverter"/>

</ResourceDictionary>
