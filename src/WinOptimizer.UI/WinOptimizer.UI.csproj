<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Version.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinOptimizer.UI</RootNamespace>
    <AssemblyName>win-optimizer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- x64 only - ARM64 Windows can run x64 apps via emulation -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged deployment (no MSIX) -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Self-contained: bundles .NET runtime and App SDK runtime with the app (no separate runtime install needed) -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Clear /CETCOMPAT on the apphost. .NET 9+ defaults to it, opting into Intel CET /
         AMD shadow-stack enforcement. CoreCLR has an unpatched bug (dotnet/runtime#110920)
         where the user-mode-APC path trips a shadow-stack assertion and
         FailFast(0xc0000602)s the process before Main() runs. Affects users on CET-capable
         CPUs (Intel Tiger Lake+, AMD Zen 3+) running Windows without the ntdll CET fix from
         KB5044273 (Oct 2024) - i.e. unpatched LTSC and similar. Same symptom hit #356
         (WPF .NET 9) and #648 (WinUI3 .NET 10), same fault offset 0x10be3e inside
         KERNELBASE!RaiseFailFastException across both. Microsoft's documented workaround:
         https://learn.microsoft.com/en-us/dotnet/core/compatibility/interop/9.0/cet-support
         Trade-off: win-optimizer.exe specifically loses CET ROP-mitigation. -->
    <CETCompat>false</CETCompat>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required for CommunityToolkit.Mvvm 8.4.0 partial property source generators on .NET 10 -->
    <LangVersion>preview</LangVersion>
    <!-- MRT/PRI generation - requires Visual Studio MSBuild -->
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackage>false</AppxPackage>
    <!-- Application icon -->
    <ApplicationIcon>Assets\AppIcons\win-optimizer.ico</ApplicationIcon>
    <!-- Use custom Program.cs entry point for single-instance enforcement -->
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>WinOptimizer.UI.Program</StartupObject>
    <Authors>sh1zen</Authors>
    <Company>sh1zen</Company>
    <Copyright>Copyright © Andrea Frolli</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinOptimizer.UI.Tests" />
    <InternalsVisibleTo Include="WinOptimizer.Startup.Tests" />
    <InternalsVisibleTo Include="WinOptimizer.SoftwareApps.Tests" />
    <InternalsVisibleTo Include="WinOptimizer.Popup.Tests" />
    <InternalsVisibleTo Include="WinOptimizer.SystemMonitor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows App SDK 1.8.x. 1.7 went out of support 2026-03-18.
         Keep the Microsoft.WindowsAppSDK *metapackage* - do NOT switch to the
         .WinUI component package. CommunityToolkit.WinUI /
         FluentIcons all transitively depend on the metapackage,
         so referencing the component package as well pulls in BOTH families and
         the duplicate WinAppSDK build props break the build (MSB4011 + the MSIX
         CustomBeforeMicrosoftCommonTargets error). The metapackage bundles ~38 MB
         of Windows ML DLLs (onnxruntime.dll + DirectML.dll) that win-optimizer never
         uses; those are stripped from the installer instead - see
         extras/win-optimizer.Installer.iss. Ref: microsoft/WindowsAppSDK#5969. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260416003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" GeneratePathProperty="true" />
    <!-- CsWinRT - WinRT projections for .NET (needed for CommunityToolkit.WinUI 8.2+) -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Icons - Microsoft Fluent System Icons (4000+ icons) -->
    <PackageReference Include="FluentIcons.WinUI" Version="2.1.326" />

    <!-- WinUI Controls - 8.2.251219 is the latest stable 8.2.x; runs on WinAppSDK 1.8 (floor 1.6+). -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <!-- Primitives ships WrapPanel (used as ItemsPanel on the SettingDescription badge row
         so AC/DC pill rows wrap on narrow windows). Same 8.2.x train as the other WinUI
         Toolkit refs below — version-locked to keep them upgrading together. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Collections" Version="8.2.251219" />

    <!-- DataGrid 7.1.2 is the last release. The WCT 8.x reorg never ported a DataGrid
         (Microsoft abandoned the original contribution; WCT migration guide green-lights
         using 7.x DataGrid alongside 8.x packages because it has no toolkit dependency).
         Future successor when this hurts: WinUI.TableView (separate migration; different API). -->
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />

    <!-- Win32 Interop - Type-safe P/Invoke for single-instance activation and file dialogs -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.183">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- DI - aligned with .NET 10 runtime -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <!-- LibreHardwareMonitor 0.9.6 calls Mono only on Unix. Keep its managed reference and exclude the native helpers from Windows deployment. -->
    <PackageReference Include="Mono.Posix.NETStandard" Version="1.0.0" ExcludeAssets="native" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinOptimizer.Core\WinOptimizer.Core.csproj" />
    <ProjectReference Include="..\WinOptimizer.Application\WinOptimizer.Application.csproj" />
    <ProjectReference Include="..\WinOptimizer.Infrastructure\WinOptimizer.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the project license and component notices with the distributed application. -->
    <None Include="..\..\LICENSE;..\..\THIRD-PARTY-NOTICES.txt"
          Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Content files (localization) - uses local UI project files -->
  <ItemGroup>
    <Content Include="Features\Common\Localization\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Localization\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Embedded resources - uses local UI project files -->
  <ItemGroup>
    <EmbeddedResource Include="Features\Common\Resources\AdvancedTools\autounattend-template.xml">
      <LogicalName>WinOptimizer.UI.Resources.AdvancedTools.autounattend-template.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- CsWin32 NativeMethods.txt for P/Invoke generation -->
  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
  </ItemGroup>


  <!-- The unpackaged MRT build generates the app PRI but does not add it to publish items. -->
  <Target Name="PublishApplicationResources" BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(CopyBuildOutputToPublishDirectory)' == 'true'">
    <Error Condition="!Exists('$(ProjectPriFullPath)')"
           Text="The application resource index is missing: $(ProjectPriFullPath). Build the application before publishing." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- Derive the companion from the final SDK manifest so it keeps all registration-free WinRT classes. -->
  <ItemGroup>
    <DesktopExtensionHost Include="win-optimizer-preview.exe" ExecutionLevel="asInvoker" />
    <DesktopExtensionHost Include="win-optimizer-widgets.exe" ExecutionLevel="requireAdministrator" />
  </ItemGroup>
  <Target Name="BuildDesktopExtensionHosts" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(UseAppHost)' == 'true' and '$(DesignTimeBuild)' != 'true'"
          Inputs="$(TargetDir)$(AssemblyName).exe;$(MSBuildProjectFullPath)"
          Outputs="$(TargetDir)%(DesktopExtensionHost.Identity)">
    <PropertyGroup>
      <PreviewAppHost>$(TargetDir)%(DesktopExtensionHost.Identity)</PreviewAppHost>
      <PreviewManifestTool>$(PkgMicrosoft_Windows_SDK_BuildTools)\bin\10.0.26100.0\x64\mt.exe</PreviewManifestTool>
      <PreviewEmbeddedManifest>$(IntermediateOutputPath)%(DesktopExtensionHost.Filename).manifest</PreviewEmbeddedManifest>
      <PreviewManifestNamespaces>&lt;Namespace Prefix="a" Uri="urn:schemas-microsoft-com:asm.v1"/&gt;&lt;Namespace Prefix="v2" Uri="urn:schemas-microsoft-com:asm.v2"/&gt;&lt;Namespace Prefix="v3" Uri="urn:schemas-microsoft-com:asm.v3"/&gt;</PreviewManifestNamespaces>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).exe" DestinationFiles="$(PreviewAppHost).tmp" />
    <Exec Command="&quot;$(PreviewManifestTool)&quot; -nologo -inputresource:&quot;$(PreviewAppHost).tmp&quot;;#1 -out:&quot;$(PreviewEmbeddedManifest)&quot;" />
    <XmlPoke XmlInputPath="$(PreviewEmbeddedManifest)" Namespaces="$(PreviewManifestNamespaces)"
             Query="/a:assembly/v2:trustInfo/v2:security/v3:requestedPrivileges/v3:requestedExecutionLevel/@level" Value="%(DesktopExtensionHost.ExecutionLevel)" />
    <Exec Command="&quot;$(PreviewManifestTool)&quot; -nologo -manifest &quot;$(PreviewEmbeddedManifest)&quot; -outputresource:&quot;$(PreviewAppHost).tmp&quot;;#1" />
    <Move SourceFiles="$(PreviewAppHost).tmp" DestinationFiles="$(PreviewAppHost)" OverwriteReadOnlyFiles="true" />
    <ItemGroup><FileWrites Include="$(PreviewAppHost);$(PreviewEmbeddedManifest)" /></ItemGroup>
  </Target>
  <!-- Unpackaged WinUI locates its resource index by executable name. -->
  <Target Name="BuildDesktopExtensionResources" AfterTargets="AfterGenerateProjectPriFile"
          Condition="'$(UseAppHost)' == 'true' and '$(DesignTimeBuild)' != 'true'"
          Inputs="$(ProjectPriFullPath)" Outputs="$(TargetDir)%(DesktopExtensionHost.Filename).pri">
    <Copy SourceFiles="$(ProjectPriFullPath)" DestinationFiles="$(TargetDir)%(DesktopExtensionHost.Filename).pri" />
    <ItemGroup><FileWrites Include="$(TargetDir)%(DesktopExtensionHost.Filename).pri" /></ItemGroup>
  </Target>
  <Target Name="PublishDesktopExtensionHosts" BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(CopyBuildOutputToPublishDirectory)' == 'true' and '$(UseAppHost)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(DesktopExtensionHost->'$(TargetDir)%(Identity)')" RelativePath="%(DesktopExtensionHost.Identity)"
                            CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(TargetDir)%(DesktopExtensionHost.Filename).pri" RelativePath="%(DesktopExtensionHost.Filename).pri"
                            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
